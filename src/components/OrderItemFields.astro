---
import { ITEM_TYPE_LABELS } from '../lib/labels';
import { EYE_FIELDS, FABRICATION_SOURCE_LABELS, ITEM_RX_PREFIX } from '../lib/fabrication';

interface Props {
  /** Prefijo de los nombres (p. ej. "items[0]"); vacío = nombres simples. */
  prefix?: string;
  values?: Record<string, string | number | null | undefined>;
  /** Mostrar la ficha de fabricación (RX) para ítems con lente (nueva orden, Comercial). */
  rx?: boolean;
}

const { prefix = '', values = {}, rx = false } = Astro.props;
const name = (field: string) => (prefix ? `${prefix}[${field}]` : field);
const val = (field: string) => (values[field] == null ? '' : String(values[field]));
const rxName = (field: string) => name(`${ITEM_RX_PREFIX}${field}`);
const rxVal = (field: string) => val(`${ITEM_RX_PREFIX}${field}`);
---

<div class="grid grid-cols-2 gap-2 sm:grid-cols-12 sm:items-end" data-item-row>
  <div class="col-span-2 sm:col-span-2">
    <label class="label">Tipo</label>
    <select class="input" name={name('item_type')} data-item-type>
      {Object.entries(ITEM_TYPE_LABELS).map(([value, label]) => <option value={value} selected={val('item_type') === value}>{label}</option>)}
    </select>
  </div>
  <div class="col-span-2 sm:col-span-3">
    <label class="label">Montura</label>
    <input class="input" name={name('frame_description')} value={val('frame_description')} placeholder="Marca, referencia, color" />
  </div>
  <div class="sm:col-span-2">
    <label class="label">Tipo de lente</label>
    <input class="input" name={name('lens_type')} value={val('lens_type')} placeholder="Monofocal, progresivo…" />
  </div>
  <div class="sm:col-span-2">
    <label class="label">Filtro</label>
    <input class="input" name={name('lens_filter')} value={val('lens_filter')} placeholder="Antirreflejo, blue…" />
  </div>
  <div class="col-span-2 sm:col-span-3">
    <label class="label">Descripción (otros productos)</label>
    <input class="input" name={name('description')} value={val('description')} />
  </div>
  <div class="sm:col-span-2">
    <label class="label">Cantidad</label>
    <input class="input" name={name('quantity')} type="number" min="1" step="1" required value={val('quantity') || '1'} data-qty />
  </div>
  <div class="sm:col-span-3">
    <label class="label">Valor unitario (COP)</label>
    <input class="input" name={name('unit_price')} type="number" min="0" step="1" required value={val('unit_price')} data-price />
  </div>
  <div class="sm:col-span-2">
    <label class="label">Descuento (COP)</label>
    <input class="input" name={name('discount_amount')} type="number" min="0" step="1" value={val('discount_amount') === '0' ? '' : val('discount_amount')} placeholder="0" data-discount />
  </div>
  <div class="col-span-2 sm:col-span-5">
    <label class="label">Motivo del descuento</label>
    <input class="input" name={name('discount_reason')} maxlength="500" value={val('discount_reason')} placeholder="Obligatorio si hay descuento" />
  </div>
  {
    rx && (
      <fieldset class="col-span-2 space-y-2 rounded-md border border-slate-200 p-3 sm:col-span-12" data-rx>
        <legend class="px-1 text-xs font-medium text-slate-600">Ficha de fabricación (RX) · dato sensible</legend>
        <p class="text-xs text-amber-700" data-rx-locked>Marque la autorización de datos sensibles del comprador para capturar el RX.</p>
        <div class="overflow-x-auto">
          <table class="table text-xs">
            <thead>
              <tr><th></th>{EYE_FIELDS.map((f) => <th>{f.label}{f.required && ' *'}</th>)}</tr>
            </thead>
            <tbody>
              {(['od', 'os'] as const).map((eye) => (
                <tr>
                  <th>{eye === 'od' ? 'OD' : 'OI'}</th>
                  {EYE_FIELDS.map((f) => (
                    <td>
                      <input
                        class="input w-20"
                        name={rxName(`${eye}_${f.key}`)}
                        type="number"
                        step={f.step}
                        min={f.min}
                        max={f.max}
                        value={rxVal(`${eye}_${f.key}`)}
                        data-rx-value
                        data-rx-required={f.required ? '' : undefined}
                      />
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="grid gap-2 sm:grid-cols-4">
          <div>
            <label class="label">DP total (mm)</label>
            <input class="input" name={rxName('pd_total_mm')} type="number" step="0.5" min="40" max="80" value={rxVal('pd_total_mm')} data-rx-value />
          </div>
          <div>
            <label class="label">Fecha de la fórmula</label>
            <input class="input" name={rxName('prescription_date')} type="date" value={rxVal('prescription_date')} data-rx-value />
          </div>
          <div>
            <label class="label">Fuente</label>
            <select class="input" name={rxName('source')}>
              {Object.entries(FABRICATION_SOURCE_LABELS).map(([value, label]) => <option value={value} selected={rxVal('source') === value}>{label}</option>)}
            </select>
          </div>
          <div>
            <label class="label">Notas técnicas</label>
            <input class="input" name={rxName('technical_notes')} maxlength="200" placeholder="Sin diagnósticos" value={rxVal('technical_notes')} data-rx-value />
          </div>
        </div>
        <p class="text-xs text-slate-500">
          Déjelo vacío si la fórmula no está a mano: la venta se guarda y el RX se registra después en la orden. Eje solo si hay cilindro; ADD
          obligatoria en progresivos y bifocales; pasos de 0.25.
        </p>
      </fieldset>
    )
  }
  <slot />
</div>
