---
// Disposición "Circuito SOE": barra lateral agrupada por fase con
// contadores de pendientes, colapsable, y buscador global (Ctrl/⌘ + K).
// La disposición anterior está en la etiqueta git v1-antes-rediseno.
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { takeFlash } from '../lib/flash';
import { canUseViewAs, hasRole } from '../lib/auth';
import { ROLE_LABELS } from '../lib/labels';
import { rolesLabel } from '../lib/profiles';
import { loadSummary, MONEY_ROLES } from '../lib/circuit';
import { VIEW_AS_ROLES } from '../lib/viewAs';
import { canSeeModule, type ModuleKey } from '../lib/modules';
import type { IconName } from '../lib/icons';

interface Props {
  title: string;
  error?: string | null;
  bare?: boolean;
}

const { title, error, bare = false } = Astro.props;
const flash = takeFlash(Astro.cookies);
const profile = Astro.locals.profile;
const path = Astro.url.pathname;
const showChrome = !bare && !!profile?.active;
const collapsed = Astro.cookies.get('nav_collapsed')?.value === '1';

const s = showChrome ? (Astro.locals.summary ?? (await loadSummary(Astro.locals.supabase))) : null;
const canSeeMoney = hasRole(Astro.locals, ...MONEY_ROLES);
const isDireccion = hasRole(Astro.locals, 'direccion');
const canEditCatalogs = hasRole(Astro.locals, 'direccion', 'administracion_cartera', 'costos');

type NavItem = { href: string; label: string; icon: IconName; count?: number; hot?: boolean; module?: ModuleKey };
const groups: { phase: string; items: NavItem[] }[] = s
  ? [
      {
        phase: 'Inicio',
        items: [
          { href: '/', label: 'Circuito', icon: 'home' },
          { href: '/tablero', label: 'Tablero', icon: 'grid' },
        ],
      },
      {
        phase: 'Vender',
        items: [
          { href: '/empresas', label: 'Empresas', icon: 'building', module: 'empresas' },
          { href: '/oportunidades', label: 'Oportunidades', icon: 'target', module: 'oportunidades', count: s.vender.quietas, hot: s.vender.quietas > 0 },
          { href: '/convenios', label: 'Convenios', icon: 'pen', module: 'convenios', count: s.convenios_por_aprobar + (isDireccion ? (s.convenios_por_revisar ?? 0) : 0) },
        ],
      },
      {
        phase: 'Operar',
        items: [
          { href: '/jornadas', label: 'Jornadas', icon: 'calendar', module: 'jornadas', count: s.jornada.en_ejecucion },
          { href: '/ordenes', label: 'Órdenes', icon: 'file', module: 'ordenes', count: s.orden.por_verificar },
          { href: '/produccion', label: 'Producción', icon: 'flask', module: 'produccion', count: s.producir.en_lab, hot: s.producir.atrasadas > 0 },
          { href: '/garantias', label: 'Posventa', icon: 'shield', module: 'posventa', count: s.posventa },
        ],
      },
      {
        phase: 'Cobrar',
        items: [
          { href: '/facturas', label: 'Facturación', icon: 'invoice', module: 'facturas', count: canSeeMoney ? s.facturar.sin_factura : 0, hot: s.facturar.diferencias > 0 },
          ...(canSeeMoney ? [{ href: '/recaudo', label: 'Recaudo', icon: 'coin' as IconName, module: 'recaudo' as ModuleKey, count: s.cobrar.vencidas, hot: s.cobrar.vencidas > 0 }] : []),
        ],
      },
      {
        phase: 'Control',
        items: [
          { href: '/compradores', label: 'Compradores', icon: 'users' },
          ...(canEditCatalogs ? [{ href: '/admin/catalogos', label: 'Catálogos', icon: 'grid' as IconName }] : []),
          ...(isDireccion
            ? [
                { href: '/admin/usuarios', label: 'Usuarios', icon: 'key' as IconName },
                { href: '/admin/parametros', label: 'Parámetros', icon: 'sliders' as IconName },
                { href: '/admin/importar-excel', label: 'Importar Excel', icon: 'upload' as IconName },
              ]
            : []),
        ],
      },
    ]
  : [];
// Cada rol ve en el menú solo los módulos de su trabajo (src/lib/modules.ts)
const visibleGroups = groups
  .map((g) => ({ ...g, items: g.items.filter((it) => !it.module || canSeeModule(Astro.locals, it.module)) }))
  .filter((g) => g.items.length > 0);
// "Ver como" (solo Dirección): previsualizar la interfaz de otro rol
const viewAs = Astro.locals.viewAs ?? null;
const canViewAs = canUseViewAs(Astro.locals.realRole ?? profile?.role);
const backPath = path + Astro.url.search;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const initial = (profile?.full_name ?? '?').trim().charAt(0).toUpperCase();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A1D4D" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" />
    <title>{title} · CRM SOE</title>
  </head>
  <body>
    {
      showChrome ? (
        <div class="min-h-screen lg:flex">
          <div id="nav-backdrop" class="fixed inset-0 z-30 hidden bg-slate-900/50 lg:hidden" aria-hidden="true" />
          <aside
            id="sidebar"
            data-collapsed={collapsed ? 'true' : 'false'}
            class="group fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col bg-ink px-3 py-4 transition-[width,transform] duration-200 data-[open=true]:translate-x-0 lg:sticky lg:top-0 lg:h-screen lg:translate-x-0 lg:data-[collapsed=true]:w-[76px]"
            aria-label="Módulos"
          >
            <div class="mb-4 flex items-center justify-between gap-2 px-1 lg:group-data-[collapsed=true]:flex-col lg:group-data-[collapsed=true]:gap-3">
              <a href="/" class="flex items-center gap-3 hover:no-underline">
                <img src="/brand/soe-wordmark-blanco.png" alt="SOE" width="88" height="20" class="h-5 w-auto shrink-0 lg:group-data-[collapsed=true]:h-2.5" />
                <span class="border-l border-white/20 pl-3 text-xs leading-tight text-slate-300 lg:group-data-[collapsed=true]:hidden">CRM<br />Piloto</span>
              </a>
              <button
                type="button"
                id="nav-collapse"
                class="hidden h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/10 text-slate-300 hover:bg-white/15 lg:flex"
                aria-label={collapsed ? 'Expandir la barra lateral' : 'Contraer la barra lateral'}
                aria-expanded={collapsed ? 'false' : 'true'}
              >
                <Icon name="chevronLeft" size={16} strokeWidth={2} class="transition-transform lg:group-data-[collapsed=true]:rotate-180" />
              </button>
            </div>

            <nav class="flex-1 overflow-y-auto">
              {visibleGroups.map((g) => (
                <div class="pb-4">
                  <div class="px-2.5 pb-1.5 text-[11px] font-semibold tracking-[0.08em] text-slate-400 uppercase lg:group-data-[collapsed=true]:sr-only">{g.phase}</div>
                  <ul class="space-y-0.5">
                    {g.items.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          title={item.label}
                          aria-current={isActive(item.href) ? 'page' : undefined}
                          class:list={[
                            'relative flex min-h-10 items-center gap-3 rounded-[10px] px-2.5 text-sm font-medium hover:bg-white/10 hover:no-underline lg:group-data-[collapsed=true]:justify-center',
                            isActive(item.href) ? 'bg-white/10 text-white shadow-[inset_3px_0_0_var(--color-accent)]' : 'text-slate-300',
                          ]}
                        >
                          <Icon name={item.icon} class="shrink-0" />
                          <span class="flex-1 lg:group-data-[collapsed=true]:sr-only">{item.label}</span>
                          {!!item.count && (
                            <span
                              class:list={[
                                'flex h-5 min-w-[22px] items-center justify-center rounded-full px-1.5 text-xs font-semibold lg:group-data-[collapsed=true]:absolute lg:group-data-[collapsed=true]:top-1 lg:group-data-[collapsed=true]:right-1.5 lg:group-data-[collapsed=true]:h-2 lg:group-data-[collapsed=true]:min-w-2 lg:group-data-[collapsed=true]:p-0 lg:group-data-[collapsed=true]:text-[0px]',
                                item.hot ? 'bg-amber-400 text-stone-900' : 'bg-white/15 text-slate-100',
                              ]}
                            >
                              {item.count}
                            </span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </nav>

            <div class="mt-2 flex items-center gap-3 border-t border-white/10 px-1.5 pt-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent text-[13px] font-semibold text-ink">{initial}</span>
              <span class="flex min-w-0 flex-1 flex-col leading-tight lg:group-data-[collapsed=true]:hidden">
                <span class="truncate text-[13px] font-medium text-slate-50">{profile!.full_name}</span>
                <span class="truncate text-xs text-slate-400">
                  {viewAs ? `${ROLE_LABELS[Astro.locals.realRole ?? 'direccion']} · como ${ROLE_LABELS[viewAs]}` : rolesLabel(profile!.role, profile!.extra_roles)}
                </span>
              </span>
              <form method="post" action="/logout" class="lg:group-data-[collapsed=true]:hidden">
                <button type="submit" class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-300 hover:bg-white/10" aria-label="Salir" title="Salir">
                  <Icon name="logout" size={17} />
                </button>
              </form>
            </div>
          </aside>

          <div class="min-w-0 flex-1">
            <header class="sticky top-0 z-20 flex flex-wrap items-center gap-3 border-b border-slate-200 bg-white/95 px-4 py-3 backdrop-blur lg:px-8">
              <button type="button" id="nav-open" class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-300 text-slate-700 lg:hidden" aria-label="Abrir el menú">
                <Icon name="menu" size={20} />
              </button>
              <button
                type="button"
                data-open-palette
                class="flex h-11 max-w-xl min-w-0 flex-1 items-center gap-2.5 rounded-xl border border-slate-300 bg-slate-50 px-3.5 text-left text-sm text-slate-600 hover:border-slate-400"
              >
                <Icon name="search" size={18} strokeWidth={2} class="shrink-0" />
                <span class="flex-1 truncate">Buscar comprador, orden, empresa o acción…</span>
                <kbd class="hidden rounded-md border border-slate-300 bg-white px-1.5 py-0.5 font-sans text-xs font-semibold text-slate-600 sm:inline">Ctrl K</kbd>
              </button>
              {canViewAs && (
                <form method="post" action="/ver-como" class="ml-auto flex items-center gap-2" data-view-as>
                  <input type="hidden" name="back" value={backPath} />
                  <label for="view-as" class="hidden text-sm font-medium text-slate-600 sm:inline">
                    Ver como
                  </label>
                  <select
                    id="view-as"
                    name="role"
                    aria-label="Ver el CRM como otro rol"
                    class:list={[
                      'h-11 rounded-xl border px-3 text-sm font-medium',
                      viewAs ? 'border-amber-400 bg-amber-50 text-amber-900' : 'border-slate-300 bg-white text-slate-700',
                    ]}
                  >
                    <option value="" selected={!viewAs}>Dirección (yo)</option>
                    {VIEW_AS_ROLES.map((r) => (
                      <option value={r} selected={viewAs === r}>
                        {ROLE_LABELS[r]}
                      </option>
                    ))}
                  </select>
                  <noscript>
                    <button type="submit" class="btn">Ver</button>
                  </noscript>
                </form>
              )}
            </header>
            {viewAs && (
              <div role="status" class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-amber-300 bg-amber-50 px-4 py-2 text-sm text-amber-900 lg:px-8">
                <Icon name="eye" size={16} class="shrink-0" />
                <span class="flex-1">
                  Estás viendo el CRM como <strong>{ROLE_LABELS[viewAs]}</strong>. Es una vista previa: los datos son los de Dirección y no se guardan cambios.
                </span>
                <form method="post" action="/ver-como">
                  <input type="hidden" name="back" value={backPath} />
                  <button type="submit" class="font-semibold underline underline-offset-2 hover:no-underline">
                    Volver a Dirección
                  </button>
                </form>
              </div>
            )}

            <main class="mx-auto w-full max-w-[120rem] px-4 py-6 lg:px-8 2xl:px-10">
              {flash && (
                <div
                  role="status"
                  class:list={[
                    'mb-4 rounded-xl border px-4 py-3 text-sm',
                    flash.type === 'ok' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-200 bg-red-50 text-red-800',
                  ]}
                >
                  {flash.message}
                </div>
              )}
              {error && (
                <div role="alert" class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                  {error}
                </div>
              )}
              <slot />
            </main>
          </div>
          <CommandPalette />
        </div>
      ) : (
        <main class="mx-auto max-w-md px-4 py-6">
          {flash && (
            <div role="status" class:list={['mb-4 rounded-xl border px-4 py-3 text-sm', flash.type === 'ok' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-200 bg-red-50 text-red-800']}>
              {flash.message}
            </div>
          )}
          {error && <div role="alert" class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</div>}
          <slot />
        </main>
      )
    }
  </body>
</html>

<script>
  const sidebar = document.getElementById('sidebar');
  const backdrop = document.getElementById('nav-backdrop');
  const collapseBtn = document.getElementById('nav-collapse');

  // Contraer / expandir en escritorio (se recuerda en una cookie)
  collapseBtn?.addEventListener('click', () => {
    if (!sidebar) return;
    const next = sidebar.dataset.collapsed !== 'true';
    sidebar.dataset.collapsed = String(next);
    collapseBtn.setAttribute('aria-expanded', String(!next));
    collapseBtn.setAttribute('aria-label', next ? 'Expandir la barra lateral' : 'Contraer la barra lateral');
    document.cookie = `nav_collapsed=${next ? '1' : '0'}; path=/; max-age=31536000; samesite=lax`;
  });

  // "Ver como": cambiar de vista al elegir un rol
  document.querySelector<HTMLFormElement>('form[data-view-as]')?.addEventListener('change', (e) => {
    (e.currentTarget as HTMLFormElement).requestSubmit();
  });

  // Menú en el celular
  const setOpen = (open: boolean) => {
    if (!sidebar || !backdrop) return;
    sidebar.dataset.open = String(open);
    backdrop.classList.toggle('hidden', !open);
  };
  document.getElementById('nav-open')?.addEventListener('click', () => setOpen(true));
  backdrop?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sidebar?.dataset.open === 'true') setOpen(false);
  });
</script>
