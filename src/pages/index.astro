---
import AppLayout from '../layouts/AppLayout.astro';
import { hasRole } from '../lib/auth';
import { cop, fmtDate, fmtTime, fmtWeekday, todayCo } from '../lib/format';
import { AGREEMENT_STATUS_LABELS, STAGE_LABELS } from '../lib/labels';
import { orderNumber } from '../lib/orders';

const { supabase, userId } = Astro.locals;
const today = todayCo();
const canSeeApprovals = hasRole(Astro.locals, 'administracion_cartera', 'direccion');
const canSeeOrders = hasRole(Astro.locals, 'administracion_cartera', 'comercial');

const [myActions, sessions, pendingAgreements, stale, pendingOrders] = await Promise.all([
  supabase
    .from('v_deals_board')
    .select('id, deal_name_branch, company_name, stage, next_action, next_action_due_date, next_action_overdue')
    .eq('next_action_owner_id', userId!)
    .in('stage', ['prospecto', 'reunion_exploratoria', 'propuesta_enviada', 'negociacion', 'cierre_perdido'])
    .not('next_action', 'is', null)
    .order('next_action_due_date')
    .limit(15),
  supabase
    .from('v_campaign_calendar')
    .select('session_id, campaign_id, company_name, city_name, session_date, start_time, end_time, responsible_user_name, has_conflict')
    .gte('session_date', today)
    .order('session_date')
    .order('start_time')
    .limit(10),
  canSeeApprovals
    ? supabase
        .from('v_agreements')
        .select('id, company_name, deal_name_branch, status, documents_verified')
        .eq('status', 'pendiente_aprobacion')
        .order('updated_at')
    : Promise.resolve({ data: [] as { id: string; company_name: string; deal_name_branch: string | null; status: string; documents_verified: boolean }[] }),
  supabase
    .from('v_deals_board')
    .select('id, deal_name_branch, company_name, days_inactive, estimated_billing_amount')
    .eq('inactivity_alert', true)
    .order('days_inactive', { ascending: false })
    .limit(10),
  canSeeOrders
    ? supabase
        .from('v_orders')
        .select('id, order_number, buyer_name, company_name, total_amount, missing_requirements')
        .eq('doc_status', 'pendiente_soportes')
        .eq('is_cancelled', false)
        .order('created_at')
        .limit(15)
    : Promise.resolve({ data: [] as { id: string; order_number: number; buyer_name: string; company_name: string | null; total_amount: number; missing_requirements: string[] | null }[] }),
]);
---

<AppLayout title="Inicio">
  <h1 class="mb-4">Hola, {Astro.locals.profile?.full_name}</h1>

  <div class="grid gap-4 lg:grid-cols-2">
    <section class="card">
      <h2 class="mb-3">Mis siguientes acciones</h2>
      {
        myActions.data?.length ? (
          <ul class="divide-y divide-slate-100 text-sm">
            {myActions.data.map((d) => (
              <li class="flex items-start justify-between gap-3 py-2">
                <div>
                  <a href={`/oportunidades/${d.id}`}>{d.deal_name_branch}</a>
                  <div class="text-slate-600">{d.next_action}</div>
                  <div class="text-xs text-slate-400">{d.stage ? STAGE_LABELS[d.stage] : ''}</div>
                </div>
                <span class:list={['badge shrink-0', d.next_action_overdue && 'badge-red']}>
                  {fmtDate(d.next_action_due_date)}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-slate-500">No tiene acciones pendientes.</p>
        )
      }
    </section>

    <section class="card">
      <h2 class="mb-3">Próximas sesiones de jornada</h2>
      {
        sessions.data?.length ? (
          <ul class="divide-y divide-slate-100 text-sm">
            {sessions.data.map((s) => (
              <li class="flex items-start justify-between gap-3 py-2">
                <div>
                  <a href={`/jornadas/${s.campaign_id}`}>{s.company_name}</a>
                  <span class="text-slate-500"> · {s.city_name}</span>
                  <div class="text-xs text-slate-500">
                    {s.session_date && fmtWeekday(s.session_date)}, {fmtTime(s.start_time)}–{fmtTime(s.end_time)} ·{' '}
                    {s.responsible_user_name}
                  </div>
                </div>
                {s.has_conflict && <span class="badge badge-red shrink-0">Cruce</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-slate-500">No hay sesiones programadas.</p>
        )
      }
    </section>

    {
      canSeeApprovals && (
        <section class="card">
          <h2 class="mb-3">Convenios pendientes de aprobación</h2>
          {pendingAgreements.data?.length ? (
            <ul class="divide-y divide-slate-100 text-sm">
              {pendingAgreements.data.map((a) => (
                <li class="flex items-center justify-between gap-3 py-2">
                  <a href={`/convenios/${a.id}`}>
                    {a.company_name}
                    {a.deal_name_branch && <span class="text-slate-500"> · {a.deal_name_branch}</span>}
                  </a>
                  <span class:list={['badge', a.documents_verified ? 'badge-green' : 'badge-amber']}>
                    {a.documents_verified ? 'Documentos verificados' : AGREEMENT_STATUS_LABELS[a.status]}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-slate-500">No hay convenios pendientes.</p>
          )}
        </section>
      )
    }

    {
      canSeeOrders && (
        <section class="card">
          <h2 class="mb-3">Órdenes pendientes de verificación</h2>
          {pendingOrders.data?.length ? (
            <ul class="divide-y divide-slate-100 text-sm">
              {pendingOrders.data.map((o) => (
                <li class="flex items-center justify-between gap-3 py-2">
                  <div>
                    <a href={`/ordenes/${o.id}`}>{orderNumber(o.order_number)} · {o.buyer_name}</a>
                    <div class="text-xs text-slate-500">{o.company_name ?? 'Particular'} · {cop(o.total_amount)}</div>
                  </div>
                  {o.missing_requirements?.length ? (
                    <span class="badge badge-amber shrink-0" title={o.missing_requirements.join('; ')}>Faltan {o.missing_requirements.length} soportes</span>
                  ) : (
                    <span class="badge badge-green shrink-0">Lista para verificar</span>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-slate-500">No hay órdenes pendientes.</p>
          )}
        </section>
      )
    }

    <section class="card">
      <h2 class="mb-3">Oportunidades sin interacción reciente</h2>
      {
        stale.data?.length ? (
          <ul class="divide-y divide-slate-100 text-sm">
            {stale.data.map((d) => (
              <li class="flex items-center justify-between gap-3 py-2">
                <div>
                  <a href={`/oportunidades/${d.id}`}>{d.deal_name_branch}</a>
                  <span class="text-slate-500"> · {d.company_name}</span>
                  <div class="text-xs text-slate-500">{cop(d.estimated_billing_amount)}</div>
                </div>
                <span class="badge badge-amber shrink-0">{d.days_inactive} días</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-slate-500">Todas las oportunidades activas tienen interacción reciente.</p>
        )
      }
    </section>
  </div>
</AppLayout>
