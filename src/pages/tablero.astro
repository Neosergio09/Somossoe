---
// RF-M07-01: tablero de acción inmediata. Muestra solo datos reales
// disponibles; no proyecta resultados.
import AppLayout from '../layouts/AppLayout.astro';
import { hasRole } from '../lib/auth';
import { addDays, cop, fmtDate, todayCo } from '../lib/format';
import { COLLECTION_RESPONSIBLE_LABELS, OPS_STATUS_BADGE, OPS_STATUS_LABELS, STAGE_LABELS } from '../lib/labels';
import { orderNumber } from '../lib/orders';

const { supabase } = Astro.locals;
const today = todayCo();
const in7 = addDays(today, 7);
// Operación no tiene acceso a facturación ni recaudo (matriz §3.2)
const canSeeMoney = hasRole(Astro.locals, 'administracion_cartera', 'direccion', 'comercial', 'socio');
const canSeeReclass = canSeeMoney;
const empty = { data: [] as never[] };

const [toRelease, missingDocs, inLab, toDeliver, toInvoice, withDiff, dueInstallments, quietDeals, pendingReclass] = await Promise.all([
  supabase
    .from('v_orders')
    .select('id, order_number, buyer_name, company_name, total_amount, release_blockers, requirements_verified_at')
    .eq('doc_status', 'requisitos_verificados')
    .eq('ops_status', 'pendiente_liberar')
    .eq('is_cancelled', false)
    .order('requirements_verified_at'),
  supabase
    .from('v_orders')
    .select('id, order_number, buyer_name, company_name, missing_requirements, created_at')
    .eq('doc_status', 'pendiente_soportes')
    .eq('is_cancelled', false)
    .order('created_at')
    .limit(50),
  supabase.from('v_productions').select('*').eq('status', 'en_produccion').order('promised_date'),
  supabase
    .from('v_orders')
    .select('id, order_number, buyer_name, company_name, ops_status, is_historical_migration')
    .in('ops_status', ['listo_para_entregar', 'entrega_parcial'])
    .eq('is_cancelled', false)
    .order('updated_at'),
  canSeeMoney ? supabase.from('v_orders_to_invoice').select('*').order('created_at') : Promise.resolve(empty),
  canSeeMoney
    ? supabase.from('v_orders').select('id, order_number, buyer_name, company_name, total_amount').eq('accounting_status', 'factura_con_diferencia').eq('is_cancelled', false)
    : Promise.resolve(empty),
  canSeeMoney ? supabase.from('v_installments_due').select('*').lte('due_date', in7).order('due_date').limit(200) : Promise.resolve(empty),
  supabase
    .from('v_deals_board')
    .select('id, deal_name_branch, company_name, stage, assigned_user_name, days_inactive, inactivity_alert, next_action, next_action_due_date, next_action_overdue')
    .or('inactivity_alert.eq.true,next_action_overdue.eq.true')
    .order('days_inactive', { ascending: false })
    .limit(50),
  canSeeReclass
    ? supabase.from('v_portfolio_reclassifications').select('id, order_id, order_number, buyer_name, balance_at_request, requested_at').eq('status', 'pendiente').order('requested_at')
    : Promise.resolve(empty),
]);

const releaseRows = toRelease.data ?? [];
const ready = releaseRows.filter((o) => !o.release_blockers?.length);
const blocked = releaseRows.filter((o) => o.release_blockers?.length);
const labRows = inLab.data ?? [];
const overdueLab = labRows.filter((p) => p.is_overdue);
const installments = dueInstallments.data ?? [];
const overdueInst = installments.filter((i) => i.is_overdue);
const sum = (rows: { pending_amount?: number | null }[]) => rows.reduce((s, r) => s + Number(r.pending_amount ?? 0), 0);
const invoiceRows = toInvoice.data ?? [];

const tiles: { label: string; value: string | number; href: string; tone?: string }[] = [
  { label: 'Listas para producir', value: ready.length, href: '/produccion' },
  { label: 'Bloqueadas por soportes o anticipo', value: blocked.length + (missingDocs.data?.length ?? 0), href: '#producir', tone: blocked.length + (missingDocs.data?.length ?? 0) ? 'text-amber-700' : '' },
  { label: 'En laboratorio (atrasadas)', value: `${labRows.length} (${overdueLab.length})`, href: '/produccion?vista=en_produccion', tone: overdueLab.length ? 'text-red-700' : '' },
  { label: 'Por entregar', value: toDeliver.data?.length ?? 0, href: '/produccion?vista=listas' },
  ...(canSeeMoney
    ? [
        { label: 'Sin factura vinculada', value: invoiceRows.length, href: '/facturas' },
        { label: 'Cuotas vencidas', value: cop(sum(overdueInst)), href: '/recaudo?vista=cartera', tone: overdueInst.length ? 'text-red-700' : '' },
      ]
    : []),
  { label: 'Oportunidades quietas', value: quietDeals.data?.length ?? 0, href: '#quietas', tone: quietDeals.data?.length ? 'text-amber-700' : '' },
];
---

<AppLayout title="Tablero">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-2">
    <div>
      <h1>Tablero de seguimiento</h1>
      <p class="text-sm text-slate-500">¿Qué debemos atender primero? Solo datos registrados; no proyecta resultados.</p>
    </div>
    <span class="text-sm text-slate-500">Hoy: {fmtDate(today)}</span>
  </div>

  <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
    {tiles.map((t) => (
      <a href={t.href} class="card block hover:no-underline hover:shadow-sm">
        <div class="label">{t.label}</div>
        <div class:list={['text-xl font-semibold', t.tone]}>{t.value}</div>
      </a>
    ))}
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <!-- 1. Listo para producir -->
    <section class="card" id="producir">
      <h2 class="mb-1">1. ¿Qué está listo para producir?</h2>
      <p class="mb-3 text-xs text-slate-500">Requisitos verificados y sin liberar; abajo, lo que está bloqueado y por qué.</p>
      <table class="table text-sm">
        <thead><tr><th>Orden</th><th>Comprador</th><th class="text-right">Valor</th><th>Situación</th></tr></thead>
        <tbody>
          {ready.slice(0, 10).map((o) => (
            <tr>
              <td><a href={`/ordenes/${o.id}`}>{orderNumber(o.order_number)}</a></td>
              <td>{o.buyer_name}<div class="text-xs text-slate-500">{o.company_name ?? 'Particular'}</div></td>
              <td class="text-right whitespace-nowrap">{cop(o.total_amount)}</td>
              <td><span class="badge badge-green">Lista para liberar</span></td>
            </tr>
          ))}
          {blocked.slice(0, 10).map((o) => (
            <tr>
              <td><a href={`/ordenes/${o.id}`}>{orderNumber(o.order_number)}</a></td>
              <td>{o.buyer_name}<div class="text-xs text-slate-500">{o.company_name ?? 'Particular'}</div></td>
              <td class="text-right whitespace-nowrap">{cop(o.total_amount)}</td>
              <td class="text-xs text-amber-700">{o.release_blockers?.join('; ')}</td>
            </tr>
          ))}
          {(missingDocs.data ?? []).slice(0, 10).map((o) => (
            <tr>
              <td><a href={`/ordenes/${o.id}`}>{orderNumber(o.order_number)}</a></td>
              <td>{o.buyer_name}<div class="text-xs text-slate-500">{o.company_name ?? 'Particular'}</div></td>
              <td></td>
              <td class="text-xs text-amber-700">
                {o.missing_requirements?.length ? `Falta: ${o.missing_requirements.join('; ')}` : 'Pendiente de verificación de Administración'}
              </td>
            </tr>
          ))}
          {!releaseRows.length && !missingDocs.data?.length && <tr><td colspan="4" class="text-slate-500">Nada pendiente de liberar.</td></tr>}
        </tbody>
      </table>
    </section>

    <!-- 2. Falta producir o entregar -->
    <section class="card">
      <h2 class="mb-1">2. ¿Qué falta producir o entregar?</h2>
      <p class="mb-3 text-xs text-slate-500">En laboratorio (las atrasadas frente a la fecha prometida, en rojo) y órdenes listas o con entrega parcial.</p>
      <table class="table text-sm">
        <thead><tr><th>Orden</th><th>Comprador</th><th>Laboratorio</th><th>Estado</th></tr></thead>
        <tbody>
          {labRows.slice(0, 12).map((p) => (
            <tr class:list={[p.is_overdue && 'bg-red-50']}>
              <td><a href={p.warranty_id ? `/garantias/${p.warranty_id}` : `/ordenes/${p.order_id}`}>{orderNumber(p.order_number)}</a>{p.warranty_id && <span class="badge ml-1">Garantía</span>}</td>
              <td>{p.buyer_name}<div class="text-xs text-slate-500">{p.company_name ?? 'Particular'}</div></td>
              <td>{p.lab_name}{p.lab_order_reference && <div class="text-xs text-slate-500">Pedido {p.lab_order_reference}</div>}</td>
              <td class="whitespace-nowrap">
                {p.is_overdue ? <span class="badge badge-red">Atrasada · {fmtDate(p.promised_date)}</span> : <span class="text-xs">Prometida {fmtDate(p.promised_date)}</span>}
              </td>
            </tr>
          ))}
          {(toDeliver.data ?? []).slice(0, 12).map((o) => (
            <tr>
              <td><a href={`/ordenes/${o.id}`}>{orderNumber(o.order_number)}</a></td>
              <td>{o.buyer_name}<div class="text-xs text-slate-500">{o.company_name ?? 'Particular'}</div></td>
              <td></td>
              <td><span class={OPS_STATUS_BADGE[o.ops_status!]}>{OPS_STATUS_LABELS[o.ops_status!]}</span></td>
            </tr>
          ))}
          {!labRows.length && !toDeliver.data?.length && <tr><td colspan="4" class="text-slate-500">Nada en laboratorio ni por entregar.</td></tr>}
        </tbody>
      </table>
    </section>

    <!-- 3. Falta facturar o cobrar -->
    {
      canSeeMoney && (
        <section class="card">
          <h2 class="mb-1">3. ¿Qué falta facturar o cobrar?</h2>
          <p class="mb-3 text-xs text-slate-500">Órdenes verificadas sin factura de Alegra, diferencias abiertas y cuotas vencidas o que vencen en los próximos 7 días.</p>

          {(withDiff.data?.length ?? 0) > 0 && (
            <div class="mb-3 rounded-md border border-red-200 bg-red-50 p-2 text-sm text-red-800">
              Diferencia visible en {withDiff.data!.length} orden(es):{' '}
              {withDiff.data!.slice(0, 8).map((o, i) => (
                <>{i > 0 && ', '}<a href={`/ordenes/${o.id}`}>{orderNumber(o.order_number)}</a></>
              ))}
            </div>
          )}

          <h3 class="mb-1 text-sm font-semibold">Cuotas</h3>
          <table class="table mb-3 text-sm">
            <thead><tr><th>Vence</th><th>Orden</th><th>Comprador</th><th>Cobro a</th><th class="text-right">Pendiente</th></tr></thead>
            <tbody>
              {installments.slice(0, 15).map((i) => (
                <tr class:list={[i.is_overdue && 'bg-red-50']}>
                  <td class="whitespace-nowrap">{i.is_overdue ? <span class="badge badge-red">{fmtDate(i.due_date)}</span> : fmtDate(i.due_date)}</td>
                  <td><a href={`/ordenes/${i.order_id}`}>{orderNumber(i.order_number)}</a> <span class="text-xs text-slate-500">cuota {i.installment_number}</span></td>
                  <td>{i.buyer_name}<div class="text-xs text-slate-500">{i.company_name ?? 'Particular'}</div></td>
                  <td class="text-xs">{COLLECTION_RESPONSIBLE_LABELS[i.collection_responsible!]}</td>
                  <td class="text-right whitespace-nowrap">{cop(i.pending_amount)}</td>
                </tr>
              ))}
              {!installments.length && <tr><td colspan="5" class="text-slate-500">Sin cuotas vencidas ni próximas.</td></tr>}
            </tbody>
          </table>
          {installments.length > 15 && <p class="mb-3 text-xs"><a href="/recaudo?vista=cartera">Ver toda la cartera ({installments.length} cuotas)</a></p>}

          <h3 class="mb-1 text-sm font-semibold">Sin factura vinculada</h3>
          <table class="table text-sm">
            <thead><tr><th>Orden</th><th>Comprador</th><th class="text-right">Por facturar</th></tr></thead>
            <tbody>
              {invoiceRows.slice(0, 10).map((o) => (
                <tr>
                  <td><a href={`/ordenes/${o.id}`}>{orderNumber(o.order_number)}</a></td>
                  <td>{o.buyer_name}<div class="text-xs text-slate-500">{o.company_name ?? 'Particular'}</div></td>
                  <td class="text-right whitespace-nowrap">{cop(o.pending_amount)}</td>
                </tr>
              ))}
              {!invoiceRows.length && <tr><td colspan="3" class="text-slate-500">Todo lo verificado tiene factura vinculada.</td></tr>}
            </tbody>
          </table>

          {(pendingReclass.data?.length ?? 0) > 0 && (
            <p class="mt-3 text-sm">
              <span class="badge badge-amber">{pendingReclass.data!.length}</span> reclasificación(es) de cartera pendientes de Dirección ·{' '}
              <a href="/recaudo?vista=reclasificaciones">ver</a>
            </p>
          )}
        </section>
      )
    }

    <!-- 4. Oportunidades quietas -->
    <section class="card" id="quietas">
      <h2 class="mb-1">4. ¿Qué oportunidades están quietas?</h2>
      <p class="mb-3 text-xs text-slate-500">Sin interacción por encima del umbral o con la siguiente acción vencida.</p>
      <table class="table text-sm">
        <thead><tr><th>Negocio</th><th>Etapa</th><th>Ejecutivo</th><th>Alerta</th></tr></thead>
        <tbody>
          {(quietDeals.data ?? []).slice(0, 15).map((d) => (
            <tr>
              <td><a href={`/oportunidades/${d.id}`}>{d.deal_name_branch}</a><div class="text-xs text-slate-500">{d.company_name}</div></td>
              <td class="text-xs">{d.stage ? STAGE_LABELS[d.stage] : ''}</td>
              <td class="text-xs">{d.assigned_user_name ?? '—'}</td>
              <td class="text-xs">
                {d.inactivity_alert && <span class="badge badge-amber">{d.days_inactive} días sin interacción</span>}
                {d.next_action_overdue && <div class="mt-1 text-red-700">Acción vencida {fmtDate(d.next_action_due_date)}: {d.next_action}</div>}
              </td>
            </tr>
          ))}
          {!quietDeals.data?.length && <tr><td colspan="4" class="text-slate-500">Ninguna oportunidad quieta.</td></tr>}
        </tbody>
      </table>
    </section>
  </div>
</AppLayout>
