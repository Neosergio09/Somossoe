---
import AppLayout from '../../layouts/AppLayout.astro';
import ProductionPanel from '../../components/ProductionPanel.astro';
import DeliveriesPanel from '../../components/DeliveriesPanel.astro';
import SupportFile from '../../components/SupportFile.astro';
import { filesRequired, supportHref, supportPathFrom } from '../../lib/supports';
import { hasRole } from '../../lib/auth';
import { cop, fmtDateTime } from '../../lib/format';
import { checkbox, ensure, FormError, int, parseForm, runActions, text, uuid, z } from '../../lib/forms';
import { activeLabs, fulfillmentActions } from '../../lib/fulfillment';
import { itemLabel, loadDeliveries } from '../../lib/deliveries';
import { CREDIT_NOTE_STATUS_BADGE, CREDIT_NOTE_STATUS_LABELS, WARRANTY_STATUS_BADGE, WARRANTY_STATUS_LABELS, WARRANTY_TYPE_LABELS } from '../../lib/labels';
import { activeUsers } from '../../lib/options';
import { orderNumber } from '../../lib/orders';

const { supabase } = Astro.locals;
const id = Astro.params.id!;

const { data: w } = await supabase.from('v_warranties').select('*').eq('id', id).maybeSingle();
if (!w) return new Response('Caso no encontrado', { status: 404 });
const orderId = w.order_id!;
const [{ data: wFile }, requireFiles] = await Promise.all([
  supabase.from('post_sale_warranties').select('evidence_file_path').eq('id', id).maybeSingle(),
  filesRequired(supabase),
]);
const evidencePath = wFile?.evidence_file_path ?? null;

const outcome = await runActions(Astro, {
  ...fulfillmentActions(supabase, { orderId, warrantyId: id }),
  update: async (form) => {
    const input = parseForm(
      z.object({
        incident_type: z.enum(['garantia', 'reclamo', 'ajuste', 'otro']),
        description: text(2000),
        responsible_user_id: uuid(),
        resolution: text(2000).optional(),
        evidence_received: checkbox(),
      }),
      form,
    );
    ensure(
      await supabase
        .from('post_sale_warranties')
        .update({
          ...input,
          resolution: input.resolution ?? null,
          ...(supportPathFrom(form, 'evidence_file_path', 'garantias') ? { evidence_file_path: supportPathFrom(form, 'evidence_file_path', 'garantias') } : {}),
        })
        .eq('id', id)
        .select('id')
        .single(),
    );
    return { message: 'Caso actualizado.' };
  },
  credit_note: async (form) => {
    const input = parseForm(
      z.object({
        credit_note_status: z.enum(['no_aplica', 'por_solicitar', 'solicitada', 'recibida']),
        credit_note_lab_provider_id: uuid().optional(),
        credit_note_amount: int().min(0, { error: 'No puede ser negativo' }).optional(),
        credit_note_reference: text(60).optional(),
      }),
      form,
    );
    if (input.credit_note_status !== 'no_aplica' && !input.credit_note_lab_provider_id) {
      throw new FormError('Indique a qué laboratorio se le cobra la nota crédito.');
    }
    if (input.credit_note_status === 'recibida' && (input.credit_note_amount == null || !input.credit_note_reference)) {
      throw new FormError('Para marcarla recibida registre el número y el valor de la nota crédito.');
    }
    ensure(
      await supabase
        .from('post_sale_warranties')
        .update({
          credit_note_status: input.credit_note_status,
          credit_note_lab_provider_id: input.credit_note_lab_provider_id ?? null,
          credit_note_amount: input.credit_note_amount ?? null,
          credit_note_reference: input.credit_note_reference ?? null,
        })
        .eq('id', id)
        .select('id')
        .single(),
    );
    return { message: `Nota crédito: ${CREDIT_NOTE_STATUS_LABELS[input.credit_note_status].toLowerCase()}.` };
  },
  close: async (form) => {
    const input = parseForm(z.object({ resolution: text(2000).optional(), evidence_received: checkbox() }), form);
    if (!input.resolution) throw new FormError('Registre la solución aplicada.');
    ensure(
      await supabase
        .from('post_sale_warranties')
        .update({
          status: 'cerrada',
          resolution: input.resolution,
          evidence_received: input.evidence_received,
          ...(supportPathFrom(form, 'evidence_file_path', 'garantias') ? { evidence_file_path: supportPathFrom(form, 'evidence_file_path', 'garantias') } : {}),
        })
        .eq('id', id)
        .select('id')
        .single(),
    );
    return { message: 'Caso cerrado.' };
  },
});
if (outcome?.kind === 'redirect') return outcome.response;
const error = outcome?.kind === 'error' ? outcome.error : null;
const v = outcome?.kind === 'error' ? outcome.values : {};
const lastAction = outcome?.kind === 'error' ? outcome.action : '';

const [items, productions, deliveries, labs, responsibles] = await Promise.all([
  supabase.from('order_items').select('*').eq('order_id', orderId).order('created_at'),
  supabase.from('v_productions').select('*').eq('warranty_id', id).order('released_at', { ascending: false }),
  loadDeliveries(supabase, orderId, id),
  activeLabs(supabase),
  activeUsers(supabase, ['operacion', 'direccion']),
]);

const closed = w.status === 'cerrada';
const isOps = hasRole(Astro.locals, 'operacion');
const isDireccion = hasRole(Astro.locals, 'direccion');
const canEdit = !closed && (isOps || isDireccion);
// La nota crédito suele llegar después: se actualiza aunque el caso esté cerrado
const canEditCredit = isOps || isDireccion;
const creditStatus = w.credit_note_status ?? 'no_aplica';
const production = productions.data?.find((p) => p.status !== 'cancelada') ?? null;
const cancelled = productions.data?.filter((p) => p.status === 'cancelada') ?? [];
const hasDeliveries = deliveries.records.length > 0;
const rows = (items.data ?? []).map((i) => {
  const delivered = deliveries.byItem.get(i.id) ?? 0;
  return { order_item_id: i.id, item_type: i.item_type, label: itemLabel(i), quantity: i.quantity, delivered, pending: i.quantity - delivered };
});
const pendingReplacement = !!production && !hasDeliveries;
---

<AppLayout title={`Posventa · ${orderNumber(w.order_number)}`} error={error}>
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div>
      <a href="/garantias" class="text-sm">← Posventa</a>
      <h1>{WARRANTY_TYPE_LABELS[w.incident_type!]} · Orden <a href={`/ordenes/${orderId}`}>{orderNumber(w.order_number)}</a></h1>
      <p class="text-sm text-slate-600">{w.buyer_name} · {w.buyer_document_id}{w.company_name && ` · ${w.company_name}`}</p>
      <p class="text-xs text-slate-500">Abierto por {w.opened_by_name ?? '—'} el {fmtDateTime(w.created_at)} · Responsable: {w.responsible_name}</p>
    </div>
    <span class={`${WARRANTY_STATUS_BADGE[w.status!]} text-sm`}>{WARRANTY_STATUS_LABELS[w.status!]}</span>
  </div>

  <p class="mb-4 rounded-md border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600">
    Una reposición por garantía no crea un nuevo ingreso, no modifica el valor de la orden, no duplica la cartera y no altera su estado operativo.
  </p>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <section class="card space-y-2 text-sm">
        <h2>Caso</h2>
        <p class="whitespace-pre-line">{w.description}</p>
        {w.resolution && (
          <div>
            <div class="label">Solución aplicada</div>
            <p class="whitespace-pre-line">{w.resolution}</p>
          </div>
        )}
        <p class:list={[w.evidence_received ? 'text-green-700' : 'text-amber-700']}>
          {w.evidence_received ? '✓ Evidencia de cierre recibida' : '○ Sin evidencia de cierre'}
          {evidencePath && <> · <a href={supportHref(evidencePath)} target="_blank" rel="noopener">ver archivo</a></>}
        </p>
        {closed && <p class="text-green-700">Cerrado por {w.closed_by_name} el {fmtDateTime(w.closed_at)}</p>}
      </section>

      {
        (!closed || production || cancelled.length > 0) && (
          <ProductionPanel
            title="Reposición con laboratorio"
            production={production}
            cancelled={cancelled}
            labs={labs}
            canOperate={isOps && !closed}
            canRelease={!closed && !production}
            hasDeliveries={hasDeliveries}
            releaseLabel="Enviar reposición al laboratorio"
            values={v}
            lastAction={lastAction}
          />
        )
      }

      {
        (production || hasDeliveries) && (
          <DeliveriesPanel requireFiles={requireFiles}
            title="Entrega de la reposición"
            rows={rows}
            deliveries={deliveries.records}
            canDeliver={isOps && !closed && production?.status === 'listo_para_entregar'}
            labReady={production?.status === 'listo_para_entregar'}
            onlyWhenReady
            canDelete={isOps && !closed}
            values={v}
          />
        )
      }
    </div>

    <div class="space-y-4">
      <section class="card space-y-2 text-sm">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2>Nota crédito del laboratorio</h2>
          <span class={CREDIT_NOTE_STATUS_BADGE[creditStatus]}>{CREDIT_NOTE_STATUS_LABELS[creditStatus]}</span>
        </div>
        <p class="text-xs text-slate-500">Lo que SOE le cobra al laboratorio responsable de la falla (puede ser distinto al que hace la reposición).</p>
        {creditStatus !== 'no_aplica' && (
          <dl class="grid grid-cols-2 gap-2">
            <div><dt class="label">Laboratorio</dt><dd>{w.credit_note_lab_name ?? '—'}</dd></div>
            <div><dt class="label">Valor</dt><dd>{cop(w.credit_note_amount)}</dd></div>
            <div><dt class="label">N.º de nota</dt><dd>{w.credit_note_reference ?? '—'}</dd></div>
            <div><dt class="label">Actualizada</dt><dd class="text-xs">{fmtDateTime(w.credit_note_updated_at)}</dd></div>
          </dl>
        )}
        {canEditCredit && (
          <details open={lastAction === 'credit_note'}>
            <summary class="cursor-pointer text-brand-700">Actualizar nota crédito</summary>
            <form method="post" class="mt-2 space-y-2">
              <input type="hidden" name="_action" value="credit_note" />
              <label class="label">Estado</label>
              <select class="input" name="credit_note_status">
                {Object.entries(CREDIT_NOTE_STATUS_LABELS).map(([value, label]) => (
                  <option value={value} selected={(v.credit_note_status ?? creditStatus) === value}>{label}</option>
                ))}
              </select>
              <label class="label">Laboratorio al que se le cobra</label>
              <select class="input" name="credit_note_lab_provider_id">
                <option value="">Seleccione…</option>
                {labs.map((l) => <option value={l.id} selected={(v.credit_note_lab_provider_id ?? w.credit_note_lab_provider_id) === l.id}>{l.name}</option>)}
              </select>
              <label class="label">Valor</label>
              <input class="input" name="credit_note_amount" type="number" min="0" step="1" value={v.credit_note_amount ?? w.credit_note_amount ?? ''} />
              <label class="label">N.º de la nota crédito</label>
              <input class="input" name="credit_note_reference" maxlength="60" value={v.credit_note_reference ?? w.credit_note_reference ?? ''} />
              <p class="text-xs text-slate-500">Para marcarla recibida se exigen el número y el valor.</p>
              <button class="btn w-full" type="submit">Guardar nota crédito</button>
            </form>
          </details>
        )}
      </section>

      {
        canEdit && (
          <section class="card text-sm">
            <h2 class="mb-3">Datos del caso</h2>
            <form method="post" class="space-y-2">
              <input type="hidden" name="_action" value="update" />
              <label class="label">Tipo</label>
              <select class="input" name="incident_type">
                {Object.entries(WARRANTY_TYPE_LABELS).map(([value, label]) => <option value={value} selected={(v.incident_type ?? w.incident_type) === value}>{label}</option>)}
              </select>
              <label class="label">Responsable</label>
              <select class="input" name="responsible_user_id">
                {responsibles.map((u) => <option value={u.id} selected={(v.responsible_user_id ?? w.responsible_user_id) === u.id}>{u.full_name}</option>)}
              </select>
              <label class="label">Descripción</label>
              <textarea class="input" name="description" rows="3" required>{v.description ?? w.description}</textarea>
              <label class="label">Solución aplicada</label>
              <textarea class="input" name="resolution" rows="3">{v.resolution ?? w.resolution ?? ''}</textarea>
              <label class="flex items-center gap-2"><input type="checkbox" name="evidence_received" checked={!!w.evidence_received} /> Evidencia de cierre recibida</label>
              <SupportFile kind="garantias" name="evidence_file_path" label="Archivo de evidencia" current={evidencePath} compact />
              <button class="btn w-full" type="submit">Guardar</button>
            </form>
          </section>
        )
      }

      {
        isDireccion && !closed && (
          <section class="card space-y-2 text-sm">
            <h2>Cierre (Dirección)</h2>
            {pendingReplacement && <p class="text-amber-700">○ Falta entregar la reposición.</p>}
            <form method="post" class="space-y-2">
              <input type="hidden" name="_action" value="close" />
              <label class="label">Solución aplicada *</label>
              <textarea class="input" name="resolution" rows="3" required>{v.resolution ?? w.resolution ?? ''}</textarea>
              <SupportFile kind="garantias" name="evidence_file_path" label="Evidencia de cierre" current={evidencePath} required={requireFiles} compact />
              {!requireFiles && (
                <label class="flex items-center gap-2"><input type="checkbox" name="evidence_received" checked={!!w.evidence_received} /> Evidencia recibida en papel</label>
              )}
              <button class="btn btn-primary w-full" type="submit" disabled={pendingReplacement}>Cerrar caso</button>
            </form>
          </section>
        )
      }
    </div>
  </div>
</AppLayout>
