---
import AppLayout from '../layouts/AppLayout.astro';
import { FormError, parseForm, runActions, z } from '../lib/forms';

const outcome = await runActions(Astro, {
  login: async (form) => {
    const input = parseForm(
      z.object({
        email: z.email({ error: 'Correo inválido' }),
        password: z.string().min(1, { error: 'Ingrese la contraseña' }),
      }),
      form,
    );
    const { error } = await Astro.locals.supabase.auth.signInWithPassword(input);
    if (error) throw new FormError('Correo o contraseña incorrectos.');
    return { redirect: '/' };
  },
});
if (outcome?.kind === 'redirect') return outcome.response;
const error = outcome?.kind === 'error' ? outcome.error : null;
const values = outcome?.kind === 'error' ? outcome.values : {};
---

<AppLayout title="Ingresar" bare error={error}>
  <div class="card mt-16">
    <h1 class="mb-1">CRM Somos SOE</h1>
    <p class="mb-6 text-sm text-slate-500">Ingrese con su usuario interno.</p>
    <form method="post" class="space-y-4">
      <input type="hidden" name="_action" value="login" />
      <div>
        <label class="label" for="email">Correo</label>
        <input class="input" id="email" name="email" type="email" autocomplete="username" required value={values.email} />
      </div>
      <div>
        <label class="label" for="password">Contraseña</label>
        <input class="input" id="password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <button class="btn btn-primary w-full" type="submit">Ingresar</button>
    </form>
  </div>
</AppLayout>
