---
import AppLayout from '../../layouts/AppLayout.astro';
import { hasRole } from '../../lib/auth';
import { fmtDateTime } from '../../lib/format';
import { checkbox, ensure, FormError, parseForm, runActions, text, uuid, z } from '../../lib/forms';
import { ROLE_LABELS, type AppRole } from '../../lib/labels';
import { EXTRA_ROLE_OPTIONS, PROFILES, profileOf, rolesLabel, type ProfileKey } from '../../lib/profiles';
import { createSupabaseAdminClient } from '../../lib/supabase';

if (!hasRole(Astro.locals, 'direccion')) return Astro.redirect('/');

const { supabase } = Astro.locals;
const roles = Object.keys(ROLE_LABELS) as [AppRole, ...AppRole[]];

// SRS 1.6 §3.3: se elige un perfil visible (plantilla de roles) o un rol
// principal con roles adicionales. «perfil:gestion» | «rol:operacion»
const accessValues = [
  ...Object.keys(PROFILES).map((k) => `perfil:${k}`),
  ...roles.map((r) => `rol:${r}`),
] as [string, ...string[]];
function resolveAccess(value: string, form: FormData): { role: AppRole; extra: AppRole[] } {
  const [kind, key] = value.split(':');
  if (kind === 'perfil') {
    const p = PROFILES[key as ProfileKey];
    return { role: p.role, extra: [...p.extra] };
  }
  const role = key as AppRole;
  const extra = form
    .getAll('extra_roles')
    .map(String)
    .filter((r): r is AppRole => (EXTRA_ROLE_OPTIONS as string[]).includes(r) && r !== role);
  // Dirección, Socio, Super administrador y Laboratorio no combinan roles
  const combinable = (EXTRA_ROLE_OPTIONS as string[]).includes(role);
  return { role, extra: combinable ? extra : [] };
}
const accessOf = (role: AppRole | null, extra: AppRole[]) => {
  const key = profileOf(role, extra);
  return key ? `perfil:${key}` : role ? `rol:${role}` : '';
};

const outcome = await runActions(Astro, {
  create_user: async (form) => {
    const input = parseForm(
      z.object({
        full_name: text(150),
        email: z.email({ error: 'Correo inválido' }),
        password: z.string().min(10, { error: 'mínimo 10 caracteres' }),
        access: z.enum(accessValues, { error: 'Seleccione un perfil o rol' }),
        lab_provider_id: uuid().optional(),
      }),
      form,
    );
    const { role, extra } = resolveAccess(input.access, form);
    if (role === 'proveedor_lab' && !input.lab_provider_id) {
      throw new FormError('Un usuario de laboratorio necesita un laboratorio asignado.');
    }
    // Solo Dirección llega aquí (comprobado arriba); la clave secreta no sale del servidor.
    const admin = createSupabaseAdminClient();
    const { data, error } = await admin.auth.admin.createUser({
      email: input.email,
      password: input.password,
      email_confirm: true,
      user_metadata: { full_name: input.full_name },
    });
    if (error || !data.user) {
      throw new FormError(
        /already|registered|exists/i.test(error?.message ?? '')
          ? 'Ya existe un usuario con ese correo.'
          : 'No se pudo crear el usuario.',
      );
    }
    ensure(
      await supabase
        .from('users_profiles')
        .update({ role, extra_roles: extra, active: true, lab_provider_id: role === 'proveedor_lab' ? (input.lab_provider_id ?? null) : null })
        .eq('id', data.user.id)
        .select('id')
        .single(),
    );
    return { message: `Usuario ${input.email} creado y activado como ${rolesLabel(role, extra)}.` };
  },
  update_user: async (form) => {
    const input = parseForm(
      z.object({
        user_id: uuid(),
        full_name: text(150),
        access: z.enum(accessValues).optional(),
        lab_provider_id: uuid().optional(),
        active: checkbox(),
      }),
      form,
    );
    const { role, extra } = input.access ? resolveAccess(input.access, form) : { role: null, extra: [] as AppRole[] };
    if (input.user_id === Astro.locals.userId && (!input.active || (role !== 'direccion' && role !== 'superadmin'))) {
      throw new FormError('No puede desactivarse ni quitarse a sí mismo el rol de Dirección o Super administrador.');
    }
    ensure(
      await supabase
        .from('users_profiles')
        .update({
          full_name: input.full_name,
          role,
          extra_roles: extra,
          lab_provider_id: role === 'proveedor_lab' ? (input.lab_provider_id ?? null) : null,
          active: input.active,
        })
        .eq('id', input.user_id)
        .select('id')
        .single(),
    );
    return { message: 'Usuario actualizado.' };
  },
});
if (outcome?.kind === 'redirect') return outcome.response;
const error = outcome?.kind === 'error' ? outcome.error : null;
const v = outcome?.kind === 'error' && outcome.action === 'create_user' ? outcome.values : {};

const [{ data: users }, { data: labs }] = await Promise.all([
  supabase.from('users_profiles').select('*').order('active', { ascending: false }).order('full_name'),
  supabase.from('lab_providers').select('id, name').eq('active', true).order('name'),
]);
---

<AppLayout title="Usuarios" error={error}>
  <h1 class="mb-4">Usuarios</h1>

  <section class="card mb-4">
    <h2 class="mb-3">Crear usuario</h2>
    <form method="post" class="grid grid-cols-1 gap-3 sm:grid-cols-5 sm:items-end">
      <input type="hidden" name="_action" value="create_user" />
      <div><label class="label">Nombre completo</label><input class="input" name="full_name" required value={v.full_name} /></div>
      <div><label class="label">Correo</label><input class="input" name="email" type="email" required value={v.email} /></div>
      <div><label class="label">Contraseña temporal</label><input class="input" name="password" type="text" minlength="10" required autocomplete="off" /></div>
      <div>
        <label class="label">Perfil o rol</label>
        <select class="input" name="access">
          <optgroup label="Perfiles">
            {Object.entries(PROFILES).map(([k, p]) => <option value={`perfil:${k}`} selected={v.access === `perfil:${k}`}>{p.label}</option>)}
          </optgroup>
          <optgroup label="Roles">
            {roles.map((r) => <option value={`rol:${r}`} selected={v.access === `rol:${r}`}>{ROLE_LABELS[r]}</option>)}
          </optgroup>
        </select>
      </div>
      <button class="btn btn-primary" type="submit">Crear y activar</button>
      {labs?.length ? (
        <div class="sm:col-span-2">
          <label class="label">Laboratorio (solo rol Laboratorio)</label>
          <select class="input" name="lab_provider_id">
            <option value="">—</option>
            {labs.map((l) => <option value={l.id}>{l.name}</option>)}
          </select>
        </div>
      ) : null}
    </form>
    <p class="mt-2 text-xs text-slate-500">Comparta la contraseña temporal por un canal seguro.</p>
    <ul class="mt-2 space-y-0.5 text-xs text-slate-500">
      {Object.values(PROFILES).map((p) => (
        <li><strong>{p.label}</strong> ({rolesLabel(p.role, [])}{p.extra.length ? ` + ${p.extra.map((r) => ROLE_LABELS[r]).join(' + ')}` : ''}): {p.description}</li>
      ))}
      <li>Los permisos se suman por rol y los aplica la base de datos; el perfil es solo una plantilla.</li>
    </ul>
  </section>

  <section class="card overflow-x-auto p-0">
    <table class="table">
      <thead><tr><th>Usuario</th><th>Perfil o rol</th><th>Laboratorio</th><th>Activo</th><th>Alta</th><th></th></tr></thead>
      <tbody>
        {
          users?.map((u) => (
            <tr class:list={[!u.active && 'bg-amber-50']}>
              <td colspan="6" class="p-0">
                <form method="post" class="grid grid-cols-1 items-center gap-2 px-2 py-2 sm:grid-cols-[2fr_1.3fr_1.3fr_0.6fr_1fr_auto]">
                  <input type="hidden" name="_action" value="update_user" />
                  <input type="hidden" name="user_id" value={u.id} />
                  <div>
                    <input class="input" name="full_name" value={u.full_name} required />
                    <div class="mt-1 text-xs text-slate-500">{u.email}</div>
                  </div>
                  <div>
                    <select class="input" name="access">
                      <option value="">Sin rol</option>
                      <optgroup label="Perfiles">
                        {Object.entries(PROFILES).map(([k, p]) => (
                          <option value={`perfil:${k}`} selected={accessOf(u.role, u.extra_roles) === `perfil:${k}`}>{p.label}</option>
                        ))}
                      </optgroup>
                      <optgroup label="Roles">
                        {roles.map((r) => <option value={`rol:${r}`} selected={accessOf(u.role, u.extra_roles) === `rol:${r}`}>{ROLE_LABELS[r]}</option>)}
                      </optgroup>
                    </select>
                    <details class="mt-1 text-xs">
                      <summary class="cursor-pointer text-slate-600">
                        {u.extra_roles.length ? `Adicionales: ${u.extra_roles.map((r) => ROLE_LABELS[r]).join(', ')}` : 'Roles adicionales'}
                      </summary>
                      <div class="mt-1 space-y-0.5">
                        {EXTRA_ROLE_OPTIONS.map((r) => (
                          <label class="flex items-center gap-1">
                            <input type="checkbox" name="extra_roles" value={r} checked={u.extra_roles.includes(r)} /> {ROLE_LABELS[r]}
                          </label>
                        ))}
                        <p class="text-slate-500">Se aplican con un rol (no con un perfil).</p>
                      </div>
                    </details>
                  </div>
                  <select class="input" name="lab_provider_id">
                    <option value="">—</option>
                    {labs?.map((l) => <option value={l.id} selected={u.lab_provider_id === l.id}>{l.name}</option>)}
                  </select>
                  <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="active" checked={u.active} /> Activo</label>
                  <span class="text-xs text-slate-500">{fmtDateTime(u.created_at)}</span>
                  <button class="btn btn-sm" type="submit">Guardar</button>
                </form>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</AppLayout>
