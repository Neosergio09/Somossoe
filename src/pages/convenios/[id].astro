---
import AppLayout from '../../layouts/AppLayout.astro';
import SupportFile from '../../components/SupportFile.astro';
import { filesRequired, supportHref, supportPathFrom } from '../../lib/supports';
import { hasRole, isOwnerComercial } from '../../lib/auth';
import { fmtDate, fmtDateTime, todayCo } from '../../lib/format';
import { checkbox, date, ensure, FormError, int, nullify, parseForm, runActions, text, uuid, z } from '../../lib/forms';
import {
  AGREEMENT_STATUS_BADGE,
  AGREEMENT_STATUS_LABELS,
  DOCUMENT_TYPE_LABELS,
  PAYROLL_LABELS,
} from '../../lib/labels';

// SRS 1.6 · RF-M01-03: el convenio se activa al cumplir requisitos (sin
// aprobación previa) y Dirección lo revisa después. Con el parámetro
// agreement_requires_direction_approval = 1 vuelve el flujo con aprobación.

const { supabase } = Astro.locals;
const id = Astro.params.id!;

type AgreementPatch = {
  status?: 'borrador' | 'pendiente_aprobacion' | 'aprobado' | 'cancelado';
  documents_verified?: boolean;
  cancel_reason?: string;
  reviewed_at?: string;
  valid_until?: string;
  validity_extension_reason?: string;
};
async function patchAgreement(patch: AgreementPatch) {
  ensure(await supabase.from('agreements_convenios').update(patch).eq('id', id).select('id').single());
}

const outcome = await runActions(Astro, {
  update_conditions: async (form) => {
    const input = parseForm(
      z.object({
        deal_id: uuid().optional(),
        payroll_frequency: z.enum(['mensual', 'quincenal']),
        max_installments: int().min(1),
        payroll_conditions: text(2000).optional(),
        hr_approval_required: checkbox(),
        valid_from: date().optional(),
        valid_until: date().optional(),
      }),
      form,
    );
    ensure(await supabase.from('agreements_convenios').update(nullify(input)).eq('id', id).select('id').single());
    return { message: 'Condiciones actualizadas.' };
  },
  add_document: async (form) => {
    const input = parseForm(
      z.object({
        document_name: text(200),
        document_type: z.enum(['convenio_firmado', 'camara_comercio', 'rut', 'formato_rrhh', 'otro']),
      }),
      form,
    );
    const filePath = supportPathFrom(form, 'file_path', 'convenios');
    ensure(await supabase.from('agreement_documents').insert({ ...input, file_path: filePath, agreement_id: id }));
    return { message: filePath ? 'Documento registrado con su archivo.' : 'Documento registrado.' };
  },
  replace_document: async (form) => {
    const input = parseForm(
      z.object({ replaces_id: uuid(), document_name: text(200), replace_reason: text(300).min(3, { error: 'Indique el motivo' }) }),
      form,
    );
    const filePath = supportPathFrom(form, 'file_path', 'convenios');
    if (!filePath) throw new FormError('Adjunte el archivo de la nueva versión.');
    const { data: previous } = await supabase
      .from('agreement_documents')
      .select('document_type')
      .eq('id', input.replaces_id)
      .eq('agreement_id', id)
      .maybeSingle();
    if (!previous) throw new FormError('El documento que quiere reemplazar no existe.');
    ensure(
      await supabase.from('agreement_documents').insert({
        agreement_id: id,
        document_name: input.document_name,
        document_type: previous.document_type,
        file_path: filePath,
        replaces_id: input.replaces_id,
        replace_reason: input.replace_reason,
      }),
    );
    return { message: 'Nueva versión registrada. La anterior se conserva en el historial.' };
  },
  attach_document: async (form) => {
    const docId = String(form.get('document_id') ?? '');
    const filePath = supportPathFrom(form, 'file_path', 'convenios');
    if (!filePath) throw new FormError('Adjunte el archivo antes de guardar.');
    ensure(await supabase.from('agreement_documents').update({ file_path: filePath }).eq('id', docId).eq('agreement_id', id).select('id').single());
    return { message: 'Archivo adjuntado.' };
  },
  delete_document: async (form) => {
    const docId = String(form.get('document_id') ?? '');
    ensure(await supabase.from('agreement_documents').delete().eq('id', docId).eq('agreement_id', id).select('id').single());
    return { message: 'Documento eliminado.' };
  },
  activate: async () => {
    await patchAgreement({ status: 'aprobado' });
    return { message: 'Convenio activado. Ya se pueden programar jornadas y registrar ventas por nómina.' };
  },
  send: async () => {
    await patchAgreement({ status: 'pendiente_aprobacion' });
    return { message: 'Convenio enviado a aprobación.' };
  },
  back_to_draft: async () => {
    await patchAgreement({ status: 'borrador' });
    return { message: 'El convenio volvió a Borrador.' };
  },
  verify: async () => {
    await patchAgreement({ documents_verified: true });
    return { message: 'Documentación verificada.' };
  },
  unverify: async () => {
    await patchAgreement({ documents_verified: false });
    return { message: 'Se retiró la verificación de la documentación.' };
  },
  approve: async () => {
    await patchAgreement({ status: 'aprobado' });
    return { message: 'Convenio aprobado.' };
  },
  review: async () => {
    await patchAgreement({ reviewed_at: new Date().toISOString() });
    return { message: 'Convenio marcado como revisado.' };
  },
  extend: async (form) => {
    const input = parseForm(
      z.object({ valid_until: date(), validity_extension_reason: text(300).min(3, { error: 'Indique el motivo' }) }),
      form,
    );
    await patchAgreement(input);
    return { message: 'Vigencia prorrogada.' };
  },
  cancel: async (form) => {
    const reason = String(form.get('cancel_reason') ?? '').trim();
    if (!reason) throw new FormError('Indique el motivo de la cancelación.');
    await patchAgreement({ status: 'cancelado', cancel_reason: reason });
    return { message: 'Convenio cancelado.' };
  },
});
if (outcome?.kind === 'redirect') return outcome.response;
const error = outcome?.kind === 'error' ? outcome.error : null;

const { data: a } = await supabase.from('v_agreements').select('*').eq('id', id).maybeSingle();
if (!a) return new Response('Convenio no encontrado', { status: 404 });

const [docs, people, deals, company, approvalSetting] = await Promise.all([
  supabase.from('agreement_documents').select('*, users_profiles(full_name)').eq('agreement_id', id).order('uploaded_at'),
  supabase
    .from('users_profiles')
    .select('id, full_name')
    .in(
      'id',
      [a.documents_verified_by, a.approved_by, a.reviewed_by, a.validity_extended_by, a.cancelled_by].filter((x): x is string => !!x),
    ),
  supabase.from('deals_opportunities').select('id, deal_name_branch').eq('company_id', a.company_id!).neq('stage', 'cierre_perdido').order('deal_name_branch'),
  supabase.from('companies').select('is_nit_provisional, assigned_user_id').eq('id', a.company_id!).maybeSingle(),
  supabase.from('system_settings').select('value').eq('key', 'agreement_requires_direction_approval').maybeSingle(),
]);
const personName = (uid: string | null) => people.data?.find((p) => p.id === uid)?.full_name ?? '—';

const status = a.status!;
const needsApproval = Number(approvalSetting.data?.value ?? 0) === 1;
const requireFiles = await filesRequired(supabase);
const editable = status === 'borrador' || status === 'pendiente_aprobacion';
// Comercial solo gestiona convenios de sus empresas (o de empresas sin ejecutivo)
const isComercial = isOwnerComercial(Astro.locals, company.data?.assigned_user_id, { allowUnassigned: true });
const isAdmin = hasRole(Astro.locals, 'administracion_cartera');
const isDireccion = hasRole(Astro.locals, 'direccion');
const canEdit = editable && (isComercial || isAdmin);
const canUpload = (isComercial || isAdmin) && status !== 'cancelado';

// Requisitos que exige la base para activar (RF-M01-03)
const today = todayCo();
const nitOk = !company.data?.is_nit_provisional;
const fileOk = !!a.has_signed_file;
const validityOk = !!a.valid_from && !!a.valid_until && a.valid_until >= today;
const ready = nitOk && fileOk && validityOk;
const canActivate =
  !needsApproval && (status === 'borrador' || status === 'pendiente_aprobacion') && (isComercial || isAdmin || isDireccion);
const allDocs = docs.data ?? [];
const currentDocs = allDocs.filter((d) => !d.superseded_at);
const previousDocs = allDocs.filter((d) => d.superseded_at);
---

<AppLayout title="Convenio" error={error}>
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div>
      <a href="/convenios" class="text-sm">← Convenios</a>
      <h1>Convenio · {a.company_name}</h1>
      <p class="text-sm text-slate-600">
        {a.deal_id ? <a href={`/oportunidades/${a.deal_id}`}>{a.deal_name_branch}</a> : 'Convenio marco (todas las sedes)'}
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      {status === 'aprobado' && !a.reviewed_at && <span class="badge badge-amber text-sm">Por revisar (Dirección)</span>}
      <span class={`${AGREEMENT_STATUS_BADGE[a.effective_status ?? 'borrador']} text-sm`}>
        {AGREEMENT_STATUS_LABELS[a.effective_status ?? 'borrador']}
      </span>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3 xl:grid-cols-[minmax(0,1fr)_24rem] 2xl:grid-cols-[minmax(0,1fr)_28rem]">
    <div class="min-w-0 space-y-4 lg:col-span-2 xl:col-span-1">
      <section class="card">
        <h2 class="mb-3">Condiciones</h2>
        <dl class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
          <div><dt class="label">Nómina</dt><dd>{a.payroll_frequency ? PAYROLL_LABELS[a.payroll_frequency] : '—'}</dd></div>
          <div><dt class="label">Máximo de cuotas</dt><dd>{a.max_installments}</dd></div>
          <div><dt class="label">Aval de RRHH</dt><dd>{a.hr_approval_required ? 'Requerido' : 'No requerido'}</dd></div>
          <div><dt class="label">Vigente desde</dt><dd>{fmtDate(a.valid_from)}</dd></div>
          <div><dt class="label">Vigente hasta</dt><dd>{fmtDate(a.valid_until)}</dd></div>
          <div class="col-span-full"><dt class="label">Condiciones acordadas</dt><dd class="whitespace-pre-line">{a.payroll_conditions ?? '—'}</dd></div>
          {
            a.validity_extended_at && (
              <div class="col-span-full text-xs text-slate-600">
                Vigencia prorrogada por {personName(a.validity_extended_by)} el {fmtDateTime(a.validity_extended_at)}: {a.validity_extension_reason}
              </div>
            )
          }
        </dl>
        {
          canEdit && (
            <details class="mt-4">
              <summary class="cursor-pointer text-sm font-medium text-brand-700">Editar condiciones</summary>
              <form method="post" class="mt-3 grid-form">
                <input type="hidden" name="_action" value="update_conditions" />
                <div class="sm:col-span-2">
                  <label class="label">Alcance</label>
                  <select class="input" name="deal_id">
                    <option value="">Convenio marco (todas las sedes)</option>
                    {deals.data?.map((d) => <option value={d.id} selected={a.deal_id === d.id}>{d.deal_name_branch}</option>)}
                  </select>
                </div>
                <div>
                  <label class="label">Nómina</label>
                  <select class="input" name="payroll_frequency">
                    {Object.entries(PAYROLL_LABELS).map(([value, label]) => <option value={value} selected={a.payroll_frequency === value}>{label}</option>)}
                  </select>
                </div>
                <div>
                  <label class="label">Máximo de cuotas</label>
                  <input class="input" name="max_installments" type="number" min="1" value={a.max_installments ?? ''} />
                </div>
                <div><label class="label">Vigente desde</label><input class="input" name="valid_from" type="date" value={a.valid_from ?? ''} /></div>
                <div><label class="label">Vigente hasta</label><input class="input" name="valid_until" type="date" value={a.valid_until ?? ''} /></div>
                <div class="sm:col-span-2">
                  <label class="label">Condiciones acordadas</label>
                  <textarea class="input" name="payroll_conditions" rows="3">{a.payroll_conditions ?? ''}</textarea>
                </div>
                <label class="flex items-center gap-2 text-sm sm:col-span-2">
                  <input type="checkbox" name="hr_approval_required" checked={!!a.hr_approval_required} /> Requiere aval de RRHH
                </label>
                <div class="sm:col-span-2"><button class="btn btn-primary" type="submit">Guardar</button></div>
              </form>
            </details>
          )
        }
        {
          status === 'aprobado' && (isAdmin || isDireccion) && (
            <details class="mt-4">
              <summary class="cursor-pointer text-sm font-medium text-brand-700">Prorrogar vigencia</summary>
              <form method="post" class="mt-3 grid-form">
                <input type="hidden" name="_action" value="extend" />
                <div>
                  <label class="label">Nueva fecha final</label>
                  <input class="input" name="valid_until" type="date" required min={a.valid_until ?? today} />
                </div>
                <div class="sm:col-span-2">
                  <label class="label">Motivo</label>
                  <input class="input" name="validity_extension_reason" required maxlength="300" placeholder="Ej. Renovación firmada por la empresa" />
                </div>
                <div class="sm:col-span-2"><button class="btn btn-primary" type="submit">Prorrogar</button></div>
              </form>
            </details>
          )
        }
      </section>

      <section class="card">
        <h2 class="mb-1">Documentación del cliente</h2>
        <p class="mb-3 text-xs text-slate-500">
          Los archivos se guardan en almacenamiento privado y se abren con un enlace temporal. Para activar el convenio, el convenio
          firmado debe tener su archivo PDF.
          {status === 'aprobado' && ' Con el convenio activo, los documentos no se borran: una corrección se carga como versión nueva.'}
          {!requireFiles && status !== 'aprobado' && ' Los demás documentos pueden registrarse recibidos en papel.'}
        </p>
        <table class="table">
          <thead><tr><th>Documento</th><th>Tipo</th><th>Archivo</th><th>Registrado</th><th></th></tr></thead>
          <tbody>
            {currentDocs.map((d) => (
              <tr>
                <td>
                  {d.document_name}
                  {d.replace_reason && <div class="text-xs text-slate-500">Versión nueva: {d.replace_reason}</div>}
                </td>
                <td>{DOCUMENT_TYPE_LABELS[d.document_type]}</td>
                <td>
                  {d.file_path ? (
                    <a class="badge badge-green" href={supportHref(d.file_path)} target="_blank" rel="noopener">Ver archivo</a>
                  ) : canUpload ? (
                    <form method="post" class="min-w-48 space-y-1">
                      <input type="hidden" name="_action" value="attach_document" />
                      <input type="hidden" name="document_id" value={d.id} />
                      <SupportFile kind="convenios" name="file_path" label="Adjuntar archivo" compact />
                      <button class="btn btn-sm" type="submit">Guardar archivo</button>
                    </form>
                  ) : (
                    <span class="badge">Pendiente</span>
                  )}
                </td>
                <td class="text-xs text-slate-500">{fmtDateTime(d.uploaded_at)} · {d.users_profiles?.full_name}</td>
                <td class="space-y-1">
                  {canEdit && (
                    <form method="post">
                      <input type="hidden" name="_action" value="delete_document" />
                      <input type="hidden" name="document_id" value={d.id} />
                      <button class="btn btn-sm btn-danger" type="submit">Eliminar</button>
                    </form>
                  )}
                  {canUpload && (
                    <details>
                      <summary class="cursor-pointer text-xs text-brand-700">Nueva versión</summary>
                      <form method="post" class="mt-2 min-w-56 space-y-2">
                        <input type="hidden" name="_action" value="replace_document" />
                        <input type="hidden" name="replaces_id" value={d.id} />
                        <input class="input" name="document_name" required value={d.document_name} />
                        <input class="input" name="replace_reason" required maxlength="300" placeholder="Motivo (ej. otrosí, escaneo legible)" />
                        <SupportFile kind="convenios" name="file_path" label="Archivo" required compact />
                        <button class="btn btn-sm" type="submit">Guardar versión</button>
                      </form>
                    </details>
                  )}
                </td>
              </tr>
            ))}
            {!currentDocs.length && <tr><td colspan="5" class="text-slate-500">Sin documentos registrados.</td></tr>}
          </tbody>
        </table>
        {
          previousDocs.length > 0 && (
            <details class="mt-3 text-sm">
              <summary class="cursor-pointer text-slate-600">Versiones anteriores ({previousDocs.length})</summary>
              <ul class="mt-2 space-y-1 text-xs text-slate-600">
                {previousDocs.map((d) => (
                  <li>
                    {d.document_name} · {DOCUMENT_TYPE_LABELS[d.document_type]} · cargado {fmtDateTime(d.uploaded_at)} · reemplazado {fmtDateTime(d.superseded_at)}
                    {d.file_path && (
                      <>
                        {' · '}
                        <a href={supportHref(d.file_path)} target="_blank" rel="noopener">Ver archivo</a>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          )
        }
        {
          canUpload && (
            <form method="post" class="mt-3 flex flex-wrap items-start gap-2">
              <input type="hidden" name="_action" value="add_document" />
              <div class="min-w-48 flex-1">
                <label class="label">Nombre del documento</label>
                <input class="input" name="document_name" required placeholder="Ej. Convenio firmado 2026" />
              </div>
              <div>
                <label class="label">Tipo</label>
                <select class="input" name="document_type">
                  {Object.entries(DOCUMENT_TYPE_LABELS)
                    .filter(([value]) => status !== 'aprobado' || value !== 'convenio_firmado')
                    .map(([value, label]) => <option value={value}>{label}</option>)}
                </select>
              </div>
              <div class="min-w-64 flex-1">
                <SupportFile kind="convenios" name="file_path" label="Archivo" required={requireFiles} />
              </div>
              {/* N26-08: el botón se alinea con los campos, no con el texto del límite de tamaño */}
              <div>
                <span class="label invisible" aria-hidden="true">Acción</span>
                <button class="btn" type="submit">Registrar documento</button>
              </div>
            </form>
          )
        }
      </section>
    </div>

    <section class="card space-y-4 text-sm">
      <h2>{needsApproval ? 'Aprobación' : 'Activación'}</h2>
      <ol class="space-y-2">
        <li class:list={[nitOk ? 'text-green-700' : 'text-amber-700']}>
          {nitOk ? '✓ NIT en firme' : (
            <>○ NIT provisional: confírmelo en la <a href={`/empresas/${a.company_id}`}>ficha de la empresa</a></>
          )}
        </li>
        <li class:list={[fileOk ? 'text-green-700' : 'text-slate-500']}>
          {fileOk ? '✓' : '○'} Convenio firmado con archivo PDF
        </li>
        <li class:list={[validityOk ? 'text-green-700' : 'text-slate-500']}>
          {validityOk ? '✓' : '○'} Vigencia completa y no vencida
        </li>
        {
          needsApproval && (
            <>
              <li class:list={[status !== 'borrador' ? 'text-green-700' : 'text-slate-500']}>
                {status !== 'borrador' ? '✓' : '○'} Enviado a aprobación
              </li>
              <li class:list={[a.documents_verified ? 'text-green-700' : 'text-slate-500']}>
                {a.documents_verified ? `✓ Documentación verificada · ${personName(a.documents_verified_by)}` : '○ Documentación verificada por Administración'}
              </li>
            </>
          )
        }
        <li class:list={[a.approved_at ? 'text-green-700' : 'text-slate-500']}>
          {a.approved_at
            ? `✓ Activo · ${a.activated_by_migration ? 'activado por migración' : personName(a.approved_by)} · ${fmtDateTime(a.approved_at)}`
            : needsApproval ? '○ Aprobado por Dirección' : '○ Activado'}
        </li>
        {
          a.approved_at && (
            <li class:list={[a.reviewed_at ? 'text-green-700' : 'text-amber-700']}>
              {a.reviewed_at ? `✓ Revisado por Dirección · ${personName(a.reviewed_by)} · ${fmtDateTime(a.reviewed_at)}` : '○ Pendiente de revisión de Dirección'}
            </li>
          )
        }
      </ol>

      <div class="space-y-2">
        {
          canActivate && (
            <form method="post">
              <input type="hidden" name="_action" value="activate" />
              <button class="btn btn-primary w-full" disabled={!ready}>Activar convenio</button>
              {!ready && <p class="mt-1 text-xs text-slate-500">Complete los requisitos para activarlo.</p>}
            </form>
          )
        }
        {
          needsApproval && status === 'borrador' && (isComercial || isAdmin) && (
            <form method="post"><input type="hidden" name="_action" value="send" /><button class="btn btn-primary w-full">Enviar a aprobación</button></form>
          )
        }
        {
          needsApproval && status === 'pendiente_aprobacion' && isAdmin && (
            <form method="post">
              <input type="hidden" name="_action" value={a.documents_verified ? 'unverify' : 'verify'} />
              <button class:list={['btn w-full', !a.documents_verified && 'btn-primary']}>
                {a.documents_verified ? 'Retirar verificación' : 'Verificar documentación'}
              </button>
            </form>
          )
        }
        {
          needsApproval && status === 'pendiente_aprobacion' && isDireccion && (
            <form method="post"><input type="hidden" name="_action" value="approve" /><button class="btn btn-primary w-full">Aprobar convenio</button></form>
          )
        }
        {
          status === 'pendiente_aprobacion' && (isComercial || isAdmin || isDireccion) && (
            <form method="post"><input type="hidden" name="_action" value="back_to_draft" /><button class="btn w-full">Devolver a Borrador</button></form>
          )
        }
        {
          status === 'aprobado' && !a.reviewed_at && isDireccion && (
            <form method="post">
              <input type="hidden" name="_action" value="review" />
              <button class="btn btn-primary w-full">Marcar como revisado</button>
              <p class="mt-1 text-xs text-slate-500">Revise el PDF firmado y las condiciones. Si algo no corresponde, cancélelo con el motivo.</p>
            </form>
          )
        }
        {
          status !== 'cancelado' && isDireccion && (
            <details>
              <summary class="cursor-pointer text-red-700">Cancelar convenio</summary>
              <form method="post" class="mt-2 space-y-2">
                <input type="hidden" name="_action" value="cancel" />
                <textarea class="input" name="cancel_reason" rows="2" required placeholder="Motivo" />
                <p class="text-xs text-slate-500">No admitirá nuevas jornadas ni órdenes por nómina. Las órdenes ya verificadas siguen su curso; las de nómina sin verificar quedan bloqueadas.</p>
                <button class="btn btn-danger w-full">Confirmar cancelación</button>
              </form>
            </details>
          )
        }
        {status === 'cancelado' && <p class="text-red-700">Cancelado por {personName(a.cancelled_by)}: {a.cancel_reason}</p>}
        {status === 'aprobado' && <p class="text-slate-500">Un convenio activo no cambia sus condiciones. Si cambian, registre uno nuevo.</p>}
      </div>
    </section>
  </div>
</AppLayout>
