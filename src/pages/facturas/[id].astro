---
import AppLayout from '../../layouts/AppLayout.astro';
import { hasRole } from '../../lib/auth';
import { AlegraError, alegraEnabled, syncInvoiceWithAlegra } from '../../lib/alegra';
import { cop, fmtDate, fmtDateTime, todayCo } from '../../lib/format';
import { date, ensure, FormError, parseForm, runActions, text, uuid, z } from '../../lib/forms';
import { ACCOUNTING_STATUS_BADGE, ACCOUNTING_STATUS_LABELS, RADICATION_BADGE, RADICATION_LABELS } from '../../lib/labels';
import { money, orderNumber } from '../../lib/orders';

const { supabase, userId } = Astro.locals;
const id = Astro.params.id!;
const isAdmin = hasRole(Astro.locals, 'administracion_cartera');

const outcome = await runActions(Astro, {
  update: async (form) => {
    const input = parseForm(
      z.object({
        alegra_invoice_number: text(40),
        invoice_date: date(),
        invoiced_amount: money(),
        radication_status: z.enum(['pendiente', 'radicada', 'rechazada']),
        alegra_external_id: text(40).optional(),
        notes: text(2000).optional(),
      }),
      form,
    );
    ensure(
      await supabase
        .from('alegra_invoices')
        .update({ ...input, alegra_external_id: input.alegra_external_id ?? null, notes: input.notes ?? null })
        .eq('id', id)
        .select('id')
        .single(),
    );
    return { message: 'Factura actualizada.' };
  },
  link: async (form) => {
    const input = parseForm(z.object({ order_id: uuid(), amount_assigned: money() }), form);
    ensure(await supabase.from('alegra_invoice_orders').insert({ ...input, invoice_id: id }).select('id').single());
    return { message: 'Orden vinculada.' };
  },
  update_link: async (form) => {
    const input = parseForm(z.object({ link_id: uuid(), amount_assigned: money() }), form);
    ensure(
      await supabase
        .from('alegra_invoice_orders')
        .update({ amount_assigned: input.amount_assigned })
        .eq('id', input.link_id)
        .eq('invoice_id', id)
        .select('id')
        .single(),
    );
    return { message: 'Monto actualizado.' };
  },
  unlink: async (form) => {
    const linkId = String(form.get('link_id') ?? '');
    ensure(await supabase.from('alegra_invoice_orders').delete().eq('id', linkId).eq('invoice_id', id).select('id').single());
    return { message: 'Vínculo eliminado.' };
  },
  void: async (form) => {
    const reason = String(form.get('void_reason') ?? '').trim();
    if (!reason) throw new FormError('Indique el motivo de la anulación.');
    ensure(await supabase.from('alegra_invoices').update({ is_voided: true, void_reason: reason }).eq('id', id).select('id').single());
    return { message: 'Factura anulada. Sus órdenes vuelven a quedar pendientes de factura.' };
  },
  sync_alegra: async () => {
    if (!isAdmin) throw new FormError('Solo Administración / Cartera consulta Alegra.');
    try {
      const result = await syncInvoiceWithAlegra(supabase, id, userId!);
      return { message: result.message };
    } catch (e) {
      if (e instanceof AlegraError) throw new FormError(e.message);
      throw e;
    }
  },
});
if (outcome?.kind === 'redirect') return outcome.response;
const error = outcome?.kind === 'error' ? outcome.error : null;
const v = outcome?.kind === 'error' ? outcome.values : {};
const lastAction = outcome?.kind === 'error' ? outcome.action : '';

const { data: inv } = await supabase.from('v_invoices').select('*').eq('id', id).maybeSingle();
if (!inv) return new Response('Factura no encontrada', { status: 404 });

let candidatesQuery = supabase.from('v_orders_to_invoice').select('id, order_number, buyer_name, buyer_document_id, total_amount, pending_amount').order('order_number');
candidatesQuery = inv.company_id ? candidatesQuery.eq('company_id', inv.company_id) : candidatesQuery.eq('buyer_id', inv.buyer_id!);

const [links, candidates, events] = await Promise.all([
  supabase.from('v_invoice_orders').select('*').eq('invoice_id', id).order('order_number'),
  candidatesQuery,
  supabase.from('alegra_sync_events').select('*').eq('invoice_id', id).order('created_at', { ascending: false }).limit(5),
]);
const linkRows = links.data ?? [];
const linkedIds = new Set(linkRows.map((l) => l.order_id));
const candidateRows = (candidates.data ?? []).filter((c) => !linkedIds.has(c.id) && Number(c.pending_amount) > 0);
const editable = isAdmin && !inv.is_voided;
const integrationOn = alegraEnabled();
---

<AppLayout title={`Factura ${inv.alegra_invoice_number}`} error={error}>
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div>
      <a href="/facturas" class="text-sm">← Facturación</a>
      <h1>Factura {inv.alegra_invoice_number}</h1>
      <p class="text-sm text-slate-600">
        {inv.company_id ? <a href={`/empresas/${inv.company_id}`}>{inv.subject_name}</a> : inv.subject_name}
        {inv.company_id ? ` · NIT ${inv.company_nit}` : ` · C.C. ${inv.buyer_document_id}`} · {fmtDate(inv.invoice_date)}
      </p>
      <p class="text-xs text-slate-500">Registrada por {inv.registered_by_name ?? '—'} el {fmtDateTime(inv.created_at)}</p>
    </div>
    <div class="text-right">
      <div class="text-2xl font-semibold">{cop(inv.invoiced_amount)}</div>
      <div class="text-sm text-slate-600">Asignado {cop(inv.assigned_amount)} · sin asignar {cop(inv.unassigned_amount)}</div>
      {inv.is_voided ? <span class="badge badge-red">Anulada</span> : <span class={RADICATION_BADGE[inv.radication_status!]}>{RADICATION_LABELS[inv.radication_status!]}</span>}
    </div>
  </div>

  {inv.is_voided && <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">Factura anulada el {fmtDateTime(inv.voided_at)}: {inv.void_reason}</div>}
  {Number(inv.orders_with_difference) > 0 && !inv.is_voided && (
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      Diferencia Visible: {inv.orders_with_difference} orden(es) tienen un monto facturado distinto de su valor.
    </div>
  )}

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <section class="card">
        <h2 class="mb-3">Órdenes vinculadas</h2>
        <div class="overflow-x-auto">
          <table class="table">
            <thead><tr><th>Orden</th><th>Comprador</th><th class="text-right">Valor orden</th><th class="text-right">En esta factura</th><th class="text-right">Diferencia</th><th>Estado contable</th><th></th></tr></thead>
            <tbody>
              {linkRows.map((l) => (
                <tr>
                  <td><a href={`/ordenes/${l.order_id}`}>{orderNumber(l.order_number)}</a></td>
                  <td>{l.buyer_name}<div class="text-xs text-slate-500">{l.buyer_document_id}</div></td>
                  <td class="text-right whitespace-nowrap">{cop(l.order_total)}</td>
                  <td class="text-right whitespace-nowrap">
                    {editable ? (
                      <form method="post" class="flex items-center justify-end gap-1">
                        <input type="hidden" name="_action" value="update_link" />
                        <input type="hidden" name="link_id" value={l.id} />
                        <input class="input w-28 text-right" type="number" name="amount_assigned" min="1" step="1" value={l.amount_assigned} />
                        <button class="btn btn-sm" type="submit">✓</button>
                      </form>
                    ) : cop(l.amount_assigned)}
                  </td>
                  <td class:list={['text-right whitespace-nowrap', Number(l.discrepancy_amount) !== 0 && 'font-medium text-red-700']}>{cop(l.discrepancy_amount)}</td>
                  <td><span class={ACCOUNTING_STATUS_BADGE[l.accounting_status!]}>{ACCOUNTING_STATUS_LABELS[l.accounting_status!]}</span></td>
                  <td>
                    {editable && (
                      <form method="post">
                        <input type="hidden" name="_action" value="unlink" />
                        <input type="hidden" name="link_id" value={l.id} />
                        <button class="btn btn-sm btn-danger" type="submit">Quitar</button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
              {!linkRows.length && <tr><td colspan="7" class="text-slate-500">Sin órdenes vinculadas.</td></tr>}
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-xs text-slate-500">La diferencia se calcula contra el valor de la orden. Si una orden se factura en varias facturas, su estado contable considera la suma de todas.</p>

        {
          editable && (
            candidateRows.length > 0 ? (
              <form method="post" class="mt-4 flex flex-wrap items-end gap-2 border-t border-slate-100 pt-3">
                <input type="hidden" name="_action" value="link" />
                <div class="min-w-64 flex-1">
                  <label class="label">Orden por facturar del mismo cliente</label>
                  <select class="input" name="order_id" required>
                    {candidateRows.map((c) => (
                      <option value={c.id} selected={v.order_id === c.id}>
                        {orderNumber(c.order_number)} · {c.buyer_name} · pendiente {cop(c.pending_amount)}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label class="label">Monto</label>
                  <input class="input w-36" type="number" name="amount_assigned" min="1" step="1" required value={v.amount_assigned ?? candidateRows[0]?.pending_amount ?? ''} />
                </div>
                <button class="btn btn-primary" type="submit">Vincular</button>
              </form>
            ) : (
              <p class="mt-3 text-sm text-slate-500">No hay más órdenes verificadas pendientes de factura para este cliente.</p>
            )
          )
        }
      </section>
    </div>

    <div class="space-y-4">
      <section class="card space-y-2 text-sm">
        <h2>Alegra</h2>
        {
          !integrationOn && (
            <p class="rounded-md bg-slate-50 px-3 py-2 text-xs text-slate-600">
              Integración desactivada: falta configurar las credenciales de la API de Alegra. Mientras tanto, los datos de la factura se registran a mano.
            </p>
          )
        }
        <dl class="grid grid-cols-2 gap-2">
          <div><dt class="label">ID en Alegra</dt><dd>{inv.alegra_external_id ?? '—'}</dd></div>
          <div><dt class="label">Última consulta</dt><dd>{fmtDateTime(inv.alegra_synced_at)}</dd></div>
          <div><dt class="label">Estado en Alegra</dt><dd>{inv.alegra_status ?? '—'}</dd></div>
          <div><dt class="label">Total en Alegra</dt><dd class:list={[inv.alegra_discrepancy && 'font-medium text-red-700']}>{cop(inv.alegra_total)}</dd></div>
        </dl>
        {inv.alegra_discrepancy && <p class="text-red-700">El total en Alegra no coincide con el registrado.</p>}
        {inv.alegra_sync_error && <p class="text-amber-700">Último error: {inv.alegra_sync_error}</p>}
        {
          isAdmin && !inv.is_voided && (
            <form method="post">
              <input type="hidden" name="_action" value="sync_alegra" />
              <button class="btn w-full" type="submit" disabled={!integrationOn || !inv.alegra_external_id}>Consultar en Alegra</button>
            </form>
          )
        }
        {
          (events.data ?? []).length > 0 && (
            <ul class="space-y-1 border-t border-slate-100 pt-2 text-xs text-slate-600">
              {events.data!.map((e) => <li>{fmtDateTime(e.created_at)} · {e.ok ? '✓' : '✗'} {e.message}</li>)}
            </ul>
          )
        }
      </section>

      {
        editable && (
          <section class="card text-sm">
            <details open={lastAction === 'update'}>
              <summary class="cursor-pointer font-medium text-brand-700">Editar factura</summary>
              <form method="post" class="mt-2 space-y-2">
                <input type="hidden" name="_action" value="update" />
                <label class="label">Número</label>
                <input class="input" name="alegra_invoice_number" required value={v.alegra_invoice_number ?? inv.alegra_invoice_number} />
                <label class="label">Fecha</label>
                <input class="input" type="date" name="invoice_date" required max={todayCo()} value={v.invoice_date ?? inv.invoice_date} />
                <label class="label">Monto facturado</label>
                <input class="input" type="number" name="invoiced_amount" min="1" step="1" required value={v.invoiced_amount ?? inv.invoiced_amount} />
                <label class="label">Radicación</label>
                <select class="input" name="radication_status">
                  {Object.entries(RADICATION_LABELS).map(([value, label]) => <option value={value} selected={(v.radication_status ?? inv.radication_status) === value}>{label}</option>)}
                </select>
                <label class="label">ID en Alegra</label>
                <input class="input" name="alegra_external_id" value={v.alegra_external_id ?? inv.alegra_external_id ?? ''} />
                <label class="label">Notas</label>
                <textarea class="input" name="notes" rows="2">{v.notes ?? inv.notes ?? ''}</textarea>
                <button class="btn w-full" type="submit">Guardar</button>
              </form>
            </details>
          </section>
        )
      }

      {
        editable && (
          <section class="card text-sm">
            <details open={lastAction === 'void'}>
              <summary class="cursor-pointer text-red-700">Anular factura</summary>
              <p class="mt-2 text-xs text-slate-500">Use esta opción si la factura se anuló en Alegra o se registró por error. Sus órdenes vuelven a quedar pendientes de factura.</p>
              <form method="post" class="mt-2 space-y-2">
                <input type="hidden" name="_action" value="void" />
                <textarea class="input" name="void_reason" rows="2" required placeholder="Motivo"></textarea>
                <button class="btn btn-danger w-full" type="submit">Confirmar anulación</button>
              </form>
            </details>
          </section>
        )
      }
      {inv.notes && <section class="card text-sm"><h2 class="mb-1">Notas</h2><p class="whitespace-pre-line">{inv.notes}</p></section>}
    </div>
  </div>
</AppLayout>
