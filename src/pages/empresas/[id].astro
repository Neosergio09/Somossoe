---
import AppLayout from '../../layouts/AppLayout.astro';
import { hasRole } from '../../lib/auth';
import { cop, fmtDate, fmtDateTime } from '../../lib/format';
import { checkbox, ensure, int, nullify, parseForm, runActions, text, uuid, z } from '../../lib/forms';
import {
  AGREEMENT_STATUS_BADGE,
  AGREEMENT_STATUS_LABELS,
  AREA_LABELS,
  CAMPAIGN_STATUS_BADGE,
  CAMPAIGN_STATUS_LABELS,
  PAYROLL_LABELS,
  STAGE_LABELS,
} from '../../lib/labels';
import { activeUsers, allActiveCities } from '../../lib/options';

const { supabase } = Astro.locals;
const id = Astro.params.id!;

const branchSchema = z.object({
  name: text(120),
  city_id: uuid().optional(),
  city_other: text(80).optional(),
  address: text(200).optional(),
  is_main: checkbox(),
});
const contactSchema = z.object({
  full_name: text(150),
  role_title: text(120),
  area: z.enum(['rrhh', 'sst', 'gerencia', 'compras', 'otra']),
  branch_id: uuid().optional(),
  is_coordinator: checkbox(),
  is_decision_maker: checkbox(),
  phone_whatsapp: text(25).optional(),
  email: z.email({ error: 'Correo inválido' }).optional(),
});

async function setMainBranch(branchId: string) {
  ensure(
    await supabase
      .from('company_branches')
      .update({ is_main: false })
      .eq('company_id', id)
      .eq('is_main', true)
      .neq('id', branchId),
  );
}

const outcome = await runActions(Astro, {
  update_company: async (form) => {
    const input = parseForm(
      z.object({
        name: text(200),
        sector: text(120),
        total_employees: int().positive().optional(),
        payroll_frequency: z.enum(['mensual', 'quincenal']).optional(),
        website: text(200).optional(),
        assigned_user_id: uuid().optional(),
        nit: z.string().regex(/^\d{5,10}$/, { error: 'solo dígitos, sin puntos ni DV' }).optional(),
        nit_dv: z.coerce.number().int().min(0).max(9).optional(),
      }),
      form,
    );
    ensure(await supabase.from('companies').update(nullify(input)).eq('id', id).select('id').single());
    return { message: 'Empresa actualizada.' };
  },
  confirm_nit: async (form) => {
    const input = parseForm(
      z.object({
        nit: z.string().regex(/^\d{5,10}$/, { error: 'solo dígitos, sin puntos ni DV' }),
        nit_dv: z.coerce.number().int().min(0).max(9),
      }),
      form,
    );
    ensure(
      await supabase
        .from('companies')
        .update({ ...input, is_nit_provisional: false })
        .eq('id', id)
        .select('id')
        .single(),
    );
    return { message: 'NIT confirmado en firme.' };
  },
  reopen_nit: async () => {
    ensure(await supabase.from('companies').update({ is_nit_provisional: true }).eq('id', id).select('id').single());
    return { message: 'El NIT volvió a estado provisional.' };
  },
  add_branch: async (form) => {
    const input = parseForm(branchSchema, form);
    if (input.is_main) await setMainBranch('00000000-0000-0000-0000-000000000000');
    ensure(
      await supabase.from('company_branches').insert({
        company_id: id,
        name: input.name,
        city_id: input.city_other ? null : (input.city_id ?? null),
        city_other: input.city_other ?? null,
        address: input.address ?? null,
        is_main: input.is_main,
      }),
    );
    return { message: 'Sede agregada.' };
  },
  update_branch: async (form) => {
    const branchId = String(form.get('branch_id') ?? '');
    const input = parseForm(branchSchema, form);
    if (input.is_main) await setMainBranch(branchId);
    ensure(
      await supabase
        .from('company_branches')
        .update({
          name: input.name,
          city_id: input.city_other ? null : (input.city_id ?? null),
          city_other: input.city_other ?? null,
          address: input.address ?? null,
          is_main: input.is_main,
        })
        .eq('id', branchId)
        .eq('company_id', id)
        .select('id')
        .single(),
    );
    return { message: 'Sede actualizada.' };
  },
  add_contact: async (form) => {
    const input = parseForm(contactSchema, form);
    ensure(await supabase.from('contacts').insert({ ...nullify(input), company_id: id }));
    return { message: 'Contacto agregado.' };
  },
  update_contact: async (form) => {
    const contactId = String(form.get('contact_id') ?? '');
    const input = parseForm(contactSchema, form);
    ensure(
      await supabase.from('contacts').update(nullify(input)).eq('id', contactId).eq('company_id', id).select('id').single(),
    );
    return { message: 'Contacto actualizado.' };
  },
  toggle_contact: async (form) => {
    const contactId = String(form.get('contact_id') ?? '');
    const active = form.get('active') === 'true';
    ensure(await supabase.from('contacts').update({ active }).eq('id', contactId).eq('company_id', id).select('id').single());
    return { message: active ? 'Contacto reactivado.' : 'Contacto marcado como inactivo.' };
  },
});
if (outcome?.kind === 'redirect') return outcome.response;
const error = outcome?.kind === 'error' ? outcome.error : null;

const { data: company } = await supabase
  .from('companies')
  .select('*, assigned:users_profiles!companies_assigned_user_id_fkey(full_name), verifier:users_profiles!companies_nit_verified_by_fkey(full_name)')
  .eq('id', id)
  .maybeSingle();
if (!company) return new Response('Empresa no encontrada', { status: 404 });

const [branches, contacts, deals, agreements, campaigns, users, cities] = await Promise.all([
  supabase.from('company_branches').select('*, cities(name)').eq('company_id', id).order('is_main', { ascending: false }).order('name'),
  supabase.from('contacts').select('*, company_branches(name)').eq('company_id', id).order('active', { ascending: false }).order('full_name'),
  supabase.from('v_deals_board').select('id, deal_name_branch, city_name, stage, estimated_billing_amount, assigned_user_name, days_inactive').eq('company_id', id).order('created_at', { ascending: false }),
  supabase.from('v_agreements').select('id, deal_name_branch, effective_status, max_installments, payroll_frequency, valid_until').eq('company_id', id).order('created_at', { ascending: false }),
  supabase.from('v_campaigns').select('id, deal_name_branch, city_name, status, first_session_date, attended_headcount').eq('company_id', id).order('created_at', { ascending: false }),
  activeUsers(supabase, ['comercial', 'direccion']),
  allActiveCities(supabase),
]);

const canEdit = hasRole(Astro.locals, 'comercial', 'administracion_cartera');
const canCreate = hasRole(Astro.locals, 'comercial');
const isAdmin = hasRole(Astro.locals, 'administracion_cartera');
const nitDisplay = company.nit ? `${company.nit}${company.nit_dv != null ? `-${company.nit_dv}` : ''}` : 'Sin NIT';
---

<AppLayout title={company.name} error={error}>
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div>
      <a href="/empresas" class="text-sm">← Empresas</a>
      <h1>{company.name}</h1>
      <p class="text-sm text-slate-600">
        NIT {nitDisplay}
        {
          company.is_nit_provisional ? (
            <span class="badge badge-amber ml-1">Provisional</span>
          ) : (
            <span class="badge badge-green ml-1">
              En firme{company.verifier?.full_name ? ` · ${company.verifier.full_name}` : ''}
            </span>
          )
        }
        · {company.sector}
      </p>
    </div>
    {
      canCreate && (
        <a class="btn btn-primary" href={`/oportunidades/nueva?company_id=${company.id}`}>
          Nueva oportunidad
        </a>
      )
    }
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    <section class="card lg:col-span-2">
      <h2 class="mb-3">Ficha de la empresa</h2>
      <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-3">
        <div><dt class="label">Total de empleados</dt><dd>{company.total_employees ?? '—'}</dd></div>
        <div><dt class="label">Pago de nómina</dt><dd>{company.payroll_frequency ? PAYROLL_LABELS[company.payroll_frequency] : '—'}</dd></div>
        <div><dt class="label">Ejecutivo</dt><dd>{company.assigned?.full_name ?? '—'}</dd></div>
        <div><dt class="label">Sitio web</dt><dd>{company.website ?? '—'}</dd></div>
        <div><dt class="label">Creada</dt><dd>{fmtDateTime(company.created_at)}</dd></div>
      </dl>

      {
        canEdit && (
          <details class="mt-4">
            <summary class="cursor-pointer text-sm font-medium text-brand-700">Editar ficha</summary>
            <form method="post" class="mt-3 grid-form">
              <input type="hidden" name="_action" value="update_company" />
              <div class="sm:col-span-2">
                <label class="label">Razón social</label>
                <input class="input" name="name" required value={company.name} />
              </div>
              <div>
                <label class="label">Sector</label>
                <input class="input" name="sector" required value={company.sector} />
              </div>
              <div>
                <label class="label">Total de empleados</label>
                <input class="input" name="total_employees" type="number" min="1" value={company.total_employees ?? ''} />
              </div>
              <div>
                <label class="label">Pago de nómina</label>
                <select class="input" name="payroll_frequency">
                  <option value="">Sin definir</option>
                  {Object.entries(PAYROLL_LABELS).map(([value, label]) => (
                    <option value={value} selected={company.payroll_frequency === value}>{label}</option>
                  ))}
                </select>
              </div>
              <div>
                <label class="label">Ejecutivo asignado</label>
                <select class="input" name="assigned_user_id">
                  <option value="">—</option>
                  {users.map((u) => (
                    <option value={u.id} selected={company.assigned_user_id === u.id}>{u.full_name}</option>
                  ))}
                </select>
              </div>
              <div>
                <label class="label">Sitio web</label>
                <input class="input" name="website" value={company.website ?? ''} />
              </div>
              {company.is_nit_provisional && (
                <>
                  <div>
                    <label class="label">NIT (sin DV)</label>
                    <input class="input" name="nit" inputmode="numeric" value={company.nit ?? ''} />
                  </div>
                  <div>
                    <label class="label">DV</label>
                    <input class="input" name="nit_dv" inputmode="numeric" maxlength="1" value={company.nit_dv ?? ''} />
                  </div>
                </>
              )}
              {!company.is_nit_provisional && (
                <>
                  <input type="hidden" name="nit" value={company.nit ?? ''} />
                  <input type="hidden" name="nit_dv" value={company.nit_dv ?? ''} />
                </>
              )}
              <div class="sm:col-span-2">
                <button class="btn btn-primary" type="submit">Guardar</button>
              </div>
            </form>
          </details>
        )
      }

      {
        isAdmin && (
          <div class="mt-4 border-t border-slate-200 pt-4">
            {company.is_nit_provisional ? (
              <form method="post" class="flex flex-wrap items-end gap-2">
                <input type="hidden" name="_action" value="confirm_nit" />
                <div>
                  <label class="label">NIT verificado</label>
                  <input class="input" name="nit" inputmode="numeric" required value={company.nit ?? ''} />
                </div>
                <div class="w-20">
                  <label class="label">DV</label>
                  <input class="input" name="nit_dv" inputmode="numeric" maxlength="1" required value={company.nit_dv ?? ''} />
                </div>
                <button class="btn btn-primary" type="submit">Confirmar NIT en firme</button>
              </form>
            ) : (
              <form method="post">
                <input type="hidden" name="_action" value="reopen_nit" />
                <button class="btn btn-sm" type="submit">Volver el NIT a provisional</button>
              </form>
            )}
          </div>
        )
      }
    </section>

    <section class="card">
      <h2 class="mb-3">Sedes</h2>
      <ul class="space-y-3 text-sm">
        {
          branches.data?.map((b) => (
            <li class="rounded-md border border-slate-100 p-2">
              <div class="font-medium">
                {b.name} {b.is_main && <span class="badge badge-blue">Principal</span>}
              </div>
              <div class="text-slate-500">
                {b.cities?.name ?? b.city_other ?? '—'}
                {b.address && ` · ${b.address}`}
              </div>
              {canEdit && (
                <details class="mt-1">
                  <summary class="cursor-pointer text-xs text-brand-700">Editar</summary>
                  <form method="post" class="mt-2 space-y-2">
                    <input type="hidden" name="_action" value="update_branch" />
                    <input type="hidden" name="branch_id" value={b.id} />
                    <input class="input" name="name" required value={b.name} />
                    <select class="input" name="city_id">
                      <option value="">—</option>
                      {cities.map((c) => <option value={c.id} selected={b.city_id === c.id}>{c.name}</option>)}
                    </select>
                    <input class="input" name="city_other" placeholder="Otra ciudad" value={b.city_other ?? ''} />
                    <input class="input" name="address" placeholder="Dirección" value={b.address ?? ''} />
                    <label class="flex items-center gap-2 text-xs">
                      <input type="checkbox" name="is_main" checked={b.is_main} /> Sede principal
                    </label>
                    <button class="btn btn-sm btn-primary" type="submit">Guardar</button>
                  </form>
                </details>
              )}
            </li>
          ))
        }
        {!branches.data?.length && <li class="text-slate-500">Sin sedes registradas.</li>}
      </ul>
      {
        canCreate && (
          <details class="mt-3">
            <summary class="cursor-pointer text-sm font-medium text-brand-700">Agregar sede</summary>
            <form method="post" class="mt-2 space-y-2">
              <input type="hidden" name="_action" value="add_branch" />
              <input class="input" name="name" required placeholder="Nombre de la sede" />
              <select class="input" name="city_id">
                <option value="">Ciudad…</option>
                {cities.map((c) => <option value={c.id}>{c.name}</option>)}
              </select>
              <input class="input" name="city_other" placeholder="Otra ciudad (si no está en la lista)" />
              <input class="input" name="address" placeholder="Dirección" />
              <label class="flex items-center gap-2 text-xs">
                <input type="checkbox" name="is_main" /> Sede principal
              </label>
              <button class="btn btn-sm btn-primary" type="submit">Agregar</button>
            </form>
          </details>
        )
      }
    </section>

    <section class="card lg:col-span-3">
      <h2 class="mb-3">Contactos</h2>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Cargo / Área</th>
              <th>Rol en la decisión</th>
              <th>Teléfono</th>
              <th>Correo</th>
              <th>Sede</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {
              contacts.data?.map((c) => (
                <tr class:list={[!c.active && 'text-slate-400']}>
                  <td>
                    {c.full_name} {!c.active && <span class="badge">Inactivo</span>}
                  </td>
                  <td>
                    {c.role_title} · {AREA_LABELS[c.area]}
                  </td>
                  <td>
                    {c.is_coordinator && <span class="badge badge-blue mr-1">Coordina</span>}
                    {c.is_decision_maker && <span class="badge badge-green">Decide</span>}
                  </td>
                  <td>{c.phone_whatsapp ?? '—'}</td>
                  <td>{c.email ?? '—'}</td>
                  <td>{c.company_branches?.name ?? '—'}</td>
                  <td class="whitespace-nowrap">
                    {canEdit && (
                      <>
                        <details class="inline-block">
                          <summary class="cursor-pointer text-xs text-brand-700">Editar</summary>
                          <form method="post" class="mt-2 w-72 space-y-2">
                            <input type="hidden" name="_action" value="update_contact" />
                            <input type="hidden" name="contact_id" value={c.id} />
                            <input class="input" name="full_name" required value={c.full_name} />
                            <input class="input" name="role_title" required value={c.role_title} />
                            <select class="input" name="area">
                              {Object.entries(AREA_LABELS).map(([value, label]) => (
                                <option value={value} selected={c.area === value}>{label}</option>
                              ))}
                            </select>
                            <select class="input" name="branch_id">
                              <option value="">Sin sede</option>
                              {branches.data?.map((b) => <option value={b.id} selected={c.branch_id === b.id}>{b.name}</option>)}
                            </select>
                            <input class="input" name="phone_whatsapp" placeholder="Teléfono / WhatsApp" value={c.phone_whatsapp ?? ''} />
                            <input class="input" name="email" type="email" placeholder="Correo" value={c.email ?? ''} />
                            <label class="flex items-center gap-2 text-xs">
                              <input type="checkbox" name="is_coordinator" checked={c.is_coordinator} /> Coordina
                            </label>
                            <label class="flex items-center gap-2 text-xs">
                              <input type="checkbox" name="is_decision_maker" checked={c.is_decision_maker} /> Decide
                            </label>
                            <button class="btn btn-sm btn-primary" type="submit">Guardar</button>
                          </form>
                        </details>
                        <form method="post" class="ml-2 inline">
                          <input type="hidden" name="_action" value="toggle_contact" />
                          <input type="hidden" name="contact_id" value={c.id} />
                          <input type="hidden" name="active" value={c.active ? 'false' : 'true'} />
                          <button class="btn btn-sm" type="submit">{c.active ? 'Desactivar' : 'Reactivar'}</button>
                        </form>
                      </>
                    )}
                  </td>
                </tr>
              ))
            }
            {!contacts.data?.length && <tr><td colspan="7" class="text-slate-500">Sin contactos.</td></tr>}
          </tbody>
        </table>
      </div>
      {
        canCreate && (
          <details class="mt-3">
            <summary class="cursor-pointer text-sm font-medium text-brand-700">Agregar contacto</summary>
            <form method="post" class="mt-3 grid-form">
              <input type="hidden" name="_action" value="add_contact" />
              <div><label class="label">Nombre completo *</label><input class="input" name="full_name" required /></div>
              <div><label class="label">Cargo *</label><input class="input" name="role_title" required /></div>
              <div>
                <label class="label">Área *</label>
                <select class="input" name="area" required>
                  {Object.entries(AREA_LABELS).map(([value, label]) => <option value={value}>{label}</option>)}
                </select>
              </div>
              <div>
                <label class="label">Sede</label>
                <select class="input" name="branch_id">
                  <option value="">Sin sede</option>
                  {branches.data?.map((b) => <option value={b.id}>{b.name}</option>)}
                </select>
              </div>
              <div><label class="label">Teléfono / WhatsApp</label><input class="input" name="phone_whatsapp" /></div>
              <div><label class="label">Correo</label><input class="input" name="email" type="email" /></div>
              <div class="flex items-center gap-4 text-sm sm:col-span-2">
                <label class="flex items-center gap-2"><input type="checkbox" name="is_coordinator" /> Coordina</label>
                <label class="flex items-center gap-2"><input type="checkbox" name="is_decision_maker" /> Decide</label>
              </div>
              <div class="sm:col-span-2"><button class="btn btn-primary" type="submit">Agregar contacto</button></div>
            </form>
          </details>
        )
      }
    </section>

    <section class="card lg:col-span-3">
      <h2 class="mb-3">Oportunidades</h2>
      <table class="table">
        <thead><tr><th>Negocio</th><th>Ciudad</th><th>Etapa</th><th>Facturación estimada</th><th>Ejecutivo</th><th>Inactividad</th></tr></thead>
        <tbody>
          {deals.data?.map((d) => (
            <tr>
              <td><a href={`/oportunidades/${d.id}`}>{d.deal_name_branch}</a></td>
              <td>{d.city_name}</td>
              <td>{d.stage ? STAGE_LABELS[d.stage] : ''}</td>
              <td>{cop(d.estimated_billing_amount)}</td>
              <td>{d.assigned_user_name}</td>
              <td>{d.days_inactive} días</td>
            </tr>
          ))}
          {!deals.data?.length && <tr><td colspan="6" class="text-slate-500">Sin oportunidades.</td></tr>}
        </tbody>
      </table>
    </section>

    <section class="card lg:col-span-2">
      <div class="mb-3 flex items-center justify-between">
        <h2>Convenios</h2>
        {canCreate && <a class="btn btn-sm" href={`/convenios/nuevo?company_id=${company.id}`}>Nuevo convenio</a>}
      </div>
      <table class="table">
        <thead><tr><th>Alcance</th><th>Estado</th><th>Cuotas</th><th>Vigencia</th></tr></thead>
        <tbody>
          {agreements.data?.map((a) => (
            <tr>
              <td><a href={`/convenios/${a.id}`}>{a.deal_name_branch ?? 'Marco (todas las sedes)'}</a></td>
              <td><span class={AGREEMENT_STATUS_BADGE[a.effective_status ?? 'borrador']}>{AGREEMENT_STATUS_LABELS[a.effective_status ?? 'borrador']}</span></td>
              <td>{a.max_installments} {a.payroll_frequency ? PAYROLL_LABELS[a.payroll_frequency].toLowerCase() : ''}</td>
              <td>{fmtDate(a.valid_until)}</td>
            </tr>
          ))}
          {!agreements.data?.length && <tr><td colspan="4" class="text-slate-500">Sin convenios.</td></tr>}
        </tbody>
      </table>
    </section>

    <section class="card">
      <h2 class="mb-3">Jornadas</h2>
      <ul class="space-y-2 text-sm">
        {campaigns.data?.map((j) => (
          <li class="flex items-center justify-between gap-2">
            <a href={`/jornadas/${j.id}`}>{j.deal_name_branch} · {fmtDate(j.first_session_date)}</a>
            <span class={j.status ? CAMPAIGN_STATUS_BADGE[j.status] : 'badge'}>{j.status ? CAMPAIGN_STATUS_LABELS[j.status] : ''}</span>
          </li>
        ))}
        {!campaigns.data?.length && <li class="text-slate-500">Sin jornadas.</li>}
      </ul>
    </section>
  </div>
</AppLayout>
