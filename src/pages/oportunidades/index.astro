---
import AppLayout from '../../layouts/AppLayout.astro';
import { hasRole } from '../../lib/auth';
import { cop, fmtDate } from '../../lib/format';
import { KANBAN_STAGES, LOST_LABELS, MANUAL_STAGES, STAGE_LABELS } from '../../lib/labels';
import { activeUsers, operationalCities } from '../../lib/options';

const { supabase, userId } = Astro.locals;
const params = Astro.url.searchParams;
const cityId = params.get('ciudad') ?? '';
const owner = params.get('ejecutivo') ?? '';
const showLost = params.get('perdidas') === '1';

let query = supabase.from('v_deals_board').select('*').order('estimated_close_date', { nullsFirst: false });
if (cityId) query = query.eq('city_id', cityId);
if (owner === 'mias') query = query.eq('assigned_user_id', userId!);
else if (owner) query = query.eq('assigned_user_id', owner);

const [{ data: deals }, cities, users] = await Promise.all([
  query,
  operationalCities(supabase),
  activeUsers(supabase, ['comercial', 'direccion']),
]);

const canMove = hasRole(Astro.locals, 'comercial', 'direccion');
const AUTOMATIC = new Set(['jornada_en_ejecucion', 'facturacion_cerrada']);

const columns = [...KANBAN_STAGES, ...(showLost ? (['cierre_perdido'] as const) : [])].map((stage) => {
  const items = (deals ?? []).filter((d) => d.stage === stage);
  const total = items.reduce((sum, d) => sum + (d.estimated_billing_amount ?? 0), 0);
  return { stage, items, total, droppable: canMove && MANUAL_STAGES.includes(stage) };
});
const isDireccion = hasRole(Astro.locals, 'direccion');
// Comercial solo mueve sus oportunidades; Dirección mueve todas
const isDraggable = (d: { stage: string | null; lost_substatus: string | null; assigned_user_id: string | null }) =>
  canMove &&
  (isDireccion || d.assigned_user_id === userId) &&
  !AUTOMATIC.has(d.stage ?? '') &&
  !(d.stage === 'cierre_perdido' && d.lost_substatus === 'no_contactar');

const filterUrl = (patch: Record<string, string>) => {
  const p = new URLSearchParams(params);
  for (const [k, v] of Object.entries(patch)) v ? p.set(k, v) : p.delete(k);
  const s = p.toString();
  return s ? `?${s}` : '?';
};
---

<AppLayout title="Oportunidades">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1>Oportunidades</h1>
      {
        canMove && (
          <p class="text-xs text-slate-500">
            Arrastre las tarjetas para cambiar de etapa (en el celular, mantenga presionada la tarjeta). Jornada en Ejecución y
            Facturación Cerrada avanzan solas.
          </p>
        )
      }
    </div>
    {hasRole(Astro.locals, 'comercial') && <a class="btn btn-primary" href="/oportunidades/nueva">Nueva oportunidad</a>}
  </div>

  <form method="get" class="mb-4 flex flex-wrap items-end gap-2">
    <div>
      <label class="label" for="ciudad">Ciudad</label>
      <select class="input" id="ciudad" name="ciudad">
        <option value="">Todas</option>
        {cities.map((c) => <option value={c.id} selected={cityId === c.id}>{c.name}</option>)}
      </select>
    </div>
    <div>
      <label class="label" for="ejecutivo">Ejecutivo</label>
      <select class="input" id="ejecutivo" name="ejecutivo">
        <option value="">Todos</option>
        <option value="mias" selected={owner === 'mias'}>Mis oportunidades</option>
        {users.map((u) => <option value={u.id} selected={owner === u.id}>{u.full_name}</option>)}
      </select>
    </div>
    <label class="flex items-center gap-2 pb-2 text-sm">
      <input type="checkbox" name="perdidas" value="1" checked={showLost} /> Ver cierres perdidos
    </label>
    <button class="btn" type="submit">Filtrar</button>
    {(cityId || owner || showLost) && <a class="btn" href={filterUrl({ ciudad: '', ejecutivo: '', perdidas: '' })}>Limpiar</a>}
  </form>

  <div id="kanban-error" role="alert" hidden class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"></div>

  <div class="flex gap-3 overflow-x-auto pb-4" data-kanban>
    {
      columns.map((col) => (
        <section
          class="flex w-72 shrink-0 flex-col rounded-lg bg-slate-100 p-2 transition"
          data-column
          data-stage={col.stage}
          data-droppable={col.droppable ? 'true' : 'false'}
        >
          <header class="mb-2 px-1">
            <h2 class="text-sm">
              {STAGE_LABELS[col.stage]}
              {!MANUAL_STAGES.includes(col.stage) && <span class="ml-1 text-xs font-normal text-slate-400">(automática)</span>}
            </h2>
            <p class="text-xs text-slate-500">
              {col.items.length} · {cop(col.total)}
            </p>
          </header>
          <div class="min-h-24 flex-1 space-y-2" data-list>
            {col.items.map((d) => (
              <a
                href={`/oportunidades/${d.id}`}
                class:list={[
                  'card block p-3 text-sm text-slate-800 hover:border-brand-600 hover:no-underline',
                  isDraggable(d) && 'cursor-grab touch-manipulation select-none [-webkit-touch-callout:none]',
                ]}
                draggable="false"
                data-can-drag={isDraggable(d) ? 'true' : 'false'}
                data-deal-id={d.id}
                data-stage={d.stage}
              >
                <div class="font-medium">{d.deal_name_branch}</div>
                <div class="text-xs text-slate-500">
                  {d.company_name} · {d.city_name}
                </div>
                <div class="mt-1 font-semibold text-brand-800">{cop(d.estimated_billing_amount)}</div>
                <div class="mt-1 flex flex-wrap gap-1">
                  {d.is_new_business ? <span class="badge badge-blue">Nuevo negocio</span> : <span class="badge">Recurrente</span>}
                  {d.inactivity_alert && <span class="badge badge-amber">{d.days_inactive} días sin interacción</span>}
                  {d.next_action_overdue && <span class="badge badge-red">Acción vencida</span>}
                  {d.lost_substatus && <span class="badge badge-red">{LOST_LABELS[d.lost_substatus]}</span>}
                </div>
                <div class="mt-2 text-xs text-slate-500">
                  {d.assigned_user_name} · cierre {fmtDate(d.estimated_close_date)}
                </div>
                {d.next_action && <div class="mt-1 text-xs text-slate-600">→ {d.next_action} ({fmtDate(d.next_action_due_date)})</div>}
              </a>
            ))}
            {!col.items.length && <p class="px-1 text-xs text-slate-400" data-empty>Sin oportunidades</p>}
          </div>
        </section>
      ))
    }
  </div>

  {
    canMove && !showLost && (
      <div
        hidden
        data-column
        data-stage="cierre_perdido"
        data-droppable="true"
        data-lost-zone
        class="fixed inset-x-4 bottom-4 z-40 mx-auto flex max-w-80 items-center justify-center rounded-lg border-2 border-dashed border-red-300 bg-red-50 px-4 py-5 text-center text-sm font-medium text-red-700 shadow-lg transition"
      >
        Soltar aquí para marcar como Cierre Perdido
        <div data-list hidden></div>
      </div>
    )
  }

  <dialog id="lost-dialog" class="m-auto w-full max-w-sm rounded-lg p-0 shadow-xl backdrop:bg-slate-900/40">
    <form method="dialog" class="space-y-4 p-5">
      <h2>Cierre perdido</h2>
      <p class="text-sm text-slate-600">¿Cómo queda esta oportunidad?</p>
      <div class="space-y-2">
        <button class="btn w-full justify-start" value="nurturing">{LOST_LABELS.nurturing}</button>
        <button class="btn btn-danger w-full justify-start" value="no_contactar">{LOST_LABELS.no_contactar}</button>
      </div>
      <button class="btn btn-sm" value="">Cancelar</button>
    </form>
  </dialog>
</AppLayout>

<script>
  // Arrastre con Pointer Events: funciona con mouse, dedo y lápiz.
  // Mouse: se arrastra al mover más de 5 px. Táctil: mantener presionado ~300 ms.
  const board = document.querySelector<HTMLElement>('[data-kanban]');
  const lostZone = document.querySelector<HTMLElement>('[data-lost-zone]');
  const lostDialog = document.querySelector<HTMLDialogElement>('#lost-dialog');
  const errorBox = document.querySelector<HTMLElement>('#kanban-error');
  const HIGHLIGHT = ['ring-2', 'ring-brand-600', 'bg-brand-50'];
  const LONG_PRESS_MS = 300;
  const MOUSE_THRESHOLD = 5;
  const TOUCH_CANCEL = 10;
  const EDGE = 48;

  type Pending = { card: HTMLElement; pointerId: number; type: string; x: number; y: number; timer?: number };
  type Active = {
    card: HTMLElement;
    ghost: HTMLElement;
    offsetX: number;
    offsetY: number;
    x: number;
    y: number;
    over: HTMLElement | null;
    origin: { list: HTMLElement; next: Element | null };
  };

  let pending: Pending | null = null;
  let active: Active | null = null;
  let suppressClick = false;
  let raf = 0;

  const columns = () => [...document.querySelectorAll<HTMLElement>('[data-column]')];
  const columnAt = (x: number, y: number) => document.elementFromPoint(x, y)?.closest<HTMLElement>('[data-column]') ?? null;
  const canDropOn = (col: HTMLElement | null) =>
    !!col && !!active && col.dataset.droppable === 'true' && col.dataset.stage !== active.card.dataset.stage;

  function showError(message: string) {
    if (!errorBox) return alert(message);
    errorBox.textContent = message;
    errorBox.hidden = false;
    errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function highlight(col: HTMLElement | null) {
    for (const c of columns()) HIGHLIGHT.forEach((cls) => c.classList.toggle(cls, c === col));
  }

  function askLostSubstatus(): Promise<string | null> {
    if (!lostDialog) return Promise.resolve(null);
    return new Promise((resolve) => {
      lostDialog.returnValue = '';
      lostDialog.addEventListener('close', () => resolve(lostDialog.returnValue || null), { once: true });
      lostDialog.showModal();
    });
  }

  function clearPending() {
    if (pending?.timer) clearTimeout(pending.timer);
    pending = null;
  }

  function startDrag(card: HTMLElement, x: number, y: number, viaTouch: boolean) {
    const rect = card.getBoundingClientRect();
    const ghost = card.cloneNode(true) as HTMLElement;
    ghost.removeAttribute('data-deal-id');
    Object.assign(ghost.style, {
      position: 'fixed',
      left: `${rect.left}px`,
      top: `${rect.top}px`,
      width: `${rect.width}px`,
      pointerEvents: 'none',
      zIndex: '50',
      transform: 'rotate(2deg) scale(1.03)',
      boxShadow: '0 12px 28px rgba(15, 23, 42, 0.25)',
      opacity: '0.95',
    });
    document.body.appendChild(ghost);

    active = {
      card,
      ghost,
      offsetX: x - rect.left,
      offsetY: y - rect.top,
      x,
      y,
      over: null,
      origin: { list: card.parentElement as HTMLElement, next: card.nextElementSibling },
    };
    card.classList.add('opacity-40');
    document.body.classList.add('select-none');
    if (errorBox) errorBox.hidden = true;
    if (lostZone) lostZone.hidden = false;
    if (viaTouch) navigator.vibrate?.(15);
    raf = requestAnimationFrame(autoScroll);
  }

  // Desplaza el tablero (horizontal) y la página (vertical) cerca de los bordes
  function autoScroll() {
    if (!active) return;
    const { x, y } = active;
    if (board) {
      const r = board.getBoundingClientRect();
      if (x < r.left + EDGE) board.scrollLeft -= 12;
      else if (x > r.right - EDGE) board.scrollLeft += 12;
    }
    if (y < EDGE) window.scrollBy(0, -12);
    else if (y > window.innerHeight - EDGE) window.scrollBy(0, 12);
    updateOver();
    raf = requestAnimationFrame(autoScroll);
  }

  function updateOver() {
    if (!active) return;
    const col = columnAt(active.x, active.y);
    active.over = canDropOn(col) ? col : null;
    highlight(active.over);
  }

  function endDrag(): { card: HTMLElement; target: HTMLElement | null; origin: Active['origin'] } | null {
    if (!active) return null;
    cancelAnimationFrame(raf);
    const { card, ghost, over, origin } = active;
    ghost.remove();
    card.classList.remove('opacity-40');
    document.body.classList.remove('select-none');
    highlight(null);
    if (lostZone) lostZone.hidden = true;
    active = null;
    suppressClick = true;
    setTimeout(() => (suppressClick = false), 0);
    return { card, target: over, origin };
  }

  async function move(card: HTMLElement, target: HTMLElement, origin: Active['origin']) {
    const revert = () => {
      origin.list.insertBefore(card, origin.next);
      card.classList.remove('opacity-60', 'pointer-events-none');
    };
    const stage = target.dataset.stage!;
    let lost: string | null = null;
    if (stage === 'cierre_perdido') {
      lost = await askLostSubstatus();
      if (!lost) return;
    }

    // Movimiento optimista; si la BD lo rechaza, la tarjeta vuelve a su lugar
    const list = target.querySelector<HTMLElement>('[data-list]');
    if (list && !target.hasAttribute('data-lost-zone')) {
      list.querySelector('[data-empty]')?.remove();
      list.prepend(card);
    }
    card.classList.add('opacity-60', 'pointer-events-none');

    try {
      const res = await fetch(`/api/oportunidades/${card.dataset.dealId}/etapa`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ stage, lost_substatus: lost }),
      });
      if (res.redirected) return location.assign(res.url);
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        revert();
        showError(data.error ?? 'No se pudo mover la oportunidad.');
        return;
      }
      location.reload();
    } catch {
      revert();
      showError('Sin conexión. Intente de nuevo.');
    }
  }

  board?.addEventListener('pointerdown', (event) => {
    if (active || (event.pointerType === 'mouse' && event.button !== 0)) return;
    const card = (event.target as Element).closest<HTMLElement>('[data-deal-id]');
    if (!card || card.dataset.canDrag !== 'true') return;
    pending = { card, pointerId: event.pointerId, type: event.pointerType, x: event.clientX, y: event.clientY };
    if (event.pointerType !== 'mouse') {
      pending.timer = window.setTimeout(() => {
        if (pending) {
          const p = pending;
          clearPending();
          startDrag(p.card, p.x, p.y, true);
        }
      }, LONG_PRESS_MS);
    }
  });

  document.addEventListener('pointermove', (event) => {
    if (pending && event.pointerId === pending.pointerId) {
      const distance = Math.hypot(event.clientX - pending.x, event.clientY - pending.y);
      if (pending.type === 'mouse' && distance > MOUSE_THRESHOLD) {
        const p = pending;
        clearPending();
        startDrag(p.card, p.x, p.y, false);
      } else if (pending.type !== 'mouse' && distance > TOUCH_CANCEL) {
        clearPending(); // es un desplazamiento, no un arrastre
      }
    }
    if (active) {
      active.x = event.clientX;
      active.y = event.clientY;
      active.ghost.style.left = `${event.clientX - active.offsetX}px`;
      active.ghost.style.top = `${event.clientY - active.offsetY}px`;
      updateOver();
    }
  });

  document.addEventListener('pointerup', () => {
    clearPending();
    const result = endDrag();
    if (result?.target) move(result.card, result.target, result.origin);
  });

  document.addEventListener('pointercancel', () => {
    clearPending();
    endDrag();
  });

  // Mientras se arrastra con el dedo, la página no hace scroll ni abre menús
  document.addEventListener('touchmove', (event) => { if (active) event.preventDefault(); }, { passive: false });
  board?.addEventListener('contextmenu', (event) => { if (active || pending) event.preventDefault(); });
  board?.addEventListener('dragstart', (event) => event.preventDefault());
  board?.addEventListener('click', (event) => { if (suppressClick) { event.preventDefault(); event.stopPropagation(); } }, true);
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && active) endDrag(); });
</script>
