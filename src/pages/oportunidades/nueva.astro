---
import AppLayout from '../../layouts/AppLayout.astro';
import { cop, todayCo } from '../../lib/format';
import { date, ensure, int, parseForm, runActions, text, uuid, z } from '../../lib/forms';
import { PAYROLL_LABELS } from '../../lib/labels';
import { activeOrigins, activeUsers, operationalCities } from '../../lib/options';
import type { TablesInsert } from '../../lib/database.types';

const { supabase, userId } = Astro.locals;
const companyId = Astro.url.searchParams.get('company_id');

const outcome = await runActions(Astro, {
  create: async (form) => {
    const input = parseForm(
      z.object({
        company_id: uuid(),
        deal_name_branch: text(200),
        branch_id: uuid().optional(),
        city_id: uuid(),
        primary_contact_id: uuid().optional(),
        assigned_user_id: uuid(),
        origin_code: z.string().min(1),
        target_employees_n: int().positive().optional(),
        payroll_frequency: z.enum(['mensual', 'quincenal']).optional(),
        estimated_close_date: date().optional(),
        tentative_campaign_date: date().optional(),
        next_action: text(300),
        next_action_due_date: date(),
        next_action_owner_id: uuid(),
      }),
      form,
    );
    // conversion_rate_c_snapshot y average_ticket_t_snapshot los fija el trigger
    const deal = ensure(
      await supabase
        .from('deals_opportunities')
        .insert(input as TablesInsert<'deals_opportunities'>)
        .select('id')
        .single(),
    );
    return { message: 'Oportunidad creada en Prospecto.', redirect: `/oportunidades/${deal.id}` };
  },
});
if (outcome?.kind === 'redirect') return outcome.response;
const error = outcome?.kind === 'error' ? outcome.error : null;
const v = outcome?.kind === 'error' ? outcome.values : {};
const selectedCompanyId = v.company_id ?? companyId;

const [{ data: companies }, cities, users, origins, settings] = await Promise.all([
  supabase.from('companies').select('id, name').order('name'),
  operationalCities(supabase),
  activeUsers(supabase, ['comercial', 'direccion']),
  activeOrigins(supabase),
  supabase.from('system_settings').select('key, value').in('key', ['conversion_rate_c', 'average_ticket_t']),
]);

let branches: { id: string; name: string; city_id: string | null }[] = [];
let contacts: { id: string; full_name: string; role_title: string }[] = [];
let companyName = '';
if (selectedCompanyId) {
  const [b, c, co] = await Promise.all([
    supabase.from('company_branches').select('id, name, city_id').eq('company_id', selectedCompanyId).order('name'),
    supabase.from('contacts').select('id, full_name, role_title').eq('company_id', selectedCompanyId).eq('active', true).order('full_name'),
    supabase.from('companies').select('name').eq('id', selectedCompanyId).maybeSingle(),
  ]);
  branches = b.data ?? [];
  contacts = c.data ?? [];
  companyName = co.data?.name ?? '';
}
const c = Number(settings.data?.find((s) => s.key === 'conversion_rate_c')?.value ?? 0.7);
const t = Number(settings.data?.find((s) => s.key === 'average_ticket_t')?.value ?? 300000);
---

<AppLayout title="Nueva oportunidad" error={error}>
  <h1 class="mb-4">Nueva oportunidad</h1>

  {
    !selectedCompanyId ? (
      <form method="get" class="card max-w-xl space-y-3">
        <label class="label" for="company_id">Empresa</label>
        <select class="input" id="company_id" name="company_id" required>
          <option value="">Seleccione…</option>
          {companies?.map((co) => <option value={co.id}>{co.name}</option>)}
        </select>
        <div class="flex gap-2">
          <button class="btn btn-primary" type="submit">Continuar</button>
          <a class="btn" href="/empresas/nueva">Crear empresa</a>
        </div>
      </form>
    ) : (
      <form method="post" class="card space-y-6">
        <input type="hidden" name="_action" value="create" />
        <input type="hidden" name="company_id" value={selectedCompanyId} />
        <p class="text-sm">
          Empresa: <a href={`/empresas/${selectedCompanyId}`}>{companyName}</a> ·{' '}
          <a href="/oportunidades/nueva" class="text-xs">cambiar</a>
        </p>
        <fieldset class="grid-form">
          <div class="sm:col-span-2">
            <label class="label" for="deal_name_branch">Nombre del negocio / sede *</label>
            <input class="input" id="deal_name_branch" name="deal_name_branch" required placeholder={`${companyName} - Sede Medellín`} value={v.deal_name_branch} />
          </div>
          <div>
            <label class="label" for="city_id">Ciudad operativa *</label>
            <select class="input" id="city_id" name="city_id" required>
              {cities.map((ci) => <option value={ci.id} selected={v.city_id === ci.id}>{ci.name}</option>)}
            </select>
          </div>
          <div>
            <label class="label" for="branch_id">Sede de la empresa</label>
            <select class="input" id="branch_id" name="branch_id">
              <option value="">—</option>
              {branches.map((b) => <option value={b.id} selected={v.branch_id === b.id}>{b.name}</option>)}
            </select>
          </div>
          <div>
            <label class="label" for="primary_contact_id">Contacto principal</label>
            <select class="input" id="primary_contact_id" name="primary_contact_id">
              <option value="">—</option>
              {contacts.map((ct) => <option value={ct.id} selected={v.primary_contact_id === ct.id}>{ct.full_name} · {ct.role_title}</option>)}
            </select>
          </div>
          <div>
            <label class="label" for="assigned_user_id">Ejecutivo asignado *</label>
            <select class="input" id="assigned_user_id" name="assigned_user_id" required>
              {users.map((u) => <option value={u.id} selected={(v.assigned_user_id ?? userId) === u.id}>{u.full_name}</option>)}
            </select>
          </div>
          <div>
            <label class="label" for="origin_code">Origen *</label>
            <select class="input" id="origin_code" name="origin_code" required>
              {origins.map((o) => <option value={o.code} selected={v.origin_code === o.code}>{o.label}</option>)}
            </select>
          </div>
          <div>
            <label class="label" for="target_employees_n">Empleados a atender en jornadas (N)</label>
            <input class="input" id="target_employees_n" name="target_employees_n" type="number" min="1" value={v.target_employees_n} />
            <p class="mt-1 text-xs text-slate-500">
              Facturación estimada = N × {Math.round(c * 100)}% × {cop(t)}
            </p>
          </div>
          <div>
            <label class="label" for="payroll_frequency">Pago de nómina</label>
            <select class="input" id="payroll_frequency" name="payroll_frequency">
              <option value="">Igual a la empresa</option>
              {Object.entries(PAYROLL_LABELS).map(([value, label]) => <option value={value} selected={v.payroll_frequency === value}>{label}</option>)}
            </select>
          </div>
          <div>
            <label class="label" for="estimated_close_date">Fecha estimada de cierre de convenio</label>
            <input class="input" id="estimated_close_date" name="estimated_close_date" type="date" value={v.estimated_close_date} />
          </div>
          <div>
            <label class="label" for="tentative_campaign_date">Fecha tentativa de jornada</label>
            <input class="input" id="tentative_campaign_date" name="tentative_campaign_date" type="date" value={v.tentative_campaign_date} />
          </div>
        </fieldset>

        <fieldset class="grid-form border-t border-slate-200 pt-4">
          <legend class="mb-2 text-sm font-semibold">Siguiente acción *</legend>
          <div class="sm:col-span-2">
            <label class="label" for="next_action">Acción</label>
            <input class="input" id="next_action" name="next_action" required placeholder="Ej. Agendar reunión con RRHH" value={v.next_action} />
          </div>
          <div>
            <label class="label" for="next_action_due_date">Fecha</label>
            <input class="input" id="next_action_due_date" name="next_action_due_date" type="date" required min={todayCo()} value={v.next_action_due_date} />
          </div>
          <div>
            <label class="label" for="next_action_owner_id">Responsable</label>
            <select class="input" id="next_action_owner_id" name="next_action_owner_id" required>
              {users.map((u) => <option value={u.id} selected={(v.next_action_owner_id ?? userId) === u.id}>{u.full_name}</option>)}
            </select>
          </div>
        </fieldset>

        <div class="flex gap-2">
          <button class="btn btn-primary" type="submit">Crear oportunidad</button>
          <a class="btn" href="/oportunidades">Cancelar</a>
        </div>
      </form>
    )
  }
</AppLayout>
