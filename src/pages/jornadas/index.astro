---
// Calendario de jornadas (backlog V0.2 · SOE-10). Solo cambia la
// presentación: mismas consultas de solo lectura. Cada jornada tiene su
// color y una jornada de varios días se reconoce como una sola
// («Día 2 de 3»). El día se elige con clic o toque (enlace, sin JavaScript).
import AppLayout from '../../layouts/AppLayout.astro';
import { addDays, fmtDate, fmtMonth, fmtTime, fmtWeekday, todayCo } from '../../lib/format';
import { ACTIVE_CAMPAIGN_STATUSES, CAMPAIGN_STATUS_BADGE, CAMPAIGN_STATUS_LABELS } from '../../lib/labels';
import { operationalCities } from '../../lib/options';

const { supabase } = Astro.locals;
const params = Astro.url.searchParams;
const today = todayCo();
const month = /^\d{4}-\d{2}$/.test(params.get('mes') ?? '') ? params.get('mes')! : today.slice(0, 7);
const cityId = params.get('ciudad') ?? '';

const [y, m] = month.split('-').map(Number);
const monthStart = `${month}-01`;
const monthEnd = addDays(new Date(Date.UTC(y, m, 1)).toISOString().slice(0, 10), -1);
const prev = new Date(Date.UTC(y, m - 2, 1)).toISOString().slice(0, 7);
const nextMonth = new Date(Date.UTC(y, m, 1)).toISOString().slice(0, 7);

// Cuadrícula de lunes a domingo que cubre el mes completo
const weekdayIndex = (d: string) => (new Date(`${d}T00:00:00Z`).getUTCDay() + 6) % 7; // lunes = 0
const gridStart = addDays(monthStart, -weekdayIndex(monthStart));
const gridEnd = addDays(monthEnd, 6 - weekdayIndex(monthEnd));
const days: string[] = [];
for (let d = gridStart; d <= gridEnd; d = addDays(d, 1)) days.push(d);

let sessionsQuery = supabase
  .from('v_campaign_calendar')
  .select('*')
  .gte('session_date', gridStart)
  .lte('session_date', gridEnd)
  .order('session_date')
  .order('start_time');
if (cityId) sessionsQuery = sessionsQuery.eq('city_id', cityId);

let campaignsQuery = supabase
  .from('v_campaigns')
  .select('id, company_name, deal_name_branch, city_name, status, first_session_date, sessions_count, attended_headcount, responsible_user_name, checklist_complete')
  .in('status', ACTIVE_CAMPAIGN_STATUSES)
  .order('first_session_date', { nullsFirst: true });
if (cityId) campaignsQuery = campaignsQuery.eq('city_id', cityId);

const [{ data: sessionRows }, { data: campaigns }, cities] = await Promise.all([sessionsQuery, campaignsQuery, operationalCities(supabase)]);
const sessions = sessionRows ?? [];

// «Día n de N»: posición de cada sesión dentro de su jornada (todas sus sesiones, no solo las del mes)
const campaignIds = [...new Set(sessions.map((s) => s.campaign_id).filter((x): x is string => !!x))];
const { data: allSessions } = campaignIds.length
  ? await supabase.from('campaign_sessions').select('id, campaign_id, session_date, start_time').in('campaign_id', campaignIds).order('session_date').order('start_time')
  : { data: [] as { id: string; campaign_id: string; session_date: string; start_time: string }[] };
const position = new Map<string, { n: number; total: number }>();
const perCampaign = new Map<string, string[]>();
for (const s of allSessions ?? []) {
  const list = perCampaign.get(s.campaign_id) ?? [];
  list.push(s.id);
  perCampaign.set(s.campaign_id, list);
}
for (const list of perCampaign.values()) list.forEach((id, i) => position.set(id, { n: i + 1, total: list.length }));

// Un color estable por jornada (clases literales para que Tailwind las genere)
const PALETTE = [
  { chip: 'border-l-teal-500 bg-teal-50 text-teal-900', dot: 'bg-teal-500' },
  { chip: 'border-l-sky-500 bg-sky-50 text-sky-900', dot: 'bg-sky-500' },
  { chip: 'border-l-violet-500 bg-violet-50 text-violet-900', dot: 'bg-violet-500' },
  { chip: 'border-l-amber-500 bg-amber-50 text-amber-900', dot: 'bg-amber-500' },
  { chip: 'border-l-rose-500 bg-rose-50 text-rose-900', dot: 'bg-rose-500' },
  { chip: 'border-l-emerald-500 bg-emerald-50 text-emerald-900', dot: 'bg-emerald-500' },
  { chip: 'border-l-indigo-500 bg-indigo-50 text-indigo-900', dot: 'bg-indigo-500' },
  { chip: 'border-l-orange-500 bg-orange-50 text-orange-900', dot: 'bg-orange-500' },
];
const CANCELLED = { chip: 'border-l-slate-400 bg-slate-100 text-slate-500 line-through', dot: 'bg-slate-400' };
const colorOf = (campaignId: string | null, status?: string | null) => {
  if (status === 'cancelada') return CANCELLED;
  let h = 0;
  for (const ch of campaignId ?? '') h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  return PALETTE[h % PALETTE.length];
};

const byDay = new Map<string, typeof sessions>();
for (const s of sessions) {
  if (!s.session_date) continue;
  const list = byDay.get(s.session_date) ?? [];
  list.push(s);
  byDay.set(s.session_date, list);
}

// Día seleccionado: el pedido, si no hoy (si cae en el mes), si no el primer día con sesiones
const requested = params.get('dia') ?? '';
const firstWithSessions = days.find((d) => d.startsWith(month) && byDay.has(d));
const selected = days.includes(requested) ? requested : today.startsWith(month) ? today : (firstWithSessions ?? monthStart);
const selectedSessions = byDay.get(selected) ?? [];
const sessionsInMonth = sessions.filter((s) => s.session_date?.startsWith(month)).length;
const campaignsInMonth = new Set(sessions.filter((s) => s.session_date?.startsWith(month)).map((s) => s.campaign_id)).size;

const q = (patch: Record<string, string>) => {
  const p = new URLSearchParams(params);
  for (const [k, v] of Object.entries(patch)) v ? p.set(k, v) : p.delete(k);
  return `?${p.toString()}`;
};
const WEEKDAYS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
const MAX_CHIPS = 3;
const statuses = ['programada', 'en_ejecucion', 'captura_cerrada', 'operacion_cerrada'] as const;
---

<AppLayout title="Jornadas">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1>Jornadas</h1>
      <p class="text-sm text-slate-500">
        {sessionsInMonth} {sessionsInMonth === 1 ? 'sesión' : 'sesiones'} de {campaignsInMonth} {campaignsInMonth === 1 ? 'jornada' : 'jornadas'} en <span class="capitalize">{fmtMonth(month)}</span>.
        Se programan desde una oportunidad en Convenio Firmado.
      </p>
    </div>
    <a class="btn btn-sm" href="/jornadas/seguimiento">Seguimiento de quienes no compraron</a>
  </div>

  <div class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <section class="card p-3 sm:p-4">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-1">
          <a class="btn btn-sm" href={q({ mes: prev, dia: '' })} aria-label="Mes anterior">←</a>
          <h2 class="min-w-44 text-center text-lg capitalize">{fmtMonth(month)}</h2>
          <a class="btn btn-sm" href={q({ mes: nextMonth, dia: '' })} aria-label="Mes siguiente">→</a>
          {!today.startsWith(month) || selected !== today ? <a class="btn btn-sm ml-1" href={q({ mes: today.slice(0, 7), dia: today })}>Hoy</a> : null}
        </div>
        <form method="get" class="flex items-center gap-2">
          <input type="hidden" name="mes" value={month} />
          <select class="input py-1.5 text-sm" name="ciudad" aria-label="Ciudad" onchange="this.form.submit()">
            <option value="">Todas las ciudades</option>
            {cities.map((c) => <option value={c.id} selected={cityId === c.id}>{c.name}</option>)}
          </select>
          <noscript><button class="btn btn-sm" type="submit">Filtrar</button></noscript>
        </form>
      </div>

      <div class="grid grid-cols-7 border-b border-slate-200 pb-1 text-center text-[11px] font-semibold uppercase tracking-wide text-slate-500">
        {WEEKDAYS.map((w) => <div>{w}</div>)}
      </div>
      <div class="grid grid-cols-7 gap-px overflow-hidden rounded-b-lg bg-slate-200">
        {days.map((d) => {
          const items = byDay.get(d) ?? [];
          const inMonth = d.startsWith(month);
          const isToday = d === today;
          const isSelected = d === selected;
          const conflict = items.some((s) => s.has_conflict);
          return (
            <a
              href={`${q({ dia: d })}#detalle`}
              class:list={[
                'group relative flex min-h-16 flex-col gap-1 p-1 hover:no-underline sm:min-h-28 sm:p-1.5',
                inMonth ? 'bg-white hover:bg-brand-50' : 'bg-slate-50 text-slate-400 hover:bg-slate-100',
                isSelected && 'ring-2 ring-inset ring-brand-600',
              ]}
              aria-current={isToday ? 'date' : undefined}
              aria-label={`${fmtWeekday(d)}: ${items.length ? `${items.length} ${items.length === 1 ? 'sesión' : 'sesiones'}` : 'sin sesiones'}`}
            >
              <div class="flex items-center justify-between">
                <span
                  class:list={[
                    'flex h-6 w-6 items-center justify-center rounded-full text-xs font-semibold',
                    isToday ? 'bg-brand-700 text-white' : inMonth ? 'text-slate-700' : 'text-slate-400',
                  ]}
                >
                  {Number(d.slice(8, 10))}
                </span>
                {conflict && <span class="h-2 w-2 rounded-full bg-red-500" title="Cruce de horario" />}
              </div>

              {/* Escritorio: tarjetas por sesión */}
              <div class="hidden flex-col gap-0.5 sm:flex">
                {items.slice(0, MAX_CHIPS).map((s) => {
                  const pos = s.session_id ? position.get(s.session_id) : undefined;
                  return (
                    <span class:list={['truncate rounded border-l-[3px] px-1 py-0.5 text-[11px] leading-tight', colorOf(s.campaign_id, s.campaign_status).chip]}>
                      <span class="font-semibold">{fmtTime(s.start_time)}</span> {s.company_name}
                      {pos && pos.total > 1 && <span class="opacity-70"> · {pos.n}/{pos.total}</span>}
                    </span>
                  );
                })}
                {items.length > MAX_CHIPS && <span class="px-1 text-[11px] font-medium text-slate-500">+{items.length - MAX_CHIPS} más</span>}
              </div>

              {/* Celular: puntos de color */}
              <div class="flex flex-wrap gap-0.5 sm:hidden">
                {items.slice(0, 4).map((s) => <span class:list={['h-1.5 w-1.5 rounded-full', colorOf(s.campaign_id, s.campaign_status).dot]} />)}
              </div>
            </a>
          );
        })}
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
        <span>Estados:</span>
        {statuses.map((st) => <span class={CAMPAIGN_STATUS_BADGE[st]}>{CAMPAIGN_STATUS_LABELS[st]}</span>)}
        <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-red-500" /> Cruce de horario</span>
        <span>· El color identifica la jornada; «2/3» = día 2 de 3.</span>
      </div>
    </section>

    <div class="space-y-4">
      <section class="card space-y-3" id="detalle">
        <div class="flex items-baseline justify-between gap-2">
          <h2 class="capitalize">{fmtWeekday(selected)}</h2>
          {selected === today && <span class="badge badge-blue">Hoy</span>}
        </div>
        {selectedSessions.length ? (
          <ul class="space-y-2">
            {selectedSessions.map((s) => {
              const pos = s.session_id ? position.get(s.session_id) : undefined;
              const color = colorOf(s.campaign_id, s.campaign_status);
              return (
                <li class:list={['rounded-lg border-l-4 p-3 text-sm', color.chip, s.has_conflict && 'ring-1 ring-red-300']}>
                  <div class="flex items-start justify-between gap-2">
                    <div class="font-semibold">{fmtTime(s.start_time)} – {fmtTime(s.end_time)}</div>
                    {s.campaign_status && <span class={CAMPAIGN_STATUS_BADGE[s.campaign_status]}>{CAMPAIGN_STATUS_LABELS[s.campaign_status]}</span>}
                  </div>
                  <a href={`/jornadas/${s.campaign_id}`} class="mt-1 block text-base font-semibold text-ink">{s.company_name}</a>
                  <div class="text-xs opacity-80">
                    {s.deal_name_branch}
                    {pos && pos.total > 1 && <> · Día {pos.n} de {pos.total}</>}
                  </div>
                  <div class="mt-1 text-xs opacity-80">
                    {[s.city_name, s.branch_name, s.location_detail].filter(Boolean).join(' · ')}
                  </div>
                  <div class="mt-1 text-xs opacity-80">Responsable: {s.responsible_user_name ?? '—'}</div>
                  {s.has_conflict && <div class="mt-1 text-xs font-medium text-red-700">Cruce de horario con otra sesión del mismo responsable</div>}
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="text-sm text-slate-500">Sin sesiones este día.</p>
        )}
      </section>

      <section class="card">
        <h2 class="mb-3">Jornadas activas</h2>
        <ul class="space-y-3 text-sm">
          {campaigns?.map((j) => (
            <li class="flex gap-2">
              <span class:list={['mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full', colorOf(j.id, j.status).dot]} />
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                  <a href={`/jornadas/${j.id}`} class="truncate font-medium">{j.company_name}</a>
                  {j.status && <span class={CAMPAIGN_STATUS_BADGE[j.status]}>{CAMPAIGN_STATUS_LABELS[j.status]}</span>}
                </div>
                <div class="text-xs text-slate-500">
                  {j.deal_name_branch} · {j.city_name} · {j.first_session_date ? fmtDate(j.first_session_date) : 'sin fecha'} · {j.sessions_count} {j.sessions_count === 1 ? 'sesión' : 'sesiones'} · {j.attended_headcount} atendidos
                </div>
                {!j.checklist_complete && j.status === 'programada' && <span class="badge badge-amber mt-1">Checklist incompleto</span>}
              </div>
            </li>
          ))}
          {!campaigns?.length && <li class="text-slate-500">No hay jornadas abiertas.</li>}
        </ul>
      </section>
    </div>
  </div>
</AppLayout>
