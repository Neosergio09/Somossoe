---
import AppLayout from '../../layouts/AppLayout.astro';
import { hasRole } from '../../lib/auth';
import { cop, fmtDate, fmtDateTime, fmtTime, fmtWeekday } from '../../lib/format';
import { checkbox, date, ensure, FormError, parseForm, runActions, text, time, uuid, z } from '../../lib/forms';
import { CAMPAIGN_STATUS_BADGE, CAMPAIGN_STATUS_LABELS, DOC_STATUS_BADGE, DOC_STATUS_LABELS, PAYMENT_MODALITY_LABELS } from '../../lib/labels';
import { orderNumber } from '../../lib/orders';
import { activeUsers, operationalCities } from '../../lib/options';

const { supabase } = Astro.locals;
const id = Astro.params.id!;

const sessionSchema = z.object({
  session_date: date(),
  start_time: time(),
  end_time: time(),
  location_detail: text(200).optional(),
  responsible_user_id: uuid(),
});

async function setStatus(status: 'en_ejecucion' | 'cerrada' | 'cancelada', extra: Record<string, unknown> = {}) {
  ensure(await supabase.from('campaigns_jornadas').update({ status, ...extra }).eq('id', id).select('id').single());
}

const outcome = await runActions(Astro, {
  update: async (form) => {
    const input = parseForm(
      z.object({
        responsible_user_id: uuid(),
        city_id: uuid(),
        branch_id: uuid().optional(),
        logistics_confirmed: checkbox(),
        notes: text(2000).optional(),
      }),
      form,
    );
    ensure(
      await supabase
        .from('campaigns_jornadas')
        .update({ ...input, branch_id: input.branch_id ?? null, notes: input.notes ?? null })
        .eq('id', id)
        .select('id')
        .single(),
    );
    return { message: 'Jornada actualizada.' };
  },
  add_session: async (form) => {
    const input = parseForm(sessionSchema, form);
    ensure(await supabase.from('campaign_sessions').insert({ ...input, location_detail: input.location_detail ?? null, campaign_id: id }));
    return { message: 'Sesión agregada.' };
  },
  delete_session: async (form) => {
    const sessionId = String(form.get('session_id') ?? '');
    ensure(await supabase.from('campaign_sessions').delete().eq('id', sessionId).eq('campaign_id', id).select('id').single());
    return { message: 'Sesión eliminada.' };
  },
  start: async () => {
    await setStatus('en_ejecucion');
    return { message: 'Jornada iniciada. Ya puede registrar la asistencia.' };
  },
  close: async () => {
    await setStatus('cerrada');
    return { message: 'Jornada cerrada.' };
  },
  cancel: async (form) => {
    const reason = String(form.get('cancel_reason') ?? '').trim();
    if (!reason) throw new FormError('Indique el motivo de la cancelación.');
    await setStatus('cancelada', { cancel_reason: reason });
    return { message: 'Jornada cancelada.' };
  },
  add_attendee: async (form) => {
    const input = parseForm(
      z.object({
        session_id: uuid(),
        full_name: text(150),
        document_id: z.string().regex(/^[0-9A-Za-z]{4,15}$/, { error: 'entre 4 y 15 letras o números, sin puntos' }),
        area: text(100).optional(),
      }),
      form,
    );
    ensure(await supabase.from('campaign_attendance').insert({ ...input, area: input.area ?? null, campaign_id: id }));
    return { message: `${input.full_name} registrado(a).` };
  },
  delete_attendee: async (form) => {
    const attendeeId = String(form.get('attendee_id') ?? '');
    ensure(await supabase.from('campaign_attendance').delete().eq('id', attendeeId).eq('campaign_id', id).select('id').single());
    return { message: 'Registro de asistencia eliminado.' };
  },
});
if (outcome?.kind === 'redirect') return outcome.response;
const error = outcome?.kind === 'error' ? outcome.error : null;
const v = outcome?.kind === 'error' ? outcome.values : {};
const lastAction = outcome?.kind === 'error' ? outcome.action : '';

const { data: j } = await supabase.from('v_campaigns').select('*').eq('id', id).maybeSingle();
if (!j) return new Response('Jornada no encontrada', { status: 404 });

const [sessions, attendance, agreement, branches, opsUsers, sessionUsers, cities, orders] = await Promise.all([
  supabase.from('v_campaign_calendar').select('*').eq('campaign_id', id).order('session_date').order('start_time'),
  supabase.from('campaign_attendance').select('*').eq('campaign_id', id).order('created_at', { ascending: false }),
  supabase.from('v_agreements').select('id, max_installments, payroll_frequency, valid_from, valid_until, effective_status').eq('id', j.agreement_id!).maybeSingle(),
  supabase.from('company_branches').select('id, name').eq('company_id', j.company_id!).order('name'),
  activeUsers(supabase, ['operacion']),
  activeUsers(supabase, ['operacion', 'comercial']),
  operationalCities(supabase),
  supabase
    .from('v_orders')
    .select('id, order_number, buyer_name, buyer_document_id, payment_modality, installments_count, total_amount, doc_status, is_cancelled')
    .eq('campaign_id', id)
    .order('order_number'),
]);
// Las sesiones de una jornada cancelada no salen en el calendario: se consultan directo
const sessionRows = j.status === 'cancelada'
  ? (await supabase.from('campaign_sessions').select('id, session_date, start_time, end_time, location_detail').eq('campaign_id', id).order('session_date')).data?.map((s) => ({ ...s, session_id: s.id, responsible_user_name: '', has_conflict: false })) ?? []
  : sessions.data ?? [];

const status = j.status!;
const isOps = hasRole(Astro.locals, 'operacion');
const canEdit = hasRole(Astro.locals, 'operacion', 'comercial') && (status === 'programada' || status === 'en_ejecucion');
const canCancel = hasRole(Astro.locals, 'operacion', 'direccion') && status === 'programada';
const canAttend = hasRole(Astro.locals, 'operacion', 'comercial') && status === 'en_ejecucion';
const attendees = attendance.data ?? [];
const orderList = orders.data ?? [];
const activeOrders = orderList.filter((o) => !o.is_cancelled);
// RF-M03-04: valor real vendido = órdenes no anuladas; conversión = compradores ÷ asistentes
const realSold = activeOrders.reduce((sum, o) => sum + (o.total_amount ?? 0), 0);
const buyersCount = new Set(activeOrders.map((o) => o.buyer_document_id)).size;
const canOrder = hasRole(Astro.locals, 'comercial') && (status === 'en_ejecucion' || status === 'cerrada');
const orderLink = (a?: { document_id: string; full_name: string }) =>
  `/ordenes/nueva?campaign_id=${id}${a ? `&document_type=cc&document_id=${encodeURIComponent(a.document_id)}&full_name=${encodeURIComponent(a.full_name)}` : ''}`;
const sessionLabel = (sid: string) => {
  const s = sessionRows.find((x) => x.session_id === sid);
  return s ? `${fmtDate(s.session_date)} ${fmtTime(s.start_time)}` : '';
};
---

<AppLayout title={`Jornada · ${j.company_name}`} error={error}>
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div>
      <a href="/jornadas" class="text-sm">← Jornadas</a>
      <h1>Jornada · {j.company_name}</h1>
      <p class="text-sm text-slate-600">
        <a href={`/oportunidades/${j.deal_id}`}>{j.deal_name_branch}</a> · {j.city_name}{j.branch_name && ` · ${j.branch_name}`} · Responsable: {j.responsible_user_name}
      </p>
    </div>
    <div class="text-right">
      <span class={`${CAMPAIGN_STATUS_BADGE[status]} text-sm`}>{CAMPAIGN_STATUS_LABELS[status]}</span>
      <div class="mt-2 text-sm text-slate-600">
        Asistencia: <strong>{j.attended_headcount}</strong>{j.target_employees_n ? ` de ${j.target_employees_n} proyectados` : ''}
      </div>
      <div class="text-xs text-slate-500">Facturación estimada de la oportunidad: {cop(j.estimated_billing_amount)}</div>
      <div class="text-sm text-slate-600">
        Valor real vendido: <strong>{cop(realSold)}</strong> · {buyersCount} compradores
        {j.attended_headcount ? ` (${Math.round((buyersCount / Number(j.attended_headcount)) * 100)}% de conversión)` : ''}
      </div>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <section class="card">
        <h2 class="mb-3">Sesiones</h2>
        <table class="table">
          <thead><tr><th>Fecha</th><th>Horario</th><th>Lugar</th><th>Responsable</th><th></th></tr></thead>
          <tbody>
            {sessionRows.map((s) => (
              <tr class:list={[s.has_conflict && 'bg-red-50']}>
                <td class="capitalize">{s.session_date && fmtWeekday(s.session_date)}</td>
                <td>{fmtTime(s.start_time)}–{fmtTime(s.end_time)} {s.has_conflict && <span class="badge badge-red">Cruce</span>}</td>
                <td>{s.location_detail ?? '—'}</td>
                <td>{s.responsible_user_name}</td>
                <td>
                  {isOps && canEdit && (
                    <form method="post">
                      <input type="hidden" name="_action" value="delete_session" />
                      <input type="hidden" name="session_id" value={s.session_id} />
                      <button class="btn btn-sm btn-danger" type="submit">Eliminar</button>
                    </form>
                  )}
                </td>
              </tr>
            ))}
            {!sessionRows.length && <tr><td colspan="5" class="text-slate-500">Sin sesiones. Agregue al menos una para poder iniciar la jornada.</td></tr>}
          </tbody>
        </table>
        {
          isOps && canEdit && (
            <form method="post" class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-6 sm:items-end">
              <input type="hidden" name="_action" value="add_session" />
              <div class="col-span-2 sm:col-span-1">
                <label class="label">Fecha</label>
                <input class="input" name="session_date" type="date" required min={agreement.data?.valid_from ?? undefined} max={agreement.data?.valid_until ?? undefined} value={lastAction === 'add_session' ? v.session_date : ''} />
              </div>
              <div><label class="label">Inicio</label><input class="input" name="start_time" type="time" required value={lastAction === 'add_session' ? v.start_time : ''} /></div>
              <div><label class="label">Fin</label><input class="input" name="end_time" type="time" required value={lastAction === 'add_session' ? v.end_time : ''} /></div>
              <div class="col-span-2 sm:col-span-1"><label class="label">Lugar</label><input class="input" name="location_detail" value={lastAction === 'add_session' ? v.location_detail : ''} /></div>
              <div class="col-span-2 sm:col-span-1">
                <label class="label">Responsable</label>
                <select class="input" name="responsible_user_id">
                  {sessionUsers.map((u) => <option value={u.id} selected={u.id === j.responsible_user_id}>{u.full_name}</option>)}
                </select>
              </div>
              <button class="btn btn-primary col-span-2 sm:col-span-1" type="submit">Agregar sesión</button>
            </form>
          )
        }
      </section>

      <section class="card">
        <div class="mb-1 flex items-center justify-between">
          <h2>Asistencia</h2>
          <span class="text-sm text-slate-500">{attendees.length} registros</span>
        </div>
        <p class="mb-3 text-xs text-slate-500">Solo datos operativos: no se registran diagnósticos ni historia clínica.</p>
        {
          canAttend && sessionRows.length > 0 && (
            <form method="post" class="mb-4 grid grid-cols-1 gap-2 sm:grid-cols-5 sm:items-end">
              <input type="hidden" name="_action" value="add_attendee" />
              <div>
                <label class="label">Sesión</label>
                <select class="input" name="session_id">
                  {sessionRows.map((s) => <option value={s.session_id} selected={v.session_id === s.session_id}>{fmtDate(s.session_date)} {fmtTime(s.start_time)}</option>)}
                </select>
              </div>
              <div><label class="label">Nombre completo</label><input class="input" name="full_name" required autofocus={lastAction === 'add_attendee'} /></div>
              <div><label class="label">Documento</label><input class="input" name="document_id" required inputmode="numeric" /></div>
              <div><label class="label">Área</label><input class="input" name="area" value={lastAction === 'add_attendee' ? v.area : ''} /></div>
              <button class="btn btn-primary" type="submit">Registrar</button>
            </form>
          )
        }
        {status === 'programada' && <p class="mb-3 text-sm text-slate-500">La asistencia se registra cuando la jornada está En ejecución.</p>}
        <table class="table">
          <thead><tr><th>Nombre</th><th>Documento</th><th>Área</th><th>Sesión</th><th>Registro</th><th>Compra</th><th></th></tr></thead>
          <tbody>
            {attendees.map((a) => (
              <tr>
                <td>{a.full_name}</td>
                <td>{a.document_id}</td>
                <td>{a.area ?? '—'}</td>
                <td class="text-xs">{sessionLabel(a.session_id)}</td>
                <td class="text-xs text-slate-500">{fmtDateTime(a.created_at)}</td>
                <td class="whitespace-nowrap">
                  {a.buyer_id ? (
                    <span class="badge badge-green">Compró</span>
                  ) : (
                    canOrder && <a class="btn btn-sm" href={orderLink(a)}>Registrar orden</a>
                  )}
                </td>
                <td>
                  {canAttend && (
                    <form method="post">
                      <input type="hidden" name="_action" value="delete_attendee" />
                      <input type="hidden" name="attendee_id" value={a.id} />
                      <button class="btn btn-sm btn-danger" type="submit">Quitar</button>
                    </form>
                  )}
                </td>
              </tr>
            ))}
            {!attendees.length && <tr><td colspan="7" class="text-slate-500">Sin asistentes registrados.</td></tr>}
          </tbody>
        </table>
      </section>

      <section class="card">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2>Órdenes de la jornada</h2>
          {canOrder && <a class="btn btn-primary btn-sm" href={orderLink()}>Registrar orden</a>}
        </div>
        {status === 'programada' && <p class="mb-3 text-sm text-slate-500">Las órdenes se registran con la jornada En ejecución o Cerrada.</p>}
        <div class="overflow-x-auto">
          <table class="table">
            <thead><tr><th>Orden</th><th>Comprador</th><th>Modalidad</th><th class="text-right">Valor</th><th>Documental</th></tr></thead>
            <tbody>
              {orderList.map((o) => (
                <tr class:list={[o.is_cancelled && 'opacity-60']}>
                  <td><a href={`/ordenes/${o.id}`}>{orderNumber(o.order_number)}</a></td>
                  <td>{o.buyer_name} <span class="text-xs text-slate-500">{o.buyer_document_id}</span></td>
                  <td class="text-xs">{PAYMENT_MODALITY_LABELS[o.payment_modality!]}{o.installments_count && ` · ${o.installments_count} cuotas`}</td>
                  <td class="text-right whitespace-nowrap">{cop(o.total_amount)}</td>
                  <td>{o.is_cancelled ? <span class="badge badge-red">Anulada</span> : <span class={DOC_STATUS_BADGE[o.doc_status!]}>{DOC_STATUS_LABELS[o.doc_status!]}</span>}</td>
                </tr>
              ))}
              {!orderList.length && <tr><td colspan="5" class="text-slate-500">Sin órdenes registradas.</td></tr>}
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="space-y-4">
      <section class="card space-y-3 text-sm">
        <h2>Estado de la jornada</h2>
        <ul class="space-y-1">
          <li class:list={[j.logistics_confirmed ? 'text-green-700' : 'text-amber-700']}>{j.logistics_confirmed ? '✓' : '○'} Logística confirmada</li>
          <li class:list={[sessionRows.length ? 'text-green-700' : 'text-amber-700']}>{sessionRows.length ? '✓' : '○'} Al menos una sesión</li>
          {j.started_at && <li class="text-slate-600">Iniciada: {fmtDateTime(j.started_at)}</li>}
          {j.closed_at && <li class="text-slate-600">Cerrada: {fmtDateTime(j.closed_at)}</li>}
          {j.cancelled_at && <li class="text-red-700">Cancelada: {j.cancel_reason}</li>}
        </ul>
        {
          canEdit && status === 'programada' && (
            <form method="post"><input type="hidden" name="_action" value="start" /><button class="btn btn-primary w-full" disabled={!j.logistics_confirmed || !sessionRows.length}>Iniciar jornada</button></form>
          )
        }
        {
          canEdit && status === 'en_ejecucion' && (
            <form method="post"><input type="hidden" name="_action" value="close" /><button class="btn btn-primary w-full">Cerrar jornada</button></form>
          )
        }
        {
          canCancel && (
            <details>
              <summary class="cursor-pointer text-red-700">Cancelar jornada</summary>
              <form method="post" class="mt-2 space-y-2">
                <input type="hidden" name="_action" value="cancel" />
                <textarea class="input" name="cancel_reason" rows="2" required placeholder="Motivo" />
                <button class="btn btn-danger w-full">Confirmar cancelación</button>
              </form>
            </details>
          )
        }
      </section>

      {
        canEdit && (
          <section class="card text-sm">
            <h2 class="mb-3">Datos de la jornada</h2>
            <form method="post" class="space-y-2">
              <input type="hidden" name="_action" value="update" />
              <label class="label">Responsable operativo</label>
              <select class="input" name="responsible_user_id">
                {opsUsers.map((u) => <option value={u.id} selected={u.id === j.responsible_user_id}>{u.full_name}</option>)}
              </select>
              <label class="label">Ciudad</label>
              <select class="input" name="city_id">
                {cities.map((c) => <option value={c.id} selected={c.id === j.city_id}>{c.name}</option>)}
              </select>
              <label class="label">Sede</label>
              <select class="input" name="branch_id">
                <option value="">—</option>
                {branches.data?.map((b) => <option value={b.id} selected={b.id === j.branch_id}>{b.name}</option>)}
              </select>
              <label class="flex items-center gap-2"><input type="checkbox" name="logistics_confirmed" checked={!!j.logistics_confirmed} /> Logística confirmada</label>
              <label class="label">Notas</label>
              <textarea class="input" name="notes" rows="3">{j.notes ?? ''}</textarea>
              <button class="btn btn-primary w-full" type="submit">Guardar</button>
            </form>
          </section>
        )
      }

      <section class="card text-sm">
        <h2 class="mb-2">Convenio</h2>
        {
          agreement.data ? (
            <p>
              <a href={`/convenios/${agreement.data.id}`}>{agreement.data.max_installments} cuotas {agreement.data.payroll_frequency}</a>
              <span class="text-slate-500"> · vigente {fmtDate(agreement.data.valid_from)} – {fmtDate(agreement.data.valid_until)}</span>
            </p>
          ) : (
            <p class="text-slate-500">—</p>
          )
        }
      </section>
    </div>
  </div>
</AppLayout>
