---
import AppLayout from '../../layouts/AppLayout.astro';
import { hasRole } from '../../lib/auth';
import { cop, fmtDate, fmtDateTime, fmtTime, fmtWeekday, pct } from '../../lib/format';
import { checkbox, date, ensure, ensureFresh, FormError, formVersion, int, parseForm, runActions, text, time, uuid, VERSION_FIELD, z } from '../../lib/forms';
import {
  ATTENDANCE_STATUS_BADGE,
  ATTENDANCE_STATUS_LABELS,
  CAMPAIGN_STATUS_BADGE,
  CAMPAIGN_STATUS_LABELS,
  DOC_STATUS_BADGE,
  DOC_STATUS_LABELS,
  MARGIN_BASIS_BADGE,
  MARGIN_BASIS_LABELS,
  OPS_STATUS_BADGE,
  OPS_STATUS_LABELS,
  PAYMENT_MODALITY_LABELS,
  type AttendanceStatus,
  type CampaignStatus,
} from '../../lib/labels';
import { orderNumber } from '../../lib/orders';
import type { Database } from '../../lib/database.types';
import { activeUsers, operationalCities } from '../../lib/options';

const { supabase } = Astro.locals;
const id = Astro.params.id!;

const sessionSchema = z.object({
  session_date: date(),
  start_time: time(),
  end_time: time(),
  location_detail: text(200).optional(),
  responsible_user_id: uuid(),
  capacity: int().min(1).optional(),
});

// Checklist fijo para iniciar la jornada (doc de Jornadas §4.1)
const CHECKLIST = [
  ['logistics_confirmed', 'Lugar y logística confirmados'],
  ['checklist_staff', 'Personal asignado (optometría y asesores)'],
  ['checklist_equipment', 'Equipos de examen revisados'],
  ['checklist_materials', 'Muestrario de monturas y material listos'],
  ['checklist_notice', 'La empresa avisó a los empleados'],
] as const;
type ChecklistKey = (typeof CHECKLIST)[number][0];

// Personas que ocupan cupo en una sesión
const OCCUPYING: AttendanceStatus[] = ['agendado', 'presente', 'atendido'];

/** Actualiza la jornada solo si nadie la cambió desde que se cargó el formulario. */
async function updateCampaignVersioned(patch: Database['public']['Tables']['campaigns_jornadas']['Update'], form: FormData) {
  const version = formVersion(form);
  await ensureFresh(
    await supabase.from('campaigns_jornadas').update(patch).eq('id', id).eq('updated_at', version).select('id').single(),
    () => supabase.from('campaigns_jornadas').select('updated_at').eq('id', id).maybeSingle(),
    version,
  );
}

/** Aviso si la sesión quedó por encima de su capacidad (no bloquea). */
async function capacityWarning(sessionId: string): Promise<string> {
  const [{ data: session }, { count }] = await Promise.all([
    supabase.from('campaign_sessions').select('capacity').eq('id', sessionId).maybeSingle(),
    supabase.from('campaign_attendance').select('id', { count: 'exact', head: true }).eq('session_id', sessionId).in('status', OCCUPYING),
  ]);
  return session?.capacity && (count ?? 0) > session.capacity
    ? ` Atención: la sesión supera su capacidad (${count} de ${session.capacity}).`
    : '';
}

const ATTENDANCE_STATUSES = Object.keys(ATTENDANCE_STATUS_LABELS) as [AttendanceStatus, ...AttendanceStatus[]];

async function setStatus(status: CampaignStatus, extra: Record<string, unknown> = {}) {
  ensure(await supabase.from('campaigns_jornadas').update({ status, ...extra }).eq('id', id).select('id').single());
}

const outcome = await runActions(Astro, {
  update: async (form) => {
    const input = parseForm(
      z.object({
        responsible_user_id: uuid(),
        city_id: uuid(),
        branch_id: uuid().optional(),
        notes: text(2000).optional(),
      }),
      form,
    );
    await updateCampaignVersioned({ ...input, branch_id: input.branch_id ?? null, notes: input.notes ?? null }, form);
    return { message: 'Jornada actualizada.' };
  },
  update_checklist: async (form) => {
    const patch = Object.fromEntries(CHECKLIST.map(([key]) => [key, checkbox().parse(form.get(key) ?? undefined)])) as Record<ChecklistKey, boolean>;
    await updateCampaignVersioned(patch, form);
    return { message: 'Checklist actualizado.' };
  },
  update_session: async (form) => {
    const input = parseForm(z.object({ session_id: uuid(), responsible_user_id: uuid(), capacity: int().min(1).optional() }), form);
    const version = formVersion(form);
    await ensureFresh(
      await supabase
        .from('campaign_sessions')
        .update({ responsible_user_id: input.responsible_user_id, capacity: input.capacity ?? null })
        .eq('id', input.session_id)
        .eq('campaign_id', id)
        .eq('updated_at', version)
        .select('id')
        .single(),
      () => supabase.from('campaign_sessions').select('updated_at').eq('id', input.session_id).maybeSingle(),
      version,
    );
    return { message: `Sesión actualizada.${await capacityWarning(input.session_id)}` };
  },
  reschedule_session: async (form) => {
    const input = parseForm(
      z.object({
        session_id: uuid(),
        session_date: date(),
        start_time: time(),
        end_time: time(),
        location_detail: text(200).optional(),
        reason: text(1000).optional(),
      }),
      form,
    );
    if (!input.reason?.trim()) throw new FormError('Indique el motivo de la reprogramación.');
    ensure(
      await supabase.rpc('reschedule_campaign_session', {
        p_session_id: input.session_id,
        p_session_date: input.session_date,
        p_start_time: input.start_time,
        p_end_time: input.end_time,
        p_location_detail: input.location_detail ?? '',
        p_reason: input.reason,
        p_expected_updated_at: formVersion(form),
      }),
    );
    return { message: 'Sesión reprogramada. La fecha anterior y el motivo quedan en el historial.' };
  },
  add_session: async (form) => {
    const input = parseForm(sessionSchema, form);
    ensure(
      await supabase
        .from('campaign_sessions')
        .insert({ ...input, location_detail: input.location_detail ?? null, capacity: input.capacity ?? null, campaign_id: id }),
    );
    return { message: 'Sesión agregada.' };
  },
  delete_session: async (form) => {
    const sessionId = String(form.get('session_id') ?? '');
    ensure(await supabase.from('campaign_sessions').delete().eq('id', sessionId).eq('campaign_id', id).select('id').single());
    return { message: 'Sesión eliminada.' };
  },
  schedule: async () => {
    await setStatus('programada');
    return { message: 'Jornada programada.' };
  },
  start: async () => {
    await setStatus('en_ejecucion');
    return { message: 'Jornada iniciada. Ya puede marcar la asistencia y registrar órdenes.' };
  },
  close_capture: async () => {
    await setStatus('captura_cerrada');
    return { message: 'Captura cerrada: asistencia y órdenes quedan congeladas.' };
  },
  reopen: async (form) => {
    const reason = String(form.get('reopen_reason') ?? '').trim();
    if (!reason) throw new FormError('Indique el motivo para reabrir la captura.');
    await setStatus('en_ejecucion', { reopen_reason: reason });
    return { message: 'Captura reabierta.' };
  },
  close_operation: async () => {
    await setStatus('operacion_cerrada');
    return { message: 'Operación de la jornada cerrada.' };
  },
  cancel: async (form) => {
    const reason = String(form.get('cancel_reason') ?? '').trim();
    if (!reason) throw new FormError('Indique el motivo de la cancelación.');
    await setStatus('cancelada', { cancel_reason: reason });
    return { message: 'Jornada cancelada.' };
  },
  add_attendee: async (form) => {
    const input = parseForm(
      z.object({
        session_id: uuid(),
        full_name: text(150),
        document_id: z.string().regex(/^[0-9A-Za-z]{4,15}$/, { error: 'entre 4 y 15 letras o números, sin puntos' }),
        area: text(100).optional(),
        status: z.enum(ATTENDANCE_STATUSES),
      }),
      form,
    );
    ensure(await supabase.from('campaign_attendance').insert({ ...input, area: input.area ?? null, campaign_id: id }));
    return { message: `${input.full_name}: ${ATTENDANCE_STATUS_LABELS[input.status].toLowerCase()}.${await capacityWarning(input.session_id)}` };
  },
  set_attendance: async (form) => {
    const input = parseForm(z.object({ attendee_id: uuid(), status: z.enum(ATTENDANCE_STATUSES) }), form);
    ensure(
      await supabase
        .from('campaign_attendance')
        .update({ status: input.status })
        .eq('id', input.attendee_id)
        .eq('campaign_id', id)
        .select('id')
        .single(),
    );
    const { data: row } = await supabase.from('campaign_attendance').select('session_id').eq('id', input.attendee_id).maybeSingle();
    const warning = row && OCCUPYING.includes(input.status) ? await capacityWarning(row.session_id) : '';
    return { message: `Asistencia: ${ATTENDANCE_STATUS_LABELS[input.status].toLowerCase()}.${warning}` };
  },
  delete_attendee: async (form) => {
    const attendeeId = String(form.get('attendee_id') ?? '');
    ensure(await supabase.from('campaign_attendance').delete().eq('id', attendeeId).eq('campaign_id', id).select('id').single());
    return { message: 'Registro de asistencia eliminado.' };
  },
});
if (outcome?.kind === 'redirect') return outcome.response;
const error = outcome?.kind === 'error' ? outcome.error : null;
const v = outcome?.kind === 'error' ? outcome.values : {};
const lastAction = outcome?.kind === 'error' ? outcome.action : '';

const { data: j } = await supabase.from('v_campaigns').select('*').eq('id', id).maybeSingle();
if (!j) return new Response('Jornada no encontrada', { status: 404 });

const [sessions, attendance, agreement, branches, opsUsers, sessionUsers, cities, orders, campaignRow, sessionMeta, reschedules] = await Promise.all([
  supabase.from('v_campaign_calendar').select('*').eq('campaign_id', id).order('session_date').order('start_time'),
  supabase.from('campaign_attendance').select('*').eq('campaign_id', id).order('created_at', { ascending: false }),
  supabase.from('v_agreements').select('id, max_installments, payroll_frequency, valid_from, valid_until, effective_status').eq('id', j.agreement_id!).maybeSingle(),
  supabase.from('company_branches').select('id, name').eq('company_id', j.company_id!).order('name'),
  activeUsers(supabase, ['operacion']),
  activeUsers(supabase, ['operacion', 'comercial']),
  operationalCities(supabase),
  supabase
    .from('v_orders')
    .select('id, order_number, buyer_name, buyer_document_id, payment_modality, installments_count, total_amount, doc_status, ops_status, is_cancelled')
    .eq('campaign_id', id)
    .order('order_number'),
  supabase
    .from('campaigns_jornadas')
    .select('updated_at, logistics_confirmed, checklist_staff, checklist_equipment, checklist_materials, checklist_notice, checklist_complete')
    .eq('id', id)
    .single(),
  supabase.from('campaign_sessions').select('id, capacity, updated_at, responsible_user_id').eq('campaign_id', id),
  supabase
    .from('campaign_session_reschedules')
    .select('id, session_id, previous_date, previous_start_time, previous_end_time, previous_location, new_date, new_start_time, new_end_time, new_location, reason, rescheduled_at, users_profiles(full_name)')
    .eq('campaign_id', id)
    .order('rescheduled_at', { ascending: false }),
]);
// Las sesiones de una jornada cancelada no salen en el calendario: se consultan directo
const sessionRows = j.status === 'cancelada'
  ? (await supabase.from('campaign_sessions').select('id, session_date, start_time, end_time, location_detail').eq('campaign_id', id).order('session_date')).data?.map((s) => ({ ...s, session_id: s.id, responsible_user_name: '', has_conflict: false })) ?? []
  : sessions.data ?? [];

const status = j.status!;
const campaign = campaignRow.data!;
const checklistDone = CHECKLIST.filter(([key]) => campaign[key]).length;
const metaBySession = new Map((sessionMeta.data ?? []).map((m) => [m.id, m]));
const rescheduleList = reschedules.data ?? [];
const isOps = hasRole(Astro.locals, 'operacion');
const isTeam = hasRole(Astro.locals, 'operacion', 'comercial');
const beforeExecution = status === 'borrador' || status === 'programada';
const canEdit = isTeam && (beforeExecution || status === 'en_ejecucion');
const canCancel = hasRole(Astro.locals, 'operacion', 'direccion') && beforeExecution;
const canAttend = isTeam && (beforeExecution || status === 'en_ejecucion');
// Reprogramar: Operación o Dirección, antes de ejecutar (con motivo e historial)
const canReschedule = hasRole(Astro.locals, 'operacion', 'direccion') && beforeExecution;
// Antes de ejecutar solo se agenda o cancela; en ejecución, cualquier estado
const attendanceOptions: AttendanceStatus[] = beforeExecution ? ['agendado', 'cancelado'] : ATTENDANCE_STATUSES;
const attendees = attendance.data ?? [];
const occupancy = (sid: string) => attendees.filter((a) => a.session_id === sid && OCCUPYING.includes(a.status)).length;
const orderList = orders.data ?? [];
const activeOrders = orderList.filter((o) => !o.is_cancelled);

// Cierre operativo: todo entregado y sin posventa abierta
const undelivered = activeOrders.filter((o) => o.ops_status !== 'entrega_completa').length;
const openWarranties = orderList.length
  ? ((await supabase
      .from('post_sale_warranties')
      .select('id', { count: 'exact', head: true })
      .in('order_id', orderList.map((o) => o.id!))
      .neq('status', 'cerrada')).count ?? 0)
  : 0;

// Costos y márgenes: solo Dirección y Socio (la BD no los entrega a otros roles)
const canViewCosts = hasRole(Astro.locals, 'direccion', 'socio');
const [campaignMargin, orderMargins] = canViewCosts
  ? await Promise.all([
      supabase.from('v_campaign_margins').select('*').eq('campaign_id', id).maybeSingle(),
      supabase.from('v_order_margins').select('order_id, cost_total, cost_basis, margin_amount').eq('campaign_id', id),
    ])
  : [{ data: null }, { data: [] }];
const marginByOrder = new Map((orderMargins.data ?? []).map((m) => [m.order_id, m]));
// RF-M03-04: valor real vendido = órdenes no anuladas; conversión = compradores ÷ asistentes
const realSold = activeOrders.reduce((sum, o) => sum + (o.total_amount ?? 0), 0);
const buyersCount = new Set(activeOrders.map((o) => o.buyer_document_id)).size;
const canOrder = hasRole(Astro.locals, 'comercial') && status === 'en_ejecucion';
const orderLink = (a?: { document_id: string; full_name: string }) =>
  `/ordenes/nueva?campaign_id=${id}${a ? `&document_type=cc&document_id=${encodeURIComponent(a.document_id)}&full_name=${encodeURIComponent(a.full_name)}` : ''}`;
const sessionLabel = (sid: string) => {
  const s = sessionRows.find((x) => x.session_id === sid);
  return s ? `${fmtDate(s.session_date)} ${fmtTime(s.start_time)}` : '';
};
---

<AppLayout title={`Jornada · ${j.company_name}`} error={error}>
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div>
      <a href="/jornadas" class="text-sm">← Jornadas</a>
      <h1>Jornada · {j.company_name}</h1>
      <p class="text-sm text-slate-600">
        <a href={`/oportunidades/${j.deal_id}`}>{j.deal_name_branch}</a> · {j.city_name}{j.branch_name && ` · ${j.branch_name}`} · Responsable: {j.responsible_user_name}
      </p>
    </div>
    <div class="text-right">
      <span class={`${CAMPAIGN_STATUS_BADGE[status]} text-sm`}>{CAMPAIGN_STATUS_LABELS[status]}</span>
      <div class="mt-2 text-sm text-slate-600">
        Atendidos: <strong>{j.attended_headcount}</strong>{j.target_employees_n ? ` de ${j.target_employees_n} proyectados` : ''}
        {Number(j.scheduled_count) > 0 && <span class="text-slate-500"> · {j.scheduled_count} agendados</span>}
        {Number(j.no_show_count) > 0 && <span class="text-slate-500"> · {j.no_show_count} no asistieron</span>}
      </div>
      <div class="text-xs text-slate-500">Facturación estimada de la oportunidad: {cop(j.estimated_billing_amount)}</div>
      <div class="text-sm text-slate-600">
        Valor real vendido: <strong>{cop(realSold)}</strong> · {buyersCount} compradores
        {j.attended_headcount ? ` (${Math.round((buyersCount / Number(j.attended_headcount)) * 100)}% de conversión)` : ''}
      </div>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <section class="card">
        <h2 class="mb-3">Sesiones</h2>
        <table class="table">
          <thead><tr><th>Fecha</th><th>Horario</th><th>Lugar</th><th>Responsable</th><th class="text-right">Cupo</th><th></th></tr></thead>
          <tbody>
            {sessionRows.map((s) => {
              const meta = metaBySession.get(s.session_id!);
              const used = occupancy(s.session_id!);
              const over = !!meta?.capacity && used > meta.capacity;
              const rescheduled = rescheduleList.some((r) => r.session_id === s.session_id);
              return (
                <tr class:list={[s.has_conflict && 'bg-red-50']}>
                  <td class="capitalize">
                    {s.session_date && fmtWeekday(s.session_date)}
                    {rescheduled && <span class="badge badge-amber ml-1">Reprogramada</span>}
                  </td>
                  <td>{fmtTime(s.start_time)}–{fmtTime(s.end_time)} {s.has_conflict && <span class="badge badge-red">Cruce</span>}</td>
                  <td>{s.location_detail ?? '—'}</td>
                  <td>{s.responsible_user_name}</td>
                  <td class="text-right whitespace-nowrap">
                    {meta?.capacity ? (
                      <span class:list={[over && 'badge badge-red']} title="Agendados, presentes y atendidos sobre la capacidad">{used} / {meta.capacity}</span>
                    ) : (
                      <span class="text-slate-500">{used} · sin límite</span>
                    )}
                  </td>
                  <td>
                    <div class="flex flex-wrap justify-end gap-1">
                      {isTeam && canEdit && meta && (
                        <details class="text-left" open={lastAction === 'update_session' && v.session_id === s.session_id}>
                          <summary class="btn btn-sm">Editar</summary>
                          <form method="post" class="mt-2 w-56 space-y-2">
                            <input type="hidden" name="_action" value="update_session" />
                            <input type="hidden" name="session_id" value={s.session_id} />
                            <input type="hidden" name={VERSION_FIELD} value={meta.updated_at} />
                            <label class="label">Responsable</label>
                            <select class="input" name="responsible_user_id">
                              {sessionUsers.map((u) => <option value={u.id} selected={u.id === meta.responsible_user_id}>{u.full_name}</option>)}
                            </select>
                            <label class="label">Capacidad (personas)</label>
                            <input class="input" name="capacity" type="number" min="1" step="1" value={meta.capacity ?? ''} placeholder="Sin límite" />
                            <button class="btn btn-primary btn-sm w-full" type="submit">Guardar</button>
                          </form>
                        </details>
                      )}
                      {canReschedule && meta && (
                        <details class="text-left" open={lastAction === 'reschedule_session' && v.session_id === s.session_id}>
                          <summary class="btn btn-sm">Reprogramar</summary>
                          <form method="post" class="mt-2 w-64 space-y-2">
                            <input type="hidden" name="_action" value="reschedule_session" />
                            <input type="hidden" name="session_id" value={s.session_id} />
                            <input type="hidden" name={VERSION_FIELD} value={meta.updated_at} />
                            <label class="label">Nueva fecha</label>
                            <input class="input" name="session_date" type="date" required value={s.session_date} min={agreement.data?.valid_from ?? undefined} max={agreement.data?.valid_until ?? undefined} />
                            <div class="grid grid-cols-2 gap-2">
                              <div><label class="label">Inicio</label><input class="input" name="start_time" type="time" required value={s.start_time?.slice(0, 5)} /></div>
                              <div><label class="label">Fin</label><input class="input" name="end_time" type="time" required value={s.end_time?.slice(0, 5)} /></div>
                            </div>
                            <label class="label">Lugar</label>
                            <input class="input" name="location_detail" value={s.location_detail ?? ''} />
                            <label class="label">Motivo</label>
                            <textarea class="input" name="reason" rows="2" required maxlength="1000" placeholder="Por qué cambia la sesión" />
                            <button class="btn btn-primary btn-sm w-full" type="submit">Reprogramar</button>
                          </form>
                        </details>
                      )}
                      {isOps && canEdit && !rescheduled && (
                        <form method="post">
                          <input type="hidden" name="_action" value="delete_session" />
                          <input type="hidden" name="session_id" value={s.session_id} />
                          <button class="btn btn-sm btn-danger" type="submit">Eliminar</button>
                        </form>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
            {!sessionRows.length && <tr><td colspan="6" class="text-slate-500">Sin sesiones. Agregue al menos una para poder iniciar la jornada.</td></tr>}
          </tbody>
        </table>
        {
          rescheduleList.length > 0 && (
            <details class="mt-3 text-sm" open={lastAction === 'reschedule_session'}>
              <summary class="cursor-pointer text-slate-700">Historial de reprogramaciones ({rescheduleList.length})</summary>
              <ul class="mt-2 divide-y divide-slate-100">
                {rescheduleList.map((r) => (
                  <li class="py-2">
                    <div>
                      <span class="text-slate-500 line-through">{fmtDate(r.previous_date)} {fmtTime(r.previous_start_time)}–{fmtTime(r.previous_end_time)}{r.previous_location && ` · ${r.previous_location}`}</span>
                      {' → '}
                      <strong>{fmtDate(r.new_date)} {fmtTime(r.new_start_time)}–{fmtTime(r.new_end_time)}</strong>{r.new_location && ` · ${r.new_location}`}
                    </div>
                    <div class="text-xs text-slate-500">{r.reason} · {r.users_profiles?.full_name ?? '—'} · {fmtDateTime(r.rescheduled_at)}</div>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
        {
          isOps && canEdit && (
            <form method="post" class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-7 sm:items-end">
              <input type="hidden" name="_action" value="add_session" />
              <div class="col-span-2 sm:col-span-1">
                <label class="label">Fecha</label>
                <input class="input" name="session_date" type="date" required min={agreement.data?.valid_from ?? undefined} max={agreement.data?.valid_until ?? undefined} value={lastAction === 'add_session' ? v.session_date : ''} />
              </div>
              <div><label class="label">Inicio</label><input class="input" name="start_time" type="time" required value={lastAction === 'add_session' ? v.start_time : ''} /></div>
              <div><label class="label">Fin</label><input class="input" name="end_time" type="time" required value={lastAction === 'add_session' ? v.end_time : ''} /></div>
              <div class="col-span-2 sm:col-span-1"><label class="label">Lugar</label><input class="input" name="location_detail" value={lastAction === 'add_session' ? v.location_detail : ''} /></div>
              <div><label class="label">Capacidad</label><input class="input" name="capacity" type="number" min="1" step="1" placeholder="Opcional" value={lastAction === 'add_session' ? v.capacity : ''} /></div>
              <div class="col-span-2 sm:col-span-1">
                <label class="label">Responsable</label>
                <select class="input" name="responsible_user_id">
                  {sessionUsers.map((u) => <option value={u.id} selected={u.id === j.responsible_user_id}>{u.full_name}</option>)}
                </select>
              </div>
              <button class="btn btn-primary col-span-2 sm:col-span-1" type="submit">Agregar sesión</button>
            </form>
          )
        }
      </section>

      <section class="card">
        <div class="mb-1 flex items-center justify-between">
          <h2>Asistencia</h2>
          <span class="text-sm text-slate-500">{attendees.length} registros</span>
        </div>
        <p class="mb-3 text-xs text-slate-500">Solo datos operativos: no se registran diagnósticos ni historia clínica.</p>
        {
          canAttend && sessionRows.length > 0 && (
            <form method="post" class="mb-4 grid grid-cols-1 gap-2 sm:grid-cols-5 sm:items-end">
              <input type="hidden" name="_action" value="add_attendee" />
              <div>
                <label class="label">Sesión</label>
                <select class="input" name="session_id">
                  {sessionRows.map((s) => <option value={s.session_id} selected={v.session_id === s.session_id}>{fmtDate(s.session_date)} {fmtTime(s.start_time)}</option>)}
                </select>
              </div>
              <div><label class="label">Nombre completo</label><input class="input" name="full_name" required autofocus={lastAction === 'add_attendee'} /></div>
              <div><label class="label">Documento</label><input class="input" name="document_id" required inputmode="numeric" /></div>
              <div><label class="label">Área</label><input class="input" name="area" value={lastAction === 'add_attendee' ? v.area : ''} /></div>
              <div>
                <label class="label">Estado</label>
                <select class="input" name="status">
                  {attendanceOptions.map((st) => (
                    <option value={st} selected={(lastAction === 'add_attendee' && v.status ? v.status : beforeExecution ? 'agendado' : 'atendido') === st}>
                      {ATTENDANCE_STATUS_LABELS[st]}
                    </option>
                  ))}
                </select>
              </div>
              <button class="btn btn-primary sm:col-span-5 sm:justify-self-end" type="submit">Registrar</button>
            </form>
          )
        }
        {beforeExecution && <p class="mb-3 text-sm text-slate-500">Antes de iniciar la jornada solo se agenda o cancela la asistencia; se marca atendido con la jornada En ejecución.</p>}
        <table class="table">
          <thead><tr><th>Nombre</th><th>Documento</th><th>Área</th><th>Sesión</th><th>Estado</th><th>Compra</th><th></th></tr></thead>
          <tbody>
            {attendees.map((a) => (
              <tr>
                <td>{a.full_name}</td>
                <td>{a.document_id}</td>
                <td>{a.area ?? '—'}</td>
                <td class="text-xs">{sessionLabel(a.session_id)}</td>
                <td class="whitespace-nowrap">
                  {canAttend ? (
                    <form method="post" class="flex items-center gap-1">
                      <input type="hidden" name="_action" value="set_attendance" />
                      <input type="hidden" name="attendee_id" value={a.id} />
                      <select class="input py-1 text-xs" name="status" aria-label={`Estado de ${a.full_name}`}>
                        {(attendanceOptions.includes(a.status) ? attendanceOptions : [a.status, ...attendanceOptions]).map((st) => (
                          <option value={st} selected={st === a.status}>{ATTENDANCE_STATUS_LABELS[st]}</option>
                        ))}
                      </select>
                      <button class="btn btn-sm" type="submit">OK</button>
                    </form>
                  ) : (
                    <span class={ATTENDANCE_STATUS_BADGE[a.status]}>{ATTENDANCE_STATUS_LABELS[a.status]}</span>
                  )}
                  {a.attended_at && <div class="text-xs text-slate-500">{fmtDateTime(a.attended_at)}</div>}
                </td>
                <td class="whitespace-nowrap">
                  {a.buyer_id ? (
                    <span class="badge badge-green">Compró</span>
                  ) : (
                    canOrder && <a class="btn btn-sm" href={orderLink(a)}>Registrar orden</a>
                  )}
                </td>
                <td>
                  {canAttend && (
                    <form method="post">
                      <input type="hidden" name="_action" value="delete_attendee" />
                      <input type="hidden" name="attendee_id" value={a.id} />
                      <button class="btn btn-sm btn-danger" type="submit">Quitar</button>
                    </form>
                  )}
                </td>
              </tr>
            ))}
            {!attendees.length && <tr><td colspan="7" class="text-slate-500">Sin asistentes registrados.</td></tr>}
          </tbody>
        </table>
      </section>

      <section class="card">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2>Órdenes de la jornada</h2>
          {canOrder && <a class="btn btn-primary btn-sm" href={orderLink()}>Registrar orden</a>}
        </div>
        {beforeExecution && <p class="mb-3 text-sm text-slate-500">Las órdenes se registran con la jornada En ejecución.</p>}
        {status === 'captura_cerrada' && <p class="mb-3 text-sm text-slate-500">Captura cerrada: para una venta tardía, Operación reabre la captura indicando el motivo.</p>}
        <div class="overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th>Orden</th><th>Comprador</th><th>Modalidad</th><th class="text-right">Valor</th><th>Documental</th><th>Operativo</th>
                {canViewCosts && <th class="text-right">Costo</th>}
                {canViewCosts && <th class="text-right">Diferencia</th>}
              </tr>
            </thead>
            <tbody>
              {orderList.map((o) => (
                <tr class:list={[o.is_cancelled && 'opacity-60']}>
                  <td><a href={`/ordenes/${o.id}`}>{orderNumber(o.order_number)}</a></td>
                  <td>{o.buyer_name} <span class="text-xs text-slate-500">{o.buyer_document_id}</span></td>
                  <td class="text-xs">{PAYMENT_MODALITY_LABELS[o.payment_modality!]}{o.installments_count && ` · ${o.installments_count} cuotas`}</td>
                  <td class="text-right whitespace-nowrap">{cop(o.total_amount)}</td>
                  <td>{o.is_cancelled ? <span class="badge badge-red">Anulada</span> : <span class={DOC_STATUS_BADGE[o.doc_status!]}>{DOC_STATUS_LABELS[o.doc_status!]}</span>}</td>
                  <td>{!o.is_cancelled && <span class={OPS_STATUS_BADGE[o.ops_status!]}>{OPS_STATUS_LABELS[o.ops_status!]}</span>}</td>
                  {canViewCosts && (
                    <td class="text-right whitespace-nowrap">
                      {cop(marginByOrder.get(o.id!)?.cost_total)}
                      {marginByOrder.get(o.id!)?.cost_basis === 'estimado' && <span class="badge badge-amber ml-1">Est.</span>}
                    </td>
                  )}
                  {canViewCosts && <td class="text-right whitespace-nowrap">{cop(marginByOrder.get(o.id!)?.margin_amount)}</td>}
                </tr>
              ))}
              {!orderList.length && <tr><td colspan={canViewCosts ? 8 : 6} class="text-slate-500">Sin órdenes registradas.</td></tr>}
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="space-y-4">
      <section class="card space-y-3 text-sm">
        <h2>Estado de la jornada</h2>
        <ul class="space-y-1">
          <li class:list={[sessionRows.length ? 'text-green-700' : 'text-amber-700']}>{sessionRows.length ? '✓' : '○'} Al menos una sesión</li>
          <li class:list={[campaign.checklist_complete ? 'text-green-700' : 'text-amber-700']}>{campaign.checklist_complete ? '✓' : '○'} Checklist completo ({checklistDone} de {CHECKLIST.length})</li>
          {
            (status === 'captura_cerrada' || status === 'operacion_cerrada') && (
              <>
                <li class:list={[undelivered ? 'text-amber-700' : 'text-green-700']}>{undelivered ? `○ ${undelivered} orden(es) sin entrega completa` : '✓ Todas las órdenes entregadas'}</li>
                <li class:list={[openWarranties ? 'text-amber-700' : 'text-green-700']}>{openWarranties ? `○ ${openWarranties} caso(s) de posventa abiertos` : '✓ Sin posventa abierta'}</li>
              </>
            )
          }
          {j.scheduled_at && <li class="text-slate-600">Programada: {fmtDateTime(j.scheduled_at)}</li>}
          {j.started_at && <li class="text-slate-600">Iniciada: {fmtDateTime(j.started_at)}</li>}
          {j.capture_reopened_at && <li class="text-slate-600">Captura reabierta: {fmtDateTime(j.capture_reopened_at)} · {j.reopen_reason}</li>}
          {j.capture_closed_at && <li class="text-slate-600">Captura cerrada: {fmtDateTime(j.capture_closed_at)}</li>}
          {j.closed_at && <li class="text-slate-600">Operación cerrada: {fmtDateTime(j.closed_at)}</li>}
          {j.cancelled_at && <li class="text-red-700">Cancelada: {j.cancel_reason}</li>}
        </ul>
        {
          isTeam && status === 'borrador' && (
            <form method="post"><input type="hidden" name="_action" value="schedule" /><button class="btn btn-primary w-full" disabled={!sessionRows.length}>Programar jornada</button></form>
          )
        }
        {
          isTeam && status === 'programada' && (
            <form method="post"><input type="hidden" name="_action" value="start" /><button class="btn btn-primary w-full" disabled={!campaign.checklist_complete || !sessionRows.length}>Iniciar jornada</button></form>
          )
        }
        {
          isTeam && status === 'en_ejecucion' && (
            <form method="post">
              <input type="hidden" name="_action" value="close_capture" />
              <button class="btn btn-primary w-full">Cerrar captura</button>
              <p class="mt-1 text-xs text-slate-500">Congela asistencia y órdenes. Producción, entregas, factura y cobro siguen su curso.</p>
            </form>
          )
        }
        {
          isTeam && status === 'captura_cerrada' && (
            <>
              <form method="post"><input type="hidden" name="_action" value="close_operation" /><button class="btn btn-primary w-full" disabled={undelivered > 0 || openWarranties > 0}>Cerrar operación</button></form>
              <details open={lastAction === 'reopen'}>
                <summary class="cursor-pointer text-slate-700">Reabrir captura</summary>
                <form method="post" class="mt-2 space-y-2">
                  <input type="hidden" name="_action" value="reopen" />
                  <textarea class="input" name="reopen_reason" rows="2" required maxlength="1000" placeholder="Motivo (p. ej., venta tardía)" />
                  <button class="btn w-full">Reabrir</button>
                </form>
              </details>
            </>
          )
        }
        {
          canCancel && (
            <details>
              <summary class="cursor-pointer text-red-700">Cancelar jornada</summary>
              <form method="post" class="mt-2 space-y-2">
                <input type="hidden" name="_action" value="cancel" />
                <textarea class="input" name="cancel_reason" rows="2" required placeholder="Motivo" />
                <button class="btn btn-danger w-full">Confirmar cancelación</button>
              </form>
            </details>
          )
        }
      </section>

      <section class="card text-sm">
        <div class="mb-2 flex items-center justify-between">
          <h2>Checklist de preparación</h2>
          <span class:list={['badge', campaign.checklist_complete ? 'badge-green' : 'badge-amber']}>{checklistDone} / {CHECKLIST.length}</span>
        </div>
        <p class="mb-3 text-xs text-slate-500">Todo debe estar marcado para iniciar la jornada.</p>
        {
          isTeam && beforeExecution ? (
            <form method="post" class="space-y-2">
              <input type="hidden" name="_action" value="update_checklist" />
              <input type="hidden" name={VERSION_FIELD} value={campaign.updated_at} />
              {CHECKLIST.map(([key, label]) => (
                <label class="flex items-center gap-2"><input type="checkbox" name={key} checked={!!campaign[key]} /> {label}</label>
              ))}
              <button class="btn btn-primary w-full" type="submit">Guardar checklist</button>
            </form>
          ) : (
            <ul class="space-y-1">
              {CHECKLIST.map(([key, label]) => (
                <li class:list={[campaign[key] ? 'text-green-700' : 'text-amber-700']}>{campaign[key] ? '✓' : '○'} {label}</li>
              ))}
            </ul>
          )
        }
      </section>

      {
        canEdit && (
          <section class="card text-sm">
            <h2 class="mb-3">Datos de la jornada</h2>
            <form method="post" class="space-y-2">
              <input type="hidden" name="_action" value="update" />
              <input type="hidden" name={VERSION_FIELD} value={campaign.updated_at} />
              <label class="label">Responsable operativo</label>
              <select class="input" name="responsible_user_id">
                {opsUsers.map((u) => <option value={u.id} selected={u.id === j.responsible_user_id}>{u.full_name}</option>)}
              </select>
              <label class="label">Ciudad</label>
              <select class="input" name="city_id">
                {cities.map((c) => <option value={c.id} selected={c.id === j.city_id}>{c.name}</option>)}
              </select>
              <label class="label">Sede</label>
              <select class="input" name="branch_id">
                <option value="">—</option>
                {branches.data?.map((b) => <option value={b.id} selected={b.id === j.branch_id}>{b.name}</option>)}
              </select>
              <label class="label">Notas</label>
              <textarea class="input" name="notes" rows="3">{j.notes ?? ''}</textarea>
              <button class="btn btn-primary w-full" type="submit">Guardar</button>
            </form>
          </section>
        )
      }

      {
        canViewCosts && (
          <section class="card text-sm">
            <h2 class="mb-1">Costos y diferencia</h2>
            <p class="mb-3 text-xs text-slate-500">Solo Dirección y Socio. Diferencia = venta − costo directo; no es utilidad neta.</p>
            {
              campaignMargin.data ? (
                <dl class="space-y-1">
                  <div class="flex justify-between"><dt>Venta (sin anuladas)</dt><dd>{cop(campaignMargin.data.sold_amount)}</dd></div>
                  <div class="flex justify-between"><dt>Costo directo</dt><dd>{cop(campaignMargin.data.cost_total)}</dd></div>
                  <div class="flex justify-between font-semibold"><dt>Diferencia</dt><dd>{cop(campaignMargin.data.margin_amount)} <span class="font-normal text-slate-500">({pct(campaignMargin.data.margin_ratio)})</span></dd></div>
                </dl>
              ) : (
                <p class="text-slate-500">—</p>
              )
            }
            {
              campaignMargin.data && Number(campaignMargin.data.orders_without_costs) > 0 && (
                <p class="mt-2"><span class={MARGIN_BASIS_BADGE.sin_costos}>{campaignMargin.data.orders_without_costs} orden(es) sin costos</span> <span class="text-xs text-slate-500">la diferencia está incompleta</span></p>
              )
            }
            {campaignMargin.data?.has_estimated && <p class="mt-2"><span class={MARGIN_BASIS_BADGE.estimado}>{MARGIN_BASIS_LABELS.estimado}</span> <span class="text-xs text-slate-500">incluye costos sin verificar</span></p>}
          </section>
        )
      }

      <section class="card text-sm">
        <h2 class="mb-2">Convenio</h2>
        {
          agreement.data ? (
            <p>
              <a href={`/convenios/${agreement.data.id}`}>{agreement.data.max_installments} cuotas {agreement.data.payroll_frequency}</a>
              <span class="text-slate-500"> · vigente {fmtDate(agreement.data.valid_from)} – {fmtDate(agreement.data.valid_until)}</span>
            </p>
          ) : (
            <p class="text-slate-500">—</p>
          )
        }
      </section>
    </div>
  </div>
</AppLayout>
