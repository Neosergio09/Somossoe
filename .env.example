PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: se usa para que Dirección cree usuarios
SUPABASE_SECRET_KEY=

# Integración con Alegra (opcional). Sin estas variables la consulta a Alegra queda desactivada
# y las facturas se registran a mano. Usuario = correo de la cuenta; token = token de la API.
